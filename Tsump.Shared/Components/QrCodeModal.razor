@using Tsump.Scoring
@inject LanguageService Lang

@if (IsOpen && !string.IsNullOrEmpty(Url))
{
    <div class="qr-backdrop" @onclick="OnCloseHandler">
        <div class="qr-popup" @onclick:stopPropagation="true">
            <div class="qr-header">
                <h6 class="mb-0 flex-grow-1">@(Title ?? Lang.Get("QrCodeTitle"))</h6>
                <button class="btn btn-sm btn-outline-secondary" @onclick="OnCloseHandler" aria-label="@Lang.Get("Close")">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="qr-body">
                @if (svgMarkup != null)
                {
                    @((MarkupString)svgMarkup)
                }
            </div>
            @if (!string.IsNullOrEmpty(Subtitle))
            {
                <div class="qr-footer">
                    <small class="text-muted">@Subtitle</small>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string? Url { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public QrCodeRenderer.CenterOverlay? Overlay { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string? svgMarkup;
    private string? renderedFor;
    private QrCodeRenderer.CenterOverlay? renderedOverlay;

    protected override void OnParametersSet()
    {
        // Re-render the SVG only when the URL or overlay changes — building a QR is cheap
        // but not free (a few ms for our payload sizes).
        if (IsOpen && !string.IsNullOrEmpty(Url) && (Url != renderedFor || !ReferenceEquals(Overlay, renderedOverlay)))
        {
            svgMarkup = QrCodeRenderer.ToSvg(Url, overlay: Overlay);
            renderedFor = Url;
            renderedOverlay = Overlay;
        }
        else if (!IsOpen)
        {
            renderedFor = null;
            renderedOverlay = null;
        }
    }

    private async Task OnCloseHandler()
    {
        if (OnClose.HasDelegate)
            await OnClose.InvokeAsync();
    }
}
