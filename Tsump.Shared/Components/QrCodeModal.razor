@using Tsump.Scoring
@inject LanguageService Lang

@if (IsOpen && !string.IsNullOrEmpty(Url))
{
    <div class="qr-backdrop" @onclick="OnCloseHandler">
        <div class="qr-popup" @onclick:stopPropagation="true">
            <div class="qr-header">
                @if (Overlay != null)
                {
                    @* Coloured badge: organizer = blue clipboard, scoring = green check.
                       Lives in the header rather than on the QR itself because hardware
                       2D scanners can't tolerate any on-QR overlay. *@
                    <svg width="28" height="28" viewBox="0 0 32 32" class="me-2" style="flex-shrink:0;">
                        <circle cx="16" cy="16" r="16" fill="@Overlay.BackgroundColor" />
                        <g transform="translate(4,4) scale(1.5)" fill="white">
                            @((MarkupString)Overlay.GlyphSvg)
                        </g>
                    </svg>
                }
                <h6 class="mb-0 flex-grow-1">@(Title ?? Lang.Get("QrCodeTitle"))</h6>
                @if (OnSave.HasDelegate)
                {
                    <button class="btn btn-sm btn-outline-secondary me-1" @onclick="OnSaveHandler"
                            aria-label="@Lang.Get("SaveAs")" title="@Lang.Get("SaveAs")">
                        <i class="bi bi-floppy"></i>
                    </button>
                }
                <button class="btn btn-sm btn-outline-secondary" @onclick="OnCloseHandler" aria-label="@Lang.Get("Close")">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="qr-body">
                @if (svgMarkup != null)
                {
                    @((MarkupString)svgMarkup)
                }
            </div>
            @if (!string.IsNullOrEmpty(Subtitle))
            {
                <div class="qr-footer">
                    <small class="text-muted">@Subtitle</small>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string? Url { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public QrCodeRenderer.CenterOverlay? Overlay { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    /// <summary>Optional "save as" action. When wired, a floppy-icon button appears in the
    /// header; the callback is responsible for actually triggering the file save (the modal
    /// stays out of the JS interop business).</summary>
    [Parameter] public EventCallback OnSave { get; set; }

    private string? svgMarkup;
    private string? renderedFor;

    protected override void OnParametersSet()
    {
        // Re-render the SVG only when the URL actually changes — building a QR is cheap
        // but not free (a few ms for our payload sizes). Overlay no longer affects the QR
        // itself (it's drawn separately in the header above), so it doesn't need to
        // invalidate the cached SVG.
        if (IsOpen && !string.IsNullOrEmpty(Url) && Url != renderedFor)
        {
            svgMarkup = QrCodeRenderer.ToSvg(Url);
            renderedFor = Url;
        }
        else if (!IsOpen)
        {
            renderedFor = null;
        }
    }

    private async Task OnCloseHandler()
    {
        if (OnClose.HasDelegate)
            await OnClose.InvokeAsync();
    }

    private async Task OnSaveHandler()
    {
        if (OnSave.HasDelegate)
            await OnSave.InvokeAsync();
    }
}
