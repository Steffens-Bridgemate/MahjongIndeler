@using Tsump.Models
@using Tsump.Services
@inject LanguageService Lang

@{
    var score = Table.Score;
    if (score == null) return;
    var sumDiff = score.PlayerScores.Sum(p => p.Difference);
    var allEndPointsFilled = score.PlayerScores.All(p => p.EndPoints.HasValue);
    var hasError = allEndPointsFilled && sumDiff != 0;
    if (score.PlayerScores.Any(p => p.Loan != 0 || p.Penalty != 0))
        showExtras = true;
}

<div class="card mb-3 @(Table.PlayerCount == 3 ? "border-warning" : "border-success")">
    <div class="card-header @(Table.PlayerCount == 3 ? "bg-warning text-dark" : "bg-success text-white") py-1 d-flex align-items-center">
        <span class="flex-grow-1">@Lang.Get("Table") @Table.TableNumber (@Table.PlayerCount @Lang.Get("players"))</span>
        @if (showClearConfirm)
        {
            <span class="me-2 small">@Lang.Get("ClearScoresConfirm")</span>
            <button class="btn btn-sm btn-danger py-0 px-2 me-1" style="line-height:1;"
                    @onclick="ConfirmClear">@Lang.Get("YesClear")</button>
            <button class="btn btn-sm btn-secondary py-0 px-2" style="line-height:1;"
                    @onclick="() => showClearConfirm = false">@Lang.Get("Cancel")</button>
        }
        else
        {
            <button class="btn btn-sm bg-white py-0 px-1 border" style="line-height:1;"
                    @onclick="() => showClearConfirm = true"
                    title="@Lang.Get("ClearScores")">
                <i class="bi bi-trash text-danger" style="font-size:1.15rem;"></i>
            </button>
        }
    </div>
    <div class="card-body p-2">
        @* Narrow layout (any viewport with width or height under 500px — covers phones
           in either orientation and foldables in their compact state). One card per
           player, with a per-player Advanced toggle that reveals Loan / Penalty rows
           for that player only. *@
        <div class="score-table-narrow">
            @if (hasError)
            {
                <div class="alert alert-danger py-2 mb-2 small">
                    @(sumDiff < 0 ? Lang.Get("Deficit") : Lang.Get("Surplus")): @Math.Abs(sumDiff) @Lang.Get("Points")
                </div>
            }
            @for (int idxLoop = 0; idxLoop < score.PlayerScores.Count; idxLoop++)
            {
                var idx = idxLoop;
                var ps = score.PlayerScores[idx];
                var psRef = ps;
                var extras = IsExtrasShownFor(idx);
                <div class="card mb-2 @(ps.IsVirtual ? "bg-light" : "")">
                    <div class="card-header py-1 d-flex align-items-center">
                        <strong class="flex-grow-1">
                            @if (ps.IsVirtual)
                            {
                                <em>@ps.VirtualName</em>
                            }
                            else
                            {
                                @GetPlayerName(ps.PlayerId)
                            }
                        </strong>
                        @if (!ps.IsVirtual)
                        {
                            <button class="btn btn-sm btn-outline-secondary py-0 px-2"
                                    style="font-size:1.1rem;line-height:1;min-width:2rem;"
                                    @onclick="() => ToggleExtrasFor(idx)"
                                    title="@Lang.Get("Advanced")">
                                @(extras ? "−" : "+")
                            </button>
                        }
                    </div>
                    <div class="card-body p-2">
                        <div class="d-flex gap-2 align-items-stretch">
                            @* Left side — labels (col 1) + inputs (col 2) in a compact table. *@
                            <table class="table table-sm table-bordered mb-0" style="flex:1; min-width:0;">
                                <tbody>
                                    <tr>
                                        <td style="vertical-align:middle;">@Lang.Get("StartShort")</td>
                                        <td class="text-center">
                                            @* Start is pre-filled and rarely edited — skip in tab order so Tab
                                               on End goes straight to the next card's End. *@
                                            <input type="text" inputmode="decimal" class="form-control form-control-sm text-center"
                                                   tabindex="-1"
                                                   value="@FormatDisplay(psRef.StartingPoints)"
                                                   @onchange="e => OnStartingPointsChanged(psRef, e)" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="vertical-align:middle;">@Lang.Get("EndShort")</td>
                                        <td class="text-center">
                                            @* All End inputs share tabindex=1 → tabbed first, in source order. *@
                                            <input type="text" inputmode="decimal" class="form-control form-control-sm text-center"
                                                   tabindex="1"
                                                   value="@(psRef.EndPoints.HasValue ? FormatDisplay(psRef.EndPoints.Value) : "")"
                                                   placeholder="−"
                                                   @onchange="e => OnEndPointsChanged(psRef, e)" />
                                        </td>
                                    </tr>
                                    @if (extras && !ps.IsVirtual)
                                    {
                                        <tr>
                                            <td style="vertical-align:middle;">@Lang.Get("LoanShort")</td>
                                            <td class="text-center">
                                                <input type="text" inputmode="decimal" class="form-control form-control-sm text-center"
                                                       value="@FormatLoan(psRef.Loan)"
                                                       placeholder="−"
                                                       @onfocus="e => OnLoanFocus(psRef)"
                                                       @onchange="e => OnLoanChanged(psRef, e)"
                                                       style="@(psRef.Loan != 0 ? "background-color:#ffe5e5;" : "")" />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="vertical-align:middle;">@Lang.Get("PenaltyShort")</td>
                                            <td class="text-center">
                                                <input type="text" inputmode="decimal" class="form-control form-control-sm text-center"
                                                       value="@(psRef.Penalty != 0 ? FormatDisplay(psRef.Penalty) : "")"
                                                       placeholder="−"
                                                       @onchange="e => OnPenaltyChanged(psRef, e)"
                                                       style="@(psRef.Penalty != 0 ? "background-color:#ffe5e5;" : "")" />
                                            </td>
                                        </tr>
                                    }
                                    <tr class="fw-bold">
                                        @* "border-style: hidden" beats neighbouring borders under
                                           border-collapse, so this empty cell renders invisibly. *@
                                        <td style="border-style:hidden; background:transparent;"></td>
                                        <td class="text-end table-active" style="vertical-align:middle;">@Lang.Get("FinalScoreShort")</td>
                                    </tr>
                                </tbody>
                            </table>

                            @* Right side (col 3) — compact summary: Diff, Uma, Total. *@
                            <div class="d-flex flex-column justify-content-around small ps-1" style="min-width:90px;">
                                <div class="d-flex justify-content-between @(hasError ? "text-danger fw-bold" : "")">
                                    <span>@Lang.Get("DifferenceMicro"):</span>
                                    <span class="text-end fw-bold">
                                        @if (ps.IsVirtual)
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                        else if (ps.EndPoints.HasValue)
                                        {
                                            @FormatDisplaySigned(ps.Difference)
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span>@Lang.Get("UmaShort"):</span>
                                    <span class="text-end">
                                        @if (ps.IsVirtual)
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                        else if (allEndPointsFilled && sumDiff == 0)
                                        {
                                            @FormatDisplaySigned(ps.Uma)
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </span>
                                </div>
                                @* Same background as the .table-active Total row in col 1+2,
                                   so the bottom of the card reads as a single Total band. *@
                                <div class="text-end fw-bold px-1" style="font-size:1.15em; background-color: rgba(0,0,0,0.075);">
                                    @if (ps.IsVirtual)
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                    else if (allEndPointsFilled && sumDiff == 0)
                                    {
                                        @FormatDisplaySigned(ps.Total)
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Wide layout (viewport with both dimensions ≥ 500px): the original 5-column table. *@
        <div class="score-table-wide">
            <table class="table table-sm table-bordered mb-0">
                <thead>
                    <tr>
                        <th style="min-width:60px;text-align:center;vertical-align:middle;">
                            <button class="btn btn-outline-secondary" style="font-size:1.5rem;width:2.2rem;height:2.2rem;padding:0;display:inline-flex;align-items:center;justify-content:center;line-height:1;" @onclick="ToggleExtras" title="@Lang.Get("Advanced")">
                                @(showExtras ? "−" : "+")
                            </button>
                        </th>
                        @foreach (var ps in score.PlayerScores)
                        {
                            <th class="text-center" style="min-width:90px;">
                                @if (ps.IsVirtual)
                                {
                                    <em>@ps.VirtualName</em>
                                }
                                else
                                {
                                    @GetPlayerName(ps.PlayerId)
                                }
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td style="vertical-align:middle;">@Lang.Get("StartShort")</td>
                        @foreach (var ps in score.PlayerScores)
                        {
                            var psRef = ps;
                            <td class="text-center">
                                @* Start is pre-filled and rarely edited — skip in tab order so Tab
                                   on the last End cell jumps to the next ScoreTable's first End. *@
                                <input type="text" inputmode="decimal" class="form-control form-control-sm text-center"
                                       tabindex="-1"
                                       value="@FormatDisplay(psRef.StartingPoints)"
                                       @onchange="e => OnStartingPointsChanged(psRef, e)"
                                       style="width:100%;" />
                            </td>
                        }
                    </tr>
                    <tr>
                        <td style="vertical-align:middle;">@Lang.Get("EndShort")</td>
                        @foreach (var ps in score.PlayerScores)
                        {
                            var psRef = ps;
                            <td class="text-center">
                                @* All End inputs share tabindex=1 → tabbed first across the page in source order. *@
                                <input type="text" inputmode="decimal" class="form-control form-control-sm text-center"
                                       tabindex="1"
                                       value="@(psRef.EndPoints.HasValue ? FormatDisplay(psRef.EndPoints.Value) : "")"
                                       placeholder="−"
                                       @onchange="e => OnEndPointsChanged(psRef, e)"
                                       style="width:100%;" />
                            </td>
                        }
                    </tr>
                    @if (showExtras)
                    {
                    <tr>
                        <td style="vertical-align:middle;">@Lang.Get("LoanShort")</td>
                        @foreach (var ps in score.PlayerScores)
                        {
                            var psRef = ps;
                            <td class="text-center">
                                <input type="text" inputmode="decimal" class="form-control form-control-sm text-center"
                                       value="@FormatLoan(psRef.Loan)"
                                       placeholder="−"
                                       @onfocus="e => OnLoanFocus(psRef)"
                                       @onchange="e => OnLoanChanged(psRef, e)"
                                       style="width:100%;@(psRef.Loan != 0 ? "background-color:#ffe5e5;" : "")" />
                            </td>
                        }
                    </tr>
                    }
                    <tr style="height:6px;line-height:0;font-size:0;"><td colspan="@(score.PlayerScores.Count + 1)" style="padding:0;border:none;"></td></tr>
                    <tr style="height:0;line-height:0;font-size:0;"><td style="padding:0 4px;border:none;border-bottom:3px solid #333;font-size:11px;line-height:1;color:#666;vertical-align:bottom;">+</td><td colspan="@score.PlayerScores.Count" style="padding:0;border:none;border-bottom:3px solid #333;"></td></tr>
                    <tr class="@(hasError ? "table-danger" : "")">
                        <td style="vertical-align:middle;">
                            @Lang.Get("DifferenceShort")
                            @if (hasError)
                            {
                                <br /><small class="text-danger">@(sumDiff < 0 ? Lang.Get("Deficit") : Lang.Get("Surplus")): @Math.Abs(sumDiff) @Lang.Get("Points")</small>
                            }
                        </td>
                        @foreach (var ps in score.PlayerScores)
                        {
                            <td class="text-center fw-bold">
                                @if (ps.IsVirtual)
                                {
                                    @* Mr. X: no computed values *@
                                }
                                else if (ps.EndPoints.HasValue)
                                {
                                    @FormatDisplaySigned(ps.Difference)
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        }
                    </tr>
                    <tr>
                        <td style="vertical-align:middle;">@Lang.Get("UmaShort")</td>
                        @foreach (var ps in score.PlayerScores)
                        {
                            <td class="text-center">
                                @if (ps.IsVirtual)
                                {
                                    @* Mr. X: no Uma *@
                                }
                                else if (allEndPointsFilled && sumDiff == 0)
                                {
                                    @FormatDisplaySigned(ps.Uma)
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        }
                    </tr>
                    @if (showExtras)
                    {
                    <tr>
                        <td style="vertical-align:middle;">@Lang.Get("PenaltyShort")</td>
                        @foreach (var ps in score.PlayerScores)
                        {
                            var psRef = ps;
                            <td class="text-center">
                                @if (ps.IsVirtual)
                                {
                                    @* Mr. X: no penalty *@
                                }
                                else
                                {
                                    <input type="text" inputmode="decimal" class="form-control form-control-sm text-center"
                                           value="@(psRef.Penalty != 0 ? FormatDisplay(psRef.Penalty) : "")"
                                           placeholder="−"
                                           @onchange="e => OnPenaltyChanged(psRef, e)"
                                           style="width:100%;@(psRef.Penalty != 0 ? "background-color:#ffe5e5;" : "")" />
                                }
                            </td>
                        }
                    </tr>
                    }
                    <tr style="height:6px;line-height:0;font-size:0;"><td colspan="@(score.PlayerScores.Count + 1)" style="padding:0;border:none;"></td></tr>
                    <tr style="height:0;line-height:0;font-size:0;"><td style="padding:0 4px;border:none;border-bottom:3px solid #333;font-size:11px;line-height:1;color:#666;vertical-align:bottom;">+</td><td colspan="@score.PlayerScores.Count" style="padding:0;border:none;border-bottom:3px solid #333;"></td></tr>
                    <tr class="table-active fw-bold">
                        <td style="vertical-align:middle;">@Lang.Get("FinalScoreShort")</td>
                        @foreach (var ps in score.PlayerScores)
                        {
                            <td class="text-center">
                                @if (ps.IsVirtual)
                                {
                                    @* Mr. X: no final score *@
                                }
                                else if (allEndPointsFilled && sumDiff == 0)
                                {
                                    @FormatDisplaySigned(ps.Total)
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        }
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public TableAssignment Table { get; set; } = default!;

    [Parameter, EditorRequired]
    public Func<Guid, string> PlayerNameResolver { get; set; } = default!;

    [Parameter]
    public EventCallback OnScoresComplete { get; set; }

    [Parameter]
    public EventCallback OnScoresCleared { get; set; }

    [Parameter]
    public int DefaultStartingPoints { get; set; } = 30000;

    [Parameter]
    public List<int> Uma4Players { get; set; } = new() { 15000, 5000, -5000, -15000 };

    [Parameter]
    public List<int> Uma3Players { get; set; } = new() { 12500, 0, -12500 };

    private bool showExtras;
    private bool showClearConfirm;
    // Per-player advanced toggle for the narrow (smartphone-portrait) layout.
    // Keyed by player index inside Table.Score.PlayerScores.
    private HashSet<int> expandedPlayers = new();

    private void ToggleExtras() => showExtras = !showExtras;

    private void ToggleExtrasFor(int index)
    {
        if (!expandedPlayers.Remove(index))
            expandedPlayers.Add(index);
    }

    /// <summary>
    /// True when the Loan/Penalty rows should render for the player at <paramref name="index"/>
    /// in the narrow layout. Auto-shows when there is non-zero Loan or Penalty data so the
    /// user always sees their existing entries.
    /// </summary>
    private bool IsExtrasShownFor(int index)
    {
        if (expandedPlayers.Contains(index)) return true;
        var s = Table.Score;
        if (s != null && index >= 0 && index < s.PlayerScores.Count)
        {
            var ps = s.PlayerScores[index];
            if (ps.Loan != 0 || ps.Penalty != 0) return true;
        }
        return false;
    }

    private async Task ConfirmClear()
    {
        showClearConfirm = false;
        var score = Table.Score;
        if (score == null) return;

        foreach (var ps in score.PlayerScores)
        {
            ps.StartingPoints = DefaultStartingPoints;
            ps.EndPoints = null;
            ps.Loan = 0;
            ps.Penalty = 0;
            ps.Uma = 0;
        }
        showExtras = false;
        expandedPlayers.Clear();
        await OnScoresCleared.InvokeAsync();
    }

    private string GetPlayerName(Guid id) => PlayerNameResolver(id);

    // Display: internal int ÷ 100, one decimal
    private static string FormatDisplay(int value)
    {
        return (value / 1000.0).ToString("0.0");
    }

    private static string FormatDisplaySigned(int value)
    {
        return (value / 1000.0).ToString("+0.0;-0.0;0.0");
    }

    private static string FormatLoan(int loan)
    {
        if (loan != 0)
            return FormatDisplay(loan);
        return "";
    }

    private void OnLoanFocus(PlayerScore ps)
    {
        // Auto-insert minus prefix when the loan field is empty
        if (ps.Loan == 0)
        {
            ps.Loan = 0; // keep at 0, the placeholder "−" guides the user
        }
    }

    // Parse: user enters decimal (e.g. "285.0"), store as int × 100
    private static int? ParseInput(string? input)
    {
        if (string.IsNullOrWhiteSpace(input)) return null;
        // Accept both . and , as decimal separator
        var normalized = input.Replace(',', '.');
        if (decimal.TryParse(normalized, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var d))
            return (int)Math.Round(d * 1000);
        return null;
    }

    private async Task OnStartingPointsChanged(PlayerScore ps, ChangeEventArgs e)
    {
        ps.StartingPoints = ParseInput(e.Value?.ToString()) ?? DefaultStartingPoints;
        DeriveVirtualEnd(Table);
        CalculateUma();
        await CheckAndNotifyComplete();
    }

    private async Task OnLoanChanged(PlayerScore ps, ChangeEventArgs e)
    {
        var parsed = ParseInput(e.Value?.ToString()) ?? 0;
        // Loans are always negative — auto-negate if user enters a positive number
        ps.Loan = parsed > 0 ? -parsed : parsed;
        DeriveVirtualEnd(Table);
        CalculateUma();
        await CheckAndNotifyComplete();
    }

    private async Task OnEndPointsChanged(PlayerScore ps, ChangeEventArgs e)
    {
        ps.EndPoints = ParseInput(e.Value?.ToString());
        DeriveVirtualEnd(Table);
        CalculateUma();
        await CheckAndNotifyComplete();
    }

    private async Task OnPenaltyChanged(PlayerScore ps, ChangeEventArgs e)
    {
        var parsed = ParseInput(e.Value?.ToString()) ?? 0;
        // Penalties are always negative — auto-negate if user enters a positive number
        ps.Penalty = parsed > 0 ? -parsed : parsed;
        DeriveVirtualEnd(Table);
        CalculateUma();
        await CheckAndNotifyComplete();
    }

    /// <summary>
    /// For 3-player tables, the virtual player (Mr. X) doesn't have an end-points input;
    /// his value is derived so the sum of differences across all four PlayerScores is zero.
    /// Idempotent: if there is no virtual player, or if any real player still has a null
    /// EndPoints, this sets the virtual player's EndPoints to null (waiting on more input).
    /// Static so non-UI callers (e.g. score-import / restore flows) can reuse it.
    /// </summary>
    public static void DeriveVirtualEnd(TableAssignment table)
    {
        var score = table.Score;
        if (score == null) return;
        var mrX = score.PlayerScores.FirstOrDefault(p => p.IsVirtual);
        if (mrX == null) return;

        var realPlayers = score.PlayerScores.Where(p => !p.IsVirtual).ToList();
        if (realPlayers.Count == 0 || !realPlayers.All(p => p.EndPoints.HasValue))
        {
            mrX.EndPoints = null;
            return;
        }

        var realDiff = realPlayers.Sum(p => (p.EndPoints!.Value - p.StartingPoints) + p.Loan);
        mrX.EndPoints = mrX.StartingPoints - realDiff;
    }

    private async Task CheckAndNotifyComplete()
    {
        var score = Table.Score;
        if (score == null) return;

        bool allFilled = score.PlayerScores.All(p => p.EndPoints.HasValue);
        int sumDiff = score.PlayerScores.Sum(p => p.Difference);

        if (allFilled && sumDiff == 0)
        {
            await OnScoresComplete.InvokeAsync();
        }
    }

    private void CalculateUma()
        => CalculateUma(Table, Uma3Players, Uma4Players);

    /// <summary>
    /// Assigns Uma values to each non-virtual PlayerScore on <paramref name="table"/> based on
    /// difference ranking. Tied differences get the averaged Uma. Only applies when all
    /// EndPoints are filled and the differences sum to zero. Static so non-UI callers
    /// (e.g. ScoreImportService) can reuse it.
    /// </summary>
    public static void CalculateUma(TableAssignment table, List<int> uma3Players, List<int> uma4Players)
    {
        var score = table.Score;
        if (score == null) return;

        foreach (var ps in score.PlayerScores)
            ps.Uma = 0;

        // Only apply Uma when all end points are filled and sum is zero
        if (!score.PlayerScores.All(p => p.EndPoints.HasValue))
            return;
        if (score.PlayerScores.Sum(p => p.Difference) != 0)
            return;

        var ranked = score.PlayerScores
            .Where(p => !p.IsVirtual)
            .OrderByDescending(p => p.Difference)
            .ToList();

        if (ranked.Count == 0) return;

        int[] umaValues = table.PlayerCount == 3
            ? uma3Players.ToArray()
            : uma4Players.ToArray();

        // Group tied players and assign average Uma
        int i = 0;
        while (i < ranked.Count && i < umaValues.Length)
        {
            // Find all players tied with the same difference
            int tieStart = i;
            while (i + 1 < ranked.Count && ranked[i + 1].Difference == ranked[tieStart].Difference)
                i++;
            int tieEnd = i;

            // Average the Uma values for the tied positions
            int sum = 0;
            int count = 0;
            for (int j = tieStart; j <= tieEnd && j < umaValues.Length; j++)
            {
                sum += umaValues[j];
                count++;
            }
            int avgUma = count > 0 ? sum / count : 0;

            for (int j = tieStart; j <= tieEnd; j++)
            {
                ranked[j].Uma = avgUma;
            }

            i++;
        }
    }

    public static void InitializeScores(List<TableAssignment> tables, Func<string, string> langGet, int startingPoints = 30000)
    {
        foreach (var table in tables)
        {
            if (table.Score == null)
                table.Score = new TableScore();

            var score = table.Score;
            var existingIds = score.PlayerScores.Select(p => p.PlayerId).ToHashSet();

            foreach (var pid in table.PlayerIds)
            {
                if (!existingIds.Contains(pid))
                    score.PlayerScores.Add(new PlayerScore { PlayerId = pid, StartingPoints = startingPoints });
            }

            score.PlayerScores.RemoveAll(p => !p.IsVirtual && !table.PlayerIds.Contains(p.PlayerId));

            if (table.PlayerCount == 3 && !score.PlayerScores.Any(p => p.IsVirtual))
            {
                score.PlayerScores.Add(new PlayerScore
                {
                    IsVirtual = true,
                    VirtualName = langGet("MrX"),
                    StartingPoints = startingPoints
                });
            }

            if (table.PlayerCount >= 4)
                score.PlayerScores.RemoveAll(p => p.IsVirtual);

            var ordered = new List<PlayerScore>();
            foreach (var pid in table.PlayerIds)
            {
                var ps = score.PlayerScores.FirstOrDefault(p => p.PlayerId == pid);
                if (ps != null) ordered.Add(ps);
            }
            ordered.AddRange(score.PlayerScores.Where(p => p.IsVirtual));
            score.PlayerScores = ordered;
        }
    }
}
