@using Tsump.Services
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject LanguageService Lang

@* Shown when a newer service-worker version has installed and is waiting. We do NOT activate it
   in place (no skipWaiting / no mid-action reload) — the update applies the next time the app is
   launched fresh. The banner just informs the user and offers a best-effort "close now" to help
   on phones/tablets that otherwise stay open indefinitely. The JS side (registerAppUpdateCallback
   / closeAppForUpdate) lives in each app's index.html. *@
@if (updateAvailable)
{
    <div style="position:fixed;left:0;right:0;bottom:0;z-index:1080;background:#0d6efd;color:#fff;
                padding:10px 16px;display:flex;align-items:center;justify-content:center;gap:12px;
                flex-wrap:wrap;box-shadow:0 -2px 8px rgba(0,0,0,.25);">
        <span>
            <i class="bi bi-arrow-clockwise me-2"></i>@Lang.Get(closeBlocked ? "UpdateRestartManual" : "UpdateAvailable")
        </span>
        <span class="d-flex gap-2">
            @if (!closeBlocked)
            {
                <button class="btn btn-sm btn-light" @onclick="CloseApp">@Lang.Get("CloseAppNow")</button>
            }
            <button class="btn btn-sm btn-outline-light" @onclick="Dismiss">@Lang.Get("UpdateLater")</button>
        </span>
    </div>
}

@code {
    private bool updateAvailable;
    private bool closeBlocked;
    private DotNetObjectReference<AppUpdateBanner>? selfRef;

    protected override void OnInitialized() => Lang.OnLanguageChanged += StateHasChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        selfRef = DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("registerAppUpdateCallback", selfRef); }
        catch { /* service worker / JS unavailable — simply no update prompts */ }
    }

    // Called from JS when a newer worker has finished installing and is waiting.
    [JSInvokable]
    public void OnUpdateAvailable()
    {
        if (updateAvailable) return;
        updateAvailable = true;
        StateHasChanged();
    }

    private async Task CloseApp()
    {
        // window.close() is best-effort: it works for an installed desktop PWA but is commonly
        // blocked on mobile. closeAppForUpdate resolves only if the window is STILL open shortly
        // after (i.e. the close was blocked) — if it actually closed, control never returns here.
        try { await JS.InvokeAsync<bool>("closeAppForUpdate"); }
        catch { /* ignore */ }
        closeBlocked = true;
        StateHasChanged();
    }

    private void Dismiss() => updateAvailable = false;

    public ValueTask DisposeAsync()
    {
        Lang.OnLanguageChanged -= StateHasChanged;
        selfRef?.Dispose();
        return ValueTask.CompletedTask;
    }
}
