@page "/settings"
@using Tsump.Models
@using Tsump.Services
@using Microsoft.JSInterop
@inject SettingsService SettingsService
@inject LanguageService Lang
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>@Lang.Get("Settings") - Tsumo!</PageTitle>

<h1><i class="bi bi-gear-fill me-2"></i>@Lang.Get("Settings")</h1>

<ul class="nav nav-tabs mb-4">
    <li class="nav-item">
        <a class="nav-link @(activeTab == "clubevent" ? "active" : "")"
           href="javascript:void(0)" @onclick='() => activeTab = "clubevent"'>
            <i class="bi bi-calendar-event me-1"></i>@Lang.Get("SettingsTabClubEvent")
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(activeTab == "tournament" ? "active" : "")"
           href="javascript:void(0)" @onclick='() => activeTab = "tournament"'>
            <i class="bi bi-trophy me-1"></i>@Lang.Get("SettingsTabTournament")
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(activeTab == "style" ? "active" : "")"
           href="javascript:void(0)" @onclick='() => activeTab = "style"'>
            <i class="bi bi-palette me-1"></i>@Lang.Get("SettingsTabStyle")
        </a>
    </li>
</ul>

@* --- Club event tab --- *@

<div class="@(activeTab == "clubevent" ? "" : "d-none")">

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">@Lang.Get("CompetitionPeriod")</h5>
        <input type="text" class="form-control" style="max-width:250px;" maxlength="20"
               value="@competitionPeriod"
               @onchange="OnCompetitionPeriodChanged" />
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">@Lang.Get("PlayingDays")</h5>
        <p class="text-muted">@Lang.Get("PlayingDaysDesc")</p>

        <div class="row mb-3">
            @foreach (var day in allDays)
            {
                var isChecked = schedule.ContainsKey(day);
                <div class="col-auto">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox"
                               checked="@isChecked"
                               @onchange="async e => { ToggleDay(day, (bool)(e.Value ?? false)); await Save(); }" />
                        <label class="form-check-label">@Lang.Get(day.ToString())</label>
                    </div>
                </div>
            }
        </div>

        @foreach (var day in allDays.Where(d => schedule.ContainsKey(d)))
        {
            <div class="card mb-3">
                <div class="card-body py-2">
                    <h6 class="mb-2">@Lang.Get(day.ToString())</h6>
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                        @foreach (var time in schedule[day].OrderBy(t => t))
                        {
                            var t = time;
                            <span class="badge bg-primary d-flex align-items-center" style="font-size: 0.95em;">
                                @t.ToString(@"hh\:mm")
                                <button type="button" class="btn-close btn-close-white ms-2" style="font-size: 0.6em;"
                                        @onclick="() => RemoveTime(day, t)"></button>
                            </span>
                        }
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <select class="form-select" style="max-width: 75px;"
                                value="@(newHours.GetValueOrDefault(day, -1))"
                                @onchange="e => OnNewHourChanged(day, e)">
                            <option value="-1">--</option>
                            @for (int h = 0; h < 24; h++)
                            {
                                var hh = h;
                                <option value="@hh">@hh.ToString("D2")</option>
                            }
                        </select>
                        <span>:</span>
                        <select class="form-select" style="max-width: 75px;"
                                value="@(newMinutes.GetValueOrDefault(day, -1))"
                                @onchange="e => OnNewMinuteChanged(day, e)">
                            <option value="-1">--</option>
                            @for (int m = 0; m < 60; m += 5)
                            {
                                var mm = m;
                                <option value="@mm">@mm.ToString("D2")</option>
                            }
                        </select>
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => AddTime(day)">
                            + @Lang.Get("AddTime")
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">@Lang.Get("DefaultStartTime")</h5>
        <p class="text-muted">@Lang.Get("DefaultStartTimeDesc")</p>
        <div class="d-flex align-items-center gap-2">
            <select class="form-select" style="max-width: 75px;"
                    value="@defaultStartHour"
                    @onchange="async e => { if (int.TryParse(e.Value?.ToString(), out var h)) { defaultStartHour = h; await Save(); } }">
                @for (int h = 0; h < 24; h++)
                {
                    var hh = h;
                    <option value="@hh">@hh.ToString("D2")</option>
                }
            </select>
            <span>:</span>
            <select class="form-select" style="max-width: 75px;"
                    value="@defaultStartMinute"
                    @onchange="async e => { if (int.TryParse(e.Value?.ToString(), out var m)) { defaultStartMinute = m; await Save(); } }">
                @for (int m = 0; m < 60; m += 5)
                {
                    var mm = m;
                    <option value="@mm">@mm.ToString("D2")</option>
                }
            </select>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">@Lang.Get("ScoringSettings")</h5>
        <div class="form-check mb-1">
            <input class="form-check-input" type="checkbox"
                   checked="@enableScoreEntry"
                   @onchange="async e => { enableScoreEntry = (bool)(e.Value ?? false); if (!enableScoreEntry) enableExternalScoring = false; await Save(); }" />
            <label class="form-check-label">@Lang.Get("EnableScoreEntry")</label>
        </div>
        <div class="form-check mb-1 ms-3">
            <input class="form-check-input" type="checkbox"
                   checked="@enableExternalScoring"
                   disabled="@(!enableScoreEntry)"
                   @onchange="async e => { enableExternalScoring = (bool)(e.Value ?? false); if (!enableExternalScoring) enableScanLogging = false; await Save(); }" />
            <label class="form-check-label">@Lang.Get("EnableExternalScoring")</label>
        </div>
        <div class="form-check mb-3 ms-5">
            <input class="form-check-input" type="checkbox"
                   checked="@enableScanLogging"
                   disabled="@(!enableExternalScoring)"
                   @onchange="async e => { enableScanLogging = (bool)(e.Value ?? false); await Save(); }" />
            <label class="form-check-label">@Lang.Get("ActivateLogging")</label>
            <div class="form-text">@Lang.Get("ActivateLoggingHint")</div>
        </div>
        <div class="row mb-2" style="opacity: @(enableScoreEntry ? "1" : "0.5");">
            <div class="col-md-4 mb-2">
                <label class="form-label">@Lang.Get("StartingPoints")</label>
                <input type="text" inputmode="decimal" class="form-control" style="max-width:120px;"
                       disabled="@(!enableScoreEntry)"
                       value="@FormatPoints(weeklyStartingPoints)"
                       @onchange="async e => { weeklyStartingPoints = ParsePoints(e.Value?.ToString(), 30000); await Save(); }" />
            </div>
            <div class="col-md-4 mb-2">
                <label class="form-label">@Lang.Get("Uma4Players")</label>
                <div class="d-flex gap-1">
                    @for (int idx = 0; idx < weeklyUma4Players.Count; idx++)
                    {
                        var i = idx;
                        <input type="text" inputmode="decimal" class="form-control form-control-sm text-center" style="max-width:80px;"
                               disabled="@(!enableScoreEntry)"
                               value="@FormatPointsSigned(weeklyUma4Players[i])"
                               @onchange="async e => { weeklyUma4Players[i] = ParsePoints(e.Value?.ToString(), 0); await Save(); }" />
                    }
                </div>
            </div>
            <div class="col-md-4 mb-2">
                <label class="form-label">@Lang.Get("Uma3Players")</label>
                <div class="d-flex gap-1">
                    @for (int idx = 0; idx < weeklyUma3Players.Count; idx++)
                    {
                        var i = idx;
                        <input type="text" inputmode="decimal" class="form-control form-control-sm text-center" style="max-width:80px;"
                               disabled="@(!enableScoreEntry)"
                               value="@FormatPointsSigned(weeklyUma3Players[i])"
                               @onchange="async e => { weeklyUma3Players[i] = ParsePoints(e.Value?.ToString(), 0); await Save(); }" />
                    }
                </div>
            </div>
        </div>
    </div>
</div>

</div>

@* --- Tournament tab --- *@

<div class="@(activeTab == "tournament" ? "" : "d-none")">

<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">@Lang.Get("TournamentStartTimes")</h5>
        <p class="text-muted">@Lang.Get("TournamentStartTimesDesc")</p>
        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
            @foreach (var time in tournamentStartTimes.OrderBy(t => t))
            {
                var t = time;
                <span class="badge bg-primary d-flex align-items-center" style="font-size: 0.95em;">
                    @t.ToString(@"hh\:mm")
                    <button type="button" class="btn-close btn-close-white ms-2" style="font-size: 0.6em;"
                            @onclick="() => RemoveTournamentTime(t)"></button>
                </span>
            }
        </div>
        <div class="d-flex align-items-center gap-2">
            <select class="form-select" style="max-width: 75px;"
                    value="@newTournamentHour"
                    @onchange="e => { if (int.TryParse(e.Value?.ToString(), out var h)) newTournamentHour = h; }">
                <option value="-1">--</option>
                @for (int h = 0; h < 24; h++)
                {
                    var hh = h;
                    <option value="@hh">@hh.ToString("D2")</option>
                }
            </select>
            <span>:</span>
            <select class="form-select" style="max-width: 75px;"
                    value="@newTournamentMinute"
                    @onchange="e => { if (int.TryParse(e.Value?.ToString(), out var m)) newTournamentMinute = m; }">
                <option value="-1">--</option>
                @for (int m = 0; m < 60; m += 5)
                {
                    var mm = m;
                    <option value="@mm">@mm.ToString("D2")</option>
                }
            </select>
            <button class="btn btn-sm btn-outline-primary" @onclick="AddTournamentTime">
                + @Lang.Get("AddStartTime")
            </button>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">@Lang.Get("ScoringSettings")</h5>
        <div class="row mb-2">
            <div class="col-md-4 mb-2">
                <label class="form-label">@Lang.Get("StartingPoints")</label>
                <input type="text" inputmode="decimal" class="form-control" style="max-width:120px;"
                       value="@FormatPoints(tournamentStartingPoints)"
                       @onchange="async e => { tournamentStartingPoints = ParsePoints(e.Value?.ToString(), 30000); await Save(); }" />
            </div>
            <div class="col-md-4 mb-2">
                <label class="form-label">@Lang.Get("Uma4Players")</label>
                <div class="d-flex gap-1">
                    @for (int idx = 0; idx < tournamentUma4Players.Count; idx++)
                    {
                        var i = idx;
                        <input type="text" inputmode="decimal" class="form-control form-control-sm text-center" style="max-width:80px;"
                               value="@FormatPointsSigned(tournamentUma4Players[i])"
                               @onchange="async e => { tournamentUma4Players[i] = ParsePoints(e.Value?.ToString(), 0); await Save(); }" />
                    }
                </div>
            </div>
            <div class="col-md-4 mb-2">
                <label class="form-label">@Lang.Get("Uma3Players")</label>
                <div class="d-flex gap-1">
                    @for (int idx = 0; idx < tournamentUma3Players.Count; idx++)
                    {
                        var i = idx;
                        <input type="text" inputmode="decimal" class="form-control form-control-sm text-center" style="max-width:80px;"
                               value="@FormatPointsSigned(tournamentUma3Players[i])"
                               @onchange="async e => { tournamentUma3Players[i] = ParsePoints(e.Value?.ToString(), 0); await Save(); }" />
                    }
                </div>
            </div>
        </div>
    </div>
</div>

</div>

@* --- Style tab --- *@

<div class="@(activeTab == "style" ? "" : "d-none")">

    @* Action bar — explicit save (no autosave); changes only touch localStorage on Save. *@
    <div class="d-flex align-items-center flex-wrap gap-1 mb-2">
        <button class="btn btn-success" disabled="@(!styleDirty)" @onclick="SaveStyle">
            <i class="bi bi-check-lg me-1"></i>@Lang.Get("Save")
        </button>
        <button class="btn btn-outline-secondary" disabled="@(!styleDirty)" @onclick="DiscardStyle">
            <i class="bi bi-arrow-counterclockwise me-1"></i>@Lang.Get("DiscardChanges")
        </button>
        <div class="w-100"></div>
        <button class="btn btn-sm btn-outline-secondary mt-1" @onclick="ExportStyle">
            <i class="bi bi-box-arrow-down me-1"></i>@Lang.Get("ExportStyle")
        </button>
        <button class="btn btn-sm btn-outline-secondary mt-1" @onclick='() => triggerFileInput("styleFile")'>
            <i class="bi bi-box-arrow-up me-1"></i>@Lang.Get("ImportStyle")
        </button>
        <InputFile id="styleFile" style="display:none" accept=".json,application/json" OnChange="OnStyleFileSelected" />
    </div>

    @if (styleError != null)
    {
        <div class="alert alert-danger py-1 mb-3">@styleError</div>
    }
    @if (styleDirty)
    {
        <div class="alert alert-warning py-1 mb-3">@Lang.Get("UnsavedStyleChanges")</div>
    }
    else if (styleSaved)
    {
        <div class="alert alert-success py-1 mb-3">@Lang.Get("StyleSaved")</div>
    }

    @* Live preview — reflects every choice immediately (colours via the global --club-* vars,
       brand/logo/banner/link from the in-memory style). Nothing here is persisted. *@
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">@Lang.Get("StylePreview")</h5>
            <p class="text-muted small">@Lang.Get("StylePreviewDesc")</p>

            <div class="border rounded mb-3" style="overflow:hidden;">
                @* mock top bar: brand/logo on the left, website link on the right *@
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 px-3 py-2"
                     style="background-color:#f5f5f5; border-bottom:1px solid #eaeaea;">
                    <span class="d-flex align-items-center gap-2" style="color:var(--club-primary,#004b8d); font-weight:bold;">
                        @if (!string.IsNullOrWhiteSpace(style.LogoImage))
                        {
                            <img src="@style.LogoImage" alt="logo" style="max-height:2.2rem; width:auto;" />
                        }
                        else
                        {
                            <span>@(string.IsNullOrWhiteSpace(style.BrandText) ? "—" : style.BrandText)</span>
                        }
                        <span class="text-muted" style="font-size:0.6em;">v@(Tsump.AppVersion.Version)</span>
                    </span>
                    @if (!string.IsNullOrWhiteSpace(style.WebsiteUrl))
                    {
                        <a href="@style.WebsiteUrl" target="_blank" rel="noopener">
                            @(string.IsNullOrWhiteSpace(style.WebsiteLabel) ? style.WebsiteUrl : style.WebsiteLabel)
                        </a>
                    }
                </div>
                @* mock banner *@
                @if (!string.IsNullOrWhiteSpace(style.BannerImage))
                {
                    <img src="@style.BannerImage" alt="banner" class="img-fluid d-block w-100"
                         style="max-height:140px; object-fit:cover;" />
                }
            </div>

            @* sample controls so the colours are visible even before a banner/logo is set *@
            <div class="d-flex align-items-center flex-wrap gap-3">
                <button type="button" class="btn btn-primary btn-sm">@Lang.Get("SampleButton")</button>
                <a href="javascript:void(0)">@Lang.Get("SampleLink")</a>
                <span class="badge" style="background-color:var(--club-primary,#004b8d);">@Lang.Get("PrimaryColor")</span>
            </div>
        </div>
    </div>

    @* Club identity *@
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">@Lang.Get("StyleIdentity")</h5>
            <div class="mb-3">
                <label class="form-label">@Lang.Get("BrandText")</label>
                <input type="text" class="form-control" style="max-width:300px;" maxlength="40"
                       value="@style.BrandText"
                       @onchange="e => { style.BrandText = e.Value?.ToString() ?? string.Empty; MarkDirty(); }" />
            </div>
            <div class="mb-3">
                <label class="form-label">@Lang.Get("WebsiteUrl")</label>
                <input type="url" class="form-control" style="max-width:400px;" placeholder="https://…"
                       value="@style.WebsiteUrl"
                       @onchange="e => { style.WebsiteUrl = e.Value?.ToString() ?? string.Empty; MarkDirty(); }" />
            </div>
            <div class="mb-1">
                <label class="form-label">@Lang.Get("WebsiteLinkLabel")</label>
                <input type="text" class="form-control" style="max-width:300px;" maxlength="40"
                       value="@style.WebsiteLabel"
                       @onchange="e => { style.WebsiteLabel = e.Value?.ToString() ?? string.Empty; MarkDirty(); }" />
            </div>
        </div>
    </div>

    @* Colours *@
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">@Lang.Get("StyleColors")</h5>
            <div class="row">
                <div class="col-md-6 mb-2">
                    <label class="form-label">@Lang.Get("PrimaryColor")</label>
                    <div class="d-flex align-items-center gap-2">
                        <input type="color" class="form-control form-control-color" style="width:48px;"
                               value="@style.PrimaryColor"
                               @oninput="async e => { style.PrimaryColor = e.Value?.ToString() ?? style.PrimaryColor; MarkDirty(); await ApplyStyle(); }" />
                        <input type="text" class="form-control" style="max-width:120px;" maxlength="7"
                               value="@style.PrimaryColor"
                               @onchange="async e => { style.PrimaryColor = NormalizeHex(e.Value?.ToString(), style.PrimaryColor); MarkDirty(); await ApplyStyle(); }" />
                    </div>
                </div>
                <div class="col-md-6 mb-2">
                    <label class="form-label">@Lang.Get("LinkColor")</label>
                    <div class="d-flex align-items-center gap-2">
                        <input type="color" class="form-control form-control-color" style="width:48px;"
                               value="@style.LinkColor"
                               @oninput="async e => { style.LinkColor = e.Value?.ToString() ?? style.LinkColor; MarkDirty(); await ApplyStyle(); }" />
                        <input type="text" class="form-control" style="max-width:120px;" maxlength="7"
                               value="@style.LinkColor"
                               @onchange="async e => { style.LinkColor = NormalizeHex(e.Value?.ToString(), style.LinkColor); MarkDirty(); await ApplyStyle(); }" />
                    </div>
                </div>
            </div>

            @* Pick a colour from a reference image (e.g. a Snipping Tool capture of the club site) *@
            <hr class="my-3" />
            <label class="form-label mb-1">@Lang.Get("PickFromImage")</label>
            <p class="text-muted small mb-2">@Lang.Get("PickFromImageHint")</p>
            <div class="d-flex align-items-center flex-wrap gap-2 mb-2">
                <button class="btn btn-sm btn-outline-secondary" @onclick='() => triggerFileInput("pickerFile")'>
                    <i class="bi bi-image me-1"></i>@Lang.Get("UploadImage")
                </button>
                <input type="file" id="pickerFile" accept="image/*" class="d-none" @onchange="OnPickerFileSelected" />
                <span class="text-muted small">@Lang.Get("OrPasteSnip")</span>
                @if (pickerHasImage)
                {
                    <div class="btn-group btn-group-sm ms-2" role="group">
                        <button type="button" class="btn @(pickTarget == "primary" ? "btn-primary" : "btn-outline-primary")"
                                @onclick='() => pickTarget = "primary"'>@Lang.Get("PrimaryColor")</button>
                        <button type="button" class="btn @(pickTarget == "link" ? "btn-primary" : "btn-outline-primary")"
                                @onclick='() => pickTarget = "link"'>@Lang.Get("LinkColor")</button>
                    </div>
                    @if (pickedColor != null)
                    {
                        <span class="d-inline-flex align-items-center gap-1 ms-1">
                            <span style="display:inline-block;width:1.1rem;height:1.1rem;border:1px solid #ccc;border-radius:3px;background-color:@pickedColor;"></span>
                            <code>@pickedColor</code>
                        </span>
                    }
                }
            </div>
            @if (pickerError != null)
            {
                <div class="alert alert-danger py-1">@pickerError</div>
            }
            <canvas id="pickerCanvas" class="@(pickerHasImage ? "" : "d-none")"
                    style="max-width:100%; cursor:crosshair; border:1px solid #ddd; border-radius:3px;"></canvas>
        </div>
    </div>

    @* Images *@
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">@Lang.Get("StyleImages")</h5>

            @* Logo *@
            <div class="mb-4">
                <label class="form-label fw-bold">@Lang.Get("Logo")</label>
                <div class="d-flex align-items-center flex-wrap gap-2 mb-2">
                    @if (!string.IsNullOrWhiteSpace(style.LogoImage))
                    {
                        <img src="@style.LogoImage" alt="logo" style="max-height:48px; max-width:160px; border:1px solid #ddd; border-radius:3px;" />
                        <button class="btn btn-sm btn-outline-danger" title="@Lang.Get("ClearImage")"
                                @onclick="() => { style.LogoImage = null; MarkDirty(); }">
                            <i class="bi bi-trash"></i>
                        </button>
                    }
                    <button class="btn btn-sm btn-outline-secondary" @onclick='() => triggerFileInput("logoFile")'>
                        <i class="bi bi-upload me-1"></i>@Lang.Get("UploadImage")
                    </button>
                    <input type="file" id="logoFile" accept="image/*" class="d-none" @onchange="OnLogoSelected" />
                </div>
                <input type="url" class="form-control" style="max-width:400px;" placeholder="@Lang.Get("ImageUrl")"
                       value="@(IsDataUrl(style.LogoImage) ? "" : style.LogoImage)"
                       @onchange="e => { var v = e.Value?.ToString(); style.LogoImage = string.IsNullOrWhiteSpace(v) ? null : v; MarkDirty(); }" />
            </div>

            @* Banner *@
            <div>
                <label class="form-label fw-bold">@Lang.Get("Banner")</label>
                <div class="mb-2">
                    @if (!string.IsNullOrWhiteSpace(style.BannerImage))
                    {
                        <div class="mb-2">
                            <img src="@style.BannerImage" alt="banner" class="img-fluid" style="max-height:120px; border:1px solid #ddd; border-radius:3px;" />
                        </div>
                    }
                    <div class="d-flex align-items-center flex-wrap gap-2">
                        <button class="btn btn-sm btn-outline-secondary" @onclick='() => triggerFileInput("bannerFile")'>
                            <i class="bi bi-upload me-1"></i>@Lang.Get("UploadImage")
                        </button>
                        <input type="file" id="bannerFile" accept="image/*" class="d-none" @onchange="OnBannerSelected" />
                        @if (!string.IsNullOrWhiteSpace(style.BannerImage))
                        {
                            <button class="btn btn-sm btn-outline-danger" title="@Lang.Get("ClearImage")"
                                    @onclick="() => { style.BannerImage = null; MarkDirty(); }">
                                <i class="bi bi-trash"></i>
                            </button>
                        }
                    </div>
                </div>
                <input type="url" class="form-control" style="max-width:400px;" placeholder="@Lang.Get("ImageUrl")"
                       value="@(IsDataUrl(style.BannerImage) ? "" : style.BannerImage)"
                       @onchange="e => { var v = e.Value?.ToString(); style.BannerImage = string.IsNullOrWhiteSpace(v) ? null : v; MarkDirty(); }" />
            </div>
        </div>
    </div>

    @* Reset — stages the neutral palette; nothing is persisted until Save. *@
    <div class="mb-4">
        @if (confirmReset)
        {
            <span class="alert alert-warning d-inline-block mb-0 py-1">
                @Lang.Get("ResetStyleConfirm")
                <button class="btn btn-sm btn-warning ms-2 me-1" @onclick="ConfirmReset">@Lang.Get("YesReset")</button>
                <button class="btn btn-sm btn-secondary" @onclick="() => confirmReset = false">@Lang.Get("Cancel")</button>
            </span>
        }
        else
        {
            <button class="btn btn-outline-secondary" @onclick="() => confirmReset = true">
                <i class="bi bi-arrow-counterclockwise me-1"></i>@Lang.Get("ResetStyle")
            </button>
        }
    </div>

</div>


@code {
    private string activeTab = "clubevent";
    private string competitionPeriod = "";
    private bool enableScoreEntry;
    private Dictionary<DayOfWeek, List<TimeSpan>> schedule = new();
    private Dictionary<DayOfWeek, int> newHours = new();
    private Dictionary<DayOfWeek, int> newMinutes = new();
    private int defaultStartHour = 13;
    private int defaultStartMinute = 0;
    private List<TimeSpan> tournamentStartTimes = new();
    private int newTournamentHour = -1;
    private int newTournamentMinute = -1;
    private int weeklyStartingPoints = 30000;
    private List<int> weeklyUma4Players = new() { 15000, 5000, -5000, -15000 };
    private List<int> weeklyUma3Players = new() { 12500, 0, -12500 };
    private int tournamentStartingPoints = 30000;
    private List<int> tournamentUma4Players = new() { 15000, 5000, -5000, -15000 };
    private List<int> tournamentUma3Players = new() { 12500, 0, -12500 };
    private bool enableExternalScoring;
    private bool enableScanLogging;
    private ClubStyle style = new();
    private ClubStyle savedStyle = new();   // last-persisted snapshot (for Discard + preview revert)
    private bool styleDirty;
    private bool styleSaved;
    private string? styleError;
    private bool confirmReset;

    // Colour-from-image eyedropper (reference image is transient — never persisted).
    private const int PickerMaxDim = 900;
    private DotNetObjectReference<Settings>? selfRef;
    private bool pickerHasImage;
    private string pickTarget = "primary";   // which colour the next image-click sets
    private string? pickedColor;
    private string? pickerError;
    private static readonly DayOfWeek[] allDays = new[]
    {
        DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday,
        DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday
    };

    protected override void OnInitialized() => Lang.OnLanguageChanged += StateHasChanged;

    public void Dispose()
    {
        Lang.OnLanguageChanged -= StateHasChanged;
        // If the user leaves with an unsaved colour preview applied, revert the global CSS
        // variables to the persisted values so the rest of the app isn't left previewing
        // colours that were never consented to. Fire-and-forget: JS is still alive across SPA nav.
        if (styleDirty)
            _ = JS.InvokeVoidAsync("applyClubStyle", savedStyle.PrimaryColor, savedStyle.LinkColor);
        // Tear down the picker's global paste listener and release the .NET ref.
        if (selfRef != null)
        {
            _ = JS.InvokeVoidAsync("clubPicker.dispose");
            selfRef.Dispose();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var settings = await SettingsService.GetAsync();
            competitionPeriod = settings.CompetitionPeriod;
            enableScoreEntry = settings.EnableScoreEntry;
            foreach (var entry in settings.Schedule)
            {
                schedule[entry.Day] = new List<TimeSpan>(entry.StartTimes);
            }
            defaultStartHour = settings.DefaultStartTime.Hours;
            defaultStartMinute = settings.DefaultStartTime.Minutes;
            tournamentStartTimes = new List<TimeSpan>(settings.TournamentStartTimes);
            weeklyStartingPoints = settings.WeeklyStartingPoints;
            weeklyUma4Players = new List<int>(settings.WeeklyUma4Players);
            weeklyUma3Players = new List<int>(settings.WeeklyUma3Players);
            tournamentStartingPoints = settings.TournamentStartingPoints;
            tournamentUma4Players = new List<int>(settings.TournamentUma4Players);
            tournamentUma3Players = new List<int>(settings.TournamentUma3Players);
            enableExternalScoring = settings.EnableExternalScoring;
            enableScanLogging = settings.EnableScanLogging;
            style = settings.Style.Clone();
            savedStyle = settings.Style.Clone();
            StateHasChanged();

            // Wire up the colour-from-image picker (canvas + global paste listener).
            selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("clubPicker.init", "pickerCanvas", selfRef, PickerMaxDim);
        }
    }

    private void ToggleDay(DayOfWeek day, bool enabled)
    {
        if (enabled)
        {
            if (!schedule.ContainsKey(day))
                schedule[day] = new List<TimeSpan>();
        }
        else
        {
            schedule.Remove(day);
        }
    }

    private void OnNewHourChanged(DayOfWeek day, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var h))
            newHours[day] = h;
    }

    private void OnNewMinuteChanged(DayOfWeek day, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var m))
            newMinutes[day] = m;
    }

    private async Task AddTime(DayOfWeek day)
    {
        if (!newHours.TryGetValue(day, out var h) || h < 0) return;
        if (!newMinutes.TryGetValue(day, out var m) || m < 0) return;

        var time = new TimeSpan(h, m, 0);
        if (!schedule.ContainsKey(day))
            schedule[day] = new List<TimeSpan>();
        if (!schedule[day].Contains(time))
            schedule[day].Add(time);
        newHours[day] = -1;
        newMinutes[day] = -1;
        await Save();
    }

    private async Task RemoveTime(DayOfWeek day, TimeSpan time)
    {
        if (schedule.ContainsKey(day))
            schedule[day].Remove(time);
        await Save();
    }

    private async Task AddTournamentTime()
    {
        if (newTournamentHour < 0 || newTournamentMinute < 0) return;
        var time = new TimeSpan(newTournamentHour, newTournamentMinute, 0);
        if (!tournamentStartTimes.Contains(time))
            tournamentStartTimes.Add(time);
        newTournamentHour = -1;
        newTournamentMinute = -1;
        await Save();
    }

    private async Task RemoveTournamentTime(TimeSpan time)
    {
        tournamentStartTimes.Remove(time);
        await Save();
    }

    private static string FormatPoints(int value) => (value / 1000.0).ToString("0.0");
    private static string FormatPointsSigned(int value) => (value / 1000.0).ToString("+0.0;-0.0;0.0");
    private static int ParsePoints(string? input, int fallback)
    {
        if (string.IsNullOrWhiteSpace(input)) return fallback;
        var normalized = input.Replace(',', '.');
        if (decimal.TryParse(normalized, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var d))
            return (int)Math.Round(d * 1000);
        return fallback;
    }

    private async Task OnCompetitionPeriodChanged(ChangeEventArgs e)
    {
        competitionPeriod = e.Value?.ToString() ?? string.Empty;
        await Save();
    }

    private async Task Save()
    {
        var existing = await SettingsService.GetAsync();
        var settings = new ClubSettings
        {
            MembersPinnedColumns = existing.MembersPinnedColumns,
            CompetitionPeriod = competitionPeriod,
            EnableScoreEntry = enableScoreEntry,
            Schedule = schedule
                .Where(kv => kv.Value.Count > 0)
                .Select(kv => new ScheduleEntry
                {
                    Day = kv.Key,
                    StartTimes = kv.Value.OrderBy(t => t).ToList()
                })
                .ToList(),
            DefaultStartTime = new TimeSpan(defaultStartHour, defaultStartMinute, 0),
            TournamentStartTimes = tournamentStartTimes.OrderBy(t => t).ToList(),
            WeeklyStartingPoints = weeklyStartingPoints,
            WeeklyUma4Players = new List<int>(weeklyUma4Players),
            WeeklyUma3Players = new List<int>(weeklyUma3Players),
            TournamentStartingPoints = tournamentStartingPoints,
            TournamentUma4Players = new List<int>(tournamentUma4Players),
            TournamentUma3Players = new List<int>(tournamentUma3Players),
            EnableExternalScoring = enableExternalScoring,
            EnableScanLogging = enableScanLogging,
            Style = style
        };
        await SettingsService.SaveAsync(settings);
    }

    // --- Style tab ---
    //
    // Deliberately NO autosave: edits only mutate the in-memory `style` (plus a live colour
    // preview) and flip `styleDirty`. Nothing is written to localStorage until the user clicks
    // Save. `savedStyle` is the last-persisted snapshot, used to Discard and to revert the live
    // colour preview if the user leaves with unsaved changes.

    private void MarkDirty()
    {
        styleDirty = true;
        styleSaved = false;
        styleError = null;
    }

    // The only path that persists style to localStorage. SettingsService.OnChanged then fires, so
    // MainLayout and NavMenu re-read and re-apply (colours/brand/link/banner update app-wide).
    private async Task SaveStyle()
    {
        await Save();
        savedStyle = style.Clone();
        styleDirty = false;
        confirmReset = false;
        styleError = null;
        styleSaved = true;
    }

    // Throw away unsaved edits: restore the persisted snapshot and revert the live preview.
    private async Task DiscardStyle()
    {
        style = savedStyle.Clone();
        styleDirty = false;
        styleSaved = false;
        confirmReset = false;
        styleError = null;
        await ApplyStyle();
    }

    // Live-preview the colours without persisting (used while editing the colour pickers, on
    // import, and to revert on discard/leave). Not persistence — just CSS variables on <html>.
    private async Task ApplyStyle()
    {
        await JS.InvokeVoidAsync("applyClubStyle", style.PrimaryColor, style.LinkColor);
    }

    private async Task OnLogoSelected()
    {
        // Logo: keep transparency (PNG), modest size.
        var dataUrl = await JS.InvokeAsync<string?>("readImageAsDataUrl", "logoFile", 256, false);
        if (!string.IsNullOrEmpty(dataUrl))
        {
            style.LogoImage = dataUrl;
            MarkDirty();
        }
    }

    private async Task OnBannerSelected()
    {
        // Banner: wider, JPEG to keep the localStorage blob small.
        var dataUrl = await JS.InvokeAsync<string?>("readImageAsDataUrl", "bannerFile", 1200, true);
        if (!string.IsNullOrEmpty(dataUrl))
        {
            style.BannerImage = dataUrl;
            MarkDirty();
        }
    }

    // --- Colour-from-image eyedropper ---

    private async Task OnPickerFileSelected()
    {
        var ok = await JS.InvokeAsync<bool>("clubPicker.loadFromInput", "pickerFile", PickerMaxDim);
        OnPickerImageLoaded(ok);
        StateHasChanged();
    }

    [JSInvokable]
    public void OnPickerImageLoaded(bool ok)
    {
        pickerHasImage = ok;
        pickerError = ok ? null : Lang.Get("PickImageFailed");
        StateHasChanged();
    }

    // Called from JS when the user clicks a pixel in the reference image. Applies the sampled
    // colour to the selected target (primary/link) — staged like any other edit (no autosave).
    [JSInvokable]
    public async Task OnColorPicked(string hex)
    {
        pickedColor = hex;
        if (pickTarget == "link")
            style.LinkColor = hex;
        else
            style.PrimaryColor = hex;
        MarkDirty();
        await ApplyStyle();
        StateHasChanged();
    }

    // Stage the neutral palette + preview; persisted only when the user then clicks Save.
    private async Task ConfirmReset()
    {
        style = ClubStyle.Neutral();
        confirmReset = false;
        MarkDirty();
        await ApplyStyle();
    }

    private async Task ExportStyle()
    {
        var json = System.Text.Json.JsonSerializer.Serialize(style,
            new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        var base64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(json));
        var name = string.IsNullOrWhiteSpace(style.BrandText) ? "club" : style.BrandText.Trim();
        await JS.InvokeVoidAsync("downloadFile", $"{name}-style.json", base64);
    }

    private async Task OnStyleFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file.Size > 8 * 1024 * 1024) { styleError = Lang.Get("FileTooLarge"); return; }
            using var reader = new System.IO.StreamReader(file.OpenReadStream(8 * 1024 * 1024));
            var json = await reader.ReadToEndAsync();
            var imported = System.Text.Json.JsonSerializer.Deserialize<ClubStyle>(json,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (imported == null || string.IsNullOrWhiteSpace(imported.PrimaryColor))
            {
                styleError = Lang.Get("InvalidStyleFile");
                return;
            }
            // Load into the editor and preview, but DON'T persist — the user must click Save.
            // MarkDirty() clears any previous error and shows the amber "unsaved" banner.
            style = imported;
            MarkDirty();
            await ApplyStyle();
        }
        catch (System.Text.Json.JsonException)
        {
            styleError = Lang.Get("InvalidStyleFile");
        }
        catch (Exception ex)
        {
            styleError = ex.Message;
        }
    }

    private async Task triggerFileInput(string id) => await JS.InvokeVoidAsync("triggerFileInput", id);

    private static bool IsDataUrl(string? url) => url?.StartsWith("data:", StringComparison.OrdinalIgnoreCase) ?? false;

    // Accepts "#rrggbb" or "rrggbb"; returns a normalized "#rrggbb" or the fallback if invalid.
    private static string NormalizeHex(string? input, string fallback)
    {
        if (string.IsNullOrWhiteSpace(input)) return fallback;
        var s = input.Trim();
        if (!s.StartsWith('#')) s = "#" + s;
        return System.Text.RegularExpressions.Regex.IsMatch(s, "^#[0-9a-fA-F]{6}$") ? s.ToLowerInvariant() : fallback;
    }
}
