@page "/scan-log"
@using Tsump.Models
@using Tsump.Scoring
@using Tsump.Services
@inject ScanLogService ScanLogSvc
@inject ScoreImportService ScoreImport
@inject SettingsService SettingsService
@inject LanguageService Lang
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>@Lang.Get("ScanLog") - Tsumo!</PageTitle>

<div class="d-flex align-items-center mb-3">
    <h1 class="flex-grow-1 mb-0"><i class="bi bi-card-list me-2"></i>@Lang.Get("ScanLog")</h1>
    @if (loggingEnabled && entries.Count > 0)
    {
        @if (confirmClear)
        {
            <span class="me-2 small">@Lang.Get("ScanLogClearConfirm")</span>
            <button class="btn btn-sm btn-danger me-1" @onclick="ClearLog">@Lang.Get("YesClear")</button>
            <button class="btn btn-sm btn-secondary" @onclick="() => confirmClear = false">@Lang.Get("Cancel")</button>
        }
        else
        {
            <button class="btn btn-sm btn-outline-danger" @onclick="() => confirmClear = true">
                <i class="bi bi-trash me-1"></i>@Lang.Get("ScanLogClear")
            </button>
        }
    }
</div>

@if (!loaded)
{
    <p>@Lang.Get("Loading")</p>
}
else if (!loggingEnabled)
{
    <div class="alert alert-secondary">@Lang.Get("ScanLogDisabled")</div>
}
else if (entries.Count == 0)
{
    <p class="text-muted">@Lang.Get("ScanLogEmpty")</p>
}
else
{
    @foreach (var vm in entries)
    {
        var headerClass = vm.Result != null && vm.Recognized ? "bg-light" : "bg-warning-subtle";
        <div class="card mb-3">
            <div class="card-header @headerClass d-flex align-items-center flex-wrap gap-2">
                <span class="flex-grow-1 fw-semibold">@HeaderLabel(vm)</span>
                <span class="text-muted small">@vm.Entry.TimestampUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</span>
            </div>
            <div class="card-body">
                <code class="d-block small text-break mb-2">@vm.Entry.Raw</code>

                <div class="d-flex flex-wrap gap-2">
                    @if (vm.CanDecode)
                    {
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ToggleDecode(vm)">
                            <i class="bi bi-box-arrow-in-down me-1"></i>@(vm.Expanded ? Lang.Get("ScanLogHide") : Lang.Get("ScanLogDecode"))
                        </button>
                    }
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => CopyRaw(vm)">
                        <i class="bi bi-clipboard me-1"></i>@(copiedId == vm.Entry.Id ? Lang.Get("Copied") : Lang.Get("CopyToClipboard"))
                    </button>
                </div>

                @if (vm.CanDecode)
                {
                    @if (vm.Expanded)
                    {
                        <div class="mt-3">
                            @if (vm.Preview == null)
                            {
                                <div class="d-flex align-items-center small">
                                    <div class="spinner-border spinner-border-sm text-primary me-2" role="status" aria-hidden="true"></div>
                                    <span class="text-muted">@Lang.Get("Loading")</span>
                                </div>
                            }
                            else if (vm.Preview.TableMismatch)
                            {
                                <div class="alert alert-warning py-2 mb-0">@Lang.Get("ScanLogMismatch")</div>
                            }
                            else
                            {
                                <ScoreTable Table="vm.Preview.Context.Table"
                                            PlayerNameResolver="vm.Preview.NameResolver"
                                            ReadOnly="true"
                                            DefaultStartingPoints="vm.Preview.Context.StartingPoints"
                                            Uma3Players="vm.Preview.Context.Uma3Players"
                                            Uma4Players="vm.Preview.Context.Uma4Players" />
                            }
                        </div>
                    }
                }
            </div>
        </div>
    }
}

@code {
    private bool loaded;
    private bool loggingEnabled;
    private bool confirmClear;
    private Guid? copiedId;
    private List<EntryVm> entries = new();

    private sealed class EntryVm
    {
        public required ScanLogEntry Entry { get; init; }
        public ScoringResult? Result { get; init; }
        public bool LooksLikeInvite { get; init; }
        public bool Recognized { get; init; }
        public bool TableFound { get; init; }
        public string? Label { get; init; }
        public bool Expanded { get; set; }
        public ScoreImportService.DecodePreview? Preview { get; set; }

        // Only results whose container AND table still exist can render a score preview.
        public bool CanDecode => Result != null && Recognized && TableFound;
    }

    protected override void OnInitialized() => Lang.OnLanguageChanged += StateHasChanged;
    public void Dispose() => Lang.OnLanguageChanged -= StateHasChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var settings = await SettingsService.GetAsync();
        loggingEnabled = settings.EnableScanLogging;

        if (loggingEnabled)
        {
            var raw = await ScanLogSvc.GetAllAsync();
            foreach (var e in raw)
            {
                var result = ScanResultParser.TryParse(e.Raw, out var invite);
                ScoreImportService.ScanDescription? desc = null;
                if (result != null)
                    desc = await ScoreImport.DescribeAsync(result.ContextId, result.TableNumber);

                entries.Add(new EntryVm
                {
                    Entry = e,
                    Result = result,
                    LooksLikeInvite = invite,
                    Recognized = desc?.Recognized ?? false,
                    TableFound = desc?.TableFound ?? false,
                    Label = desc?.Label,
                });
            }
        }

        loaded = true;
        StateHasChanged();
    }

    private string HeaderLabel(EntryVm vm)
    {
        if (vm.Result != null)
        {
            if (vm.Recognized && vm.Label != null)
                return vm.TableFound ? vm.Label : $"{vm.Label} — {Lang.Get("ScanLogTableGone")}";
            // Decodes as a result but no local container owns the ContextId (e.g. another organizer).
            return $"{Lang.Get("Table")} {vm.Result.TableNumber} · {vm.Result.ContextId.ToString()[..8]}…";
        }
        return vm.LooksLikeInvite ? Lang.Get("ScanLogInvite") : Lang.Get("ScanLogUnrecognized");
    }

    private async Task ToggleDecode(EntryVm vm)
    {
        vm.Expanded = !vm.Expanded;
        if (vm.Expanded && vm.Preview == null && vm.Result != null)
            vm.Preview = await ScoreImport.BuildPreviewAsync(vm.Result, Lang.Get);
    }

    private async Task CopyRaw(EntryVm vm)
    {
        await JS.InvokeVoidAsync("copyTextToClipboard", vm.Entry.Raw);
        copiedId = vm.Entry.Id;
        StateHasChanged();
        _ = ResetCopiedFlag();
    }

    private async Task ResetCopiedFlag()
    {
        await Task.Delay(2000);
        copiedId = null;
        StateHasChanged();
    }

    private async Task ClearLog()
    {
        await ScanLogSvc.ClearAsync();
        entries.Clear();
        confirmClear = false;
    }
}
