    /// the Scores tab reflects an imported result without stale references hanging around.
    /// Re-initialises Score on every table — the import only writes the matching table,
    /// and ScoreTable renders nothing when Score is null. Invoked by ScoreImportPanel.OnApplied.</summary>
    private async Task ReloadTournament()
    {
        tournament = await TournamentService.GetByIdAsync(Id);
        InitializeAllTournamentScores();
