@page "/tournament/{Id:guid}"
@using Tsump.Models
@using Tsump.Services
@inject TournamentService TournamentService
@inject TournamentAssignmentService AssignmentService
@inject SettingsService SettingsService
@inject LanguageService Lang
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject TournamentNavContext TournamentNav
@inject ContextNavService Ctx
@inject ScoreInviteService Invites
@implements IDisposable

<PageTitle>@Lang.Get("TournamentAssignments") - Tsumo!</PageTitle>

@if (tournament == null)
{
    <p>@Lang.Get("Loading")</p>
}
else
{
    <h1><i class="bi @ActiveViewIcon() me-2"></i>@tournament.Name</h1>
    <p class="text-muted">@Lang.FormatDate(tournament.Date) &middot; @tournament.SessionCount @Lang.Get("HanchansCount")</p>

    @* --- Initial generate button (pre-generation only; once generated the Regenerate
         button moves into the assignments card, on the Import-result row). --- *@
    @if (!tournament.IsGenerated)
    {
        <div class="d-flex align-items-center flex-wrap gap-1 mb-3">
            <button class="btn btn-primary" @onclick="GenerateSessions"
                    disabled="@(tournament.Participants.Count < 13)"
                    title="@(tournament.Participants.Count < 13 ? Lang.Get("NeedAtLeast13") : null)">
                <i class="bi bi-arrow-clockwise me-1"></i>@Lang.Get("GenerateAllHanchans")
            </button>
        </div>
    }

    @* --- Sessions display --- *@
    @if (tournament.Sessions.Count > 0)
    {
        @* Header + action mirror the active sidebar selector: title = that view's name; Regenerate
           shows only on Assignments, Import scores only on the score views. *@
        <CollapsibleCard Title="@ActiveViewTitle()" TitleClass="h4 mb-0" CssClass="mt-3 mb-3" @bind-Expanded="assignmentsExpanded">

        @{
            var onTablesTab = tournamentActiveTab == "tables";
        }
        <div class="d-flex align-items-start flex-wrap gap-2 mb-3">
            @if (onTablesTab)
            {
                @if (showRegenerateConfirm)
                {
                    <div class="alert alert-warning d-inline-block mb-0 py-1">
                        @Lang.Get("RegenerateConfirmTournament")
                        <button class="btn btn-sm btn-warning ms-2 me-1" @onclick="ConfirmRegenerate">@Lang.Get("YesRegenerate")</button>
                        <button class="btn btn-sm btn-secondary" @onclick="() => showRegenerateConfirm = false">@Lang.Get("Cancel")</button>
                    </div>
                }
                else
                {
                    <button class="btn btn-primary" @onclick="GenerateSessions">
                        <i class="bi bi-arrow-clockwise me-1"></i>@Lang.Get("RegenerateAllHanchans")
                    </button>
                }
            }
            else
            {
                <ScoreImportPanel IsEnabled="externalScoringEnabled"
                                  OnApplied="ReloadTournament"
                                  PlayerNameResolver="GetParticipantDisplay"
                                  TriggerButtonClass="btn btn-primary" />
            }
        </div>

        @* The view selectors (Assignments / Scores per Hanchan / Scores per Table) and their
           per-hanchan / per-table jump lists live in the sidebar (BuildTournamentNav), not in an
           in-page tab strip — see the contextual-nav pattern in docs/styles.md §12. *@
        @if (statusExplanation != null)
        {
            <div class="alert alert-info alert-dismissible py-2 small">
                @statusExplanation
                <button type="button" class="btn-close" @onclick="() => statusExplanation = null"></button>
            </div>
        }

        @if (tournamentActiveTab == "tables")
        {
        <div class="d-flex align-items-center mb-3 flex-wrap gap-1">
            @* Each export-all group takes its own row when expanded. *@
            <ExportButtonGroup TriggerLabel="@Lang.Get("ExportAssignments")" TriggerIcon="bi-stack" Small="true"
                               TriggerClass="btn-outline-secondary"
                               Expanded="showExportAll" ExpandedChanged="SetExportAll"
                               OnCopy="CopyAllToClipboard" Copied="copiedToClipboard"
                               OnPrint="OpenAllHanchans" OnDownload="DownloadAllHanchans" />
            @if (showExportAll || showExportScoresheetsAll)
            {
                <div class="w-100"></div>
            }
            <ExportButtonGroup TriggerLabel="@Lang.Get("ExportScoresheets")" TriggerIcon="bi-stack" Small="true"
                               TriggerClass="btn-outline-secondary"
                               Expanded="showExportScoresheetsAll" ExpandedChanged="SetExportScoresheetsAll"
                               OnPrint="PrintScoresheetsAll" OnDownload="DownloadScoresheetsAll" />
            @if (showExportAll || showExportScoresheetsAll)
            {
                <div class="w-100"></div>
            }
        </div>

        @if (selectedPlayerIds.Count > 0)
        {
            <div class="mb-3">
                <span class="text-muted me-2">
                    @Lang.Get("Selected"): @string.Join(", ", selectedPlayerIds.Select(id => GetParticipantDisplay(id)))
                </span>
                @if (selectedPlayerIds.Count == 2)
                {
                    <button class="btn btn-sm btn-primary me-1" @onclick="SwapSelectedPlayers">
                        @Lang.Get("SwapPlayers")
                    </button>
                }
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => selectedPlayerIds.Clear()">
                    @Lang.Get("ClearSelection")
                </button>
            </div>
        }

        @foreach (var session in tournament.Sessions.OrderBy(s => s.SessionNumber))
        {
            var sn = session.SessionNumber;
            var sess = session;
            var isHanchanExpanded = expandedHanchans.Contains(sn);
            <div class="d-flex align-items-center mt-4 mb-2 flex-wrap gap-1 table-scroll-anchor" id="@HanchanAssignAnchorId(sn)">
                <h5 class="mb-0">@Lang.Get("Hanchan") @sn</h5>
                <select class="form-select form-select-sm" style="max-width:65px;"
                        value="@(sess.StartTime.HasValue ? sess.StartTime.Value.Hours : -1)"
                        @onchange="e => OnSessionHourChanged(sess, e)">
                    <option value="-1">--</option>
                    @for (int h = 0; h < 24; h++)
                    {
                        var hh = h;
                        <option value="@hh">@hh.ToString("D2")</option>
                    }
                </select>
                <span>:</span>
                <select class="form-select form-select-sm" style="max-width:65px;"
                        value="@(sess.StartTime.HasValue ? sess.StartTime.Value.Minutes : -1)"
                        @onchange="e => OnSessionMinuteChanged(sess, e)">
                    <option value="-1">--</option>
                    @for (int m = 0; m < 60; m += 5)
                    {
                        var mm = m;
                        <option value="@mm">@mm.ToString("D2")</option>
                    }
                </select>
                <button class="btn btn-sm btn-outline-dark ms-3" @onclick="() => ToggleHanchan(sn)">
                    <i class="bi @(isHanchanExpanded ? "bi-chevron-up" : "bi-chevron-down")"></i>
                </button>
            </div>
            @* The two per-hanchan export buttons share their own row; each takes its own row when
               expanded, and opening one collapses the other. *@
            <div class="d-flex align-items-center flex-wrap gap-1 mb-2">
                <ExportButtonGroup TriggerLabel="@Lang.Get("ExportAssignments")" TriggerIcon="bi-table" Small="true"
                                   TriggerClass="btn-outline-secondary"
                                   Expanded="exportSingleHanchan == sn"
                                   ExpandedChanged="(bool v) => SetExportSingleHanchan(sn, v)"
                                   OnCopy="() => CopySingleHanchanToClipboard(sn)" Copied="copiedSingleHanchan == sn"
                                   OnPrint="() => OpenSingleHanchan(sn)" OnDownload="() => DownloadSingleHanchan(sn)" />
                @if (exportSingleHanchan == sn || exportScoresheetSingleHanchan == sn)
                {
                    <div class="w-100"></div>
                }
                <ExportButtonGroup TriggerLabel="@Lang.Get("ExportScoresheets")" TriggerIcon="bi-card-checklist" Small="true"
                                   TriggerClass="btn-outline-secondary"
                                   Expanded="exportScoresheetSingleHanchan == sn"
                                   ExpandedChanged="(bool v) => SetExportScoresheetSingleHanchan(sn, v)"
                                   OnPrint="() => PrintScoresheetsSingle(sn)" OnDownload="() => DownloadScoresheetsSingle(sn)" />
            </div>
            @if (isHanchanExpanded)
            {
            var stripSess = session;
            @* Per-hanchan strip: always available for navigation; green (scanned) and the mark-all
               checkbox are gated on the scanning setting. *@
            <TableNavStrip Tables="stripSess.Tables" IsGreen="AssignNavGreen"
                           AnchorId="@(t => AssignAnchorId(stripSess.SessionNumber, t.TableNumber))">
                <Leading>
                    @if (externalScoringEnabled)
                    {
                        <div class="form-check m-0 d-flex align-items-center" title="@Lang.Get("ScanAllTitle")">
                            <input class="form-check-input mt-0" type="checkbox" id="@($"scan-all-h{stripSess.SessionNumber}")"
                                   checked="@AllTablesScannedIn(stripSess)" @onchange="() => ToggleScanAllIn(stripSess)" />
                            <label class="form-check-label visually-hidden" for="@($"scan-all-h{stripSess.SessionNumber}")">@Lang.Get("ScanAll")</label>
                        </div>
                    }
                </Leading>
            </TableNavStrip>
            <div class="table-assign-grid">
                @foreach (var table in session.Tables)
                {
                    var tableRef = table;
                    var sessRef = session;
                    <div class="mb-3 table-scroll-anchor" id="@AssignAnchorId(sessRef.SessionNumber, table.TableNumber)">
                        <div class="card @(table.PlayerCount == 3 ? "border-warning" : "border-success")">
                            <div class="card-header d-flex justify-content-between align-items-center @(table.PlayerCount == 3 ? "bg-warning text-dark" : "bg-success text-white")">
                                <span>@Lang.Get("Table") @table.TableNumber</span>
                                @if (externalScoringEnabled)
                                {
                                    @* Mouse-toggled twin of the QR modal's Enter-set checkbox; same TableAssignment.Scanned. *@
                                    <label class="form-check-label d-flex align-items-center gap-1 m-0" title="@Lang.Get("ScannedTitle")" @onclick:stopPropagation="true">
                                        <input class="form-check-input m-0" type="checkbox"
                                               checked="@table.Scanned" @onchange="() => ToggleScanned(tableRef)" />
                                        <span class="small">@Lang.Get("Scanned")</span>
                                    </label>
                                }
                            </div>
                            <ul class="list-group list-group-flush">
                                @foreach (var playerId in table.PlayerIds)
                                {
                                    var pid = playerId;
                                    var isSelected = selectedPlayerIds.Contains(pid) && selectedSessionNumber == session.SessionNumber;
                                    <li class="list-group-item d-flex align-items-center @(isSelected ? "list-group-item-primary" : "")"
                                        style="cursor: grab"
                                        draggable="true"
                                        @ondragstart="() => OnDragStart(pid, session.SessionNumber)"
                                        @ondragover:preventDefault
                                        @ondrop="() => OnDrop(pid, session.SessionNumber)"
                                        @onclick="() => OnPlayerClick(pid, session.SessionNumber)">
                                        <span class="player-name-clip" title="@GetParticipantDisplay(pid)">@GetParticipantDisplay(pid)</span>
                                    </li>
                                }
                            </ul>
                            @if (externalScoringEnabled)
                            {
                                var titlePrefix = $"{tournament.Name} — {Lang.Get("Hanchan")} {sessRef.SessionNumber}";
                                var shortTitlePrefix = $"{Lang.Get("Hanchan")} {sessRef.SessionNumber}";
                                <TableShareActions ContextId="sessRef.Id"
                                                   SessionNumber="sessRef.SessionNumber"
                                                   Table="tableRef"
                                                   Tables="sessRef.Tables"
                                                   PlayerNameResolver="GetParticipantDisplay"
                                                   StartingPoints="tournamentStartingPoints"
                                                   Uma3="uma3Players"
                                                   Uma4="uma4Players"
                                                   TitlePrefix="@titlePrefix"
                                                   ShortTitlePrefix="@shortTitlePrefix"
                                                   ShortName="@tournament.ShortName"
                                                   OnScannedChanged="@(_ => PersistScanned())" />
                            }
                        </div>
                    </div>
                }
            </div>
            }
        }
        }
        else if (tournamentActiveTab == "scores")
        {
            @foreach (var session in tournament.Sessions.OrderBy(s => s.SessionNumber))
            {
                var sn = session.SessionNumber;
                var isHanchanExpanded = expandedHanchans.Contains(sn);
                <div class="d-flex align-items-baseline mt-3 mb-2 gap-2 table-scroll-anchor" id="@HanchanScoreAnchorId(sn)">
                    <h5 class="mb-0">@Lang.Get("Hanchan") @sn</h5>
                    @if (session.StartTime.HasValue)
                    {
                        <span class="fw-bold" style="font-size:1.25rem;">@session.StartTime.Value.ToString(@"hh\:mm")</span>
                    }
                    <button class="btn btn-sm btn-outline-dark ms-2" @onclick="() => ToggleHanchan(sn)">
                        <i class="bi @(isHanchanExpanded ? "bi-chevron-up" : "bi-chevron-down")"></i>
                    </button>
                </div>
                @if (isHanchanExpanded)
                {
                    var stripSession = session;
                    @* Per-hanchan strip: green = that table's result entry is complete. *@
                    <TableNavStrip Tables="stripSession.Tables" IsGreen="ScoreStatusHelper.TableIsComplete"
                                   AnchorId="@(t => ScoreAnchorId(stripSession.SessionNumber, t.TableNumber))" />
                    <div class="score-table-grid">
                        @foreach (var table in session.Tables)
                        {
                            <div class="table-scroll-anchor" id="@ScoreAnchorId(session.SessionNumber, table.TableNumber)">
                                <ScoreTable @key="(scoreTableVersion, session.Id, table.TableNumber)"
                                            Table="table" PlayerNameResolver="GetParticipantDisplay" OnScoresComplete="SaveScores" OnScoresCleared="SaveScores"
                                            DefaultStartingPoints="tournamentStartingPoints" Uma4Players="uma4Players" Uma3Players="uma3Players" />
                            </div>
                        }
                    </div>
                }
            }
        }
        else if (tournamentActiveTab == "allscores")
        {
            var allGroups = BuildAllScoresEntries();
            @* All-scores groups by table number; the strip jumps to each number's block. Green = every
               hanchan's instance of that table number is complete. *@
            var allComplete = allGroups.ToDictionary(g => g.TableNumber,
                g => g.Entries.All(e => ScoreStatusHelper.TableIsComplete(e.Table)));
            @if (allGroups.Count > 0)
            {
                <TableNavStrip Tables="@allGroups.Select(g => g.Entries[0].Table).ToList()"
                               IsGreen="@(t => allComplete.GetValueOrDefault(t.TableNumber))"
                               AnchorId="@(t => AllScoresAnchorId(t.TableNumber))" />
            }
            @foreach (var tableGroup in allGroups)
            {
                <h5 class="mt-3 mb-2 table-scroll-anchor" id="@AllScoresAnchorId(tableGroup.TableNumber)">@Lang.Get("Table") @tableGroup.TableNumber</h5>
                <div class="score-table-grid">
                    @foreach (var entry in tableGroup.Entries)
                    {
                        <div>
                            <h6 class="text-muted mb-1">@entry.Label</h6>
                            <ScoreTable @key="(scoreTableVersion, entry.Label, tableGroup.TableNumber)"
                                        Table="entry.Table" PlayerNameResolver="GetParticipantDisplay" OnScoresComplete="SaveScores" OnScoresCleared="SaveScores"
                                        DefaultStartingPoints="tournamentStartingPoints" Uma4Players="uma4Players" Uma3Players="uma3Players" />
                        </div>
                    }
                </div>
            }
        }
        </CollapsibleCard>

        @* --- 3-player distribution --- *@
        <CollapsibleCard Id="@DistributionAnchorId" Title="@Lang.Get("ThreePlayerDistribution")" CssClass="mt-4 mb-4 table-scroll-anchor" @bind-Expanded="threePlayerExpanded">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>@Lang.Get("ParticipantNumber")</th>
                                <th>@Lang.Get("ParticipantName")</th>
                                <th>@Lang.Get("TimesAt3Table")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in tournament.Participants.OrderBy(x => x.Number))
                            {
                                var count = CountThreePlayerTables(p.Id);
                                <tr>
                                    <td>@p.Number</td>
                                    <td>@p.Name</td>
                                    <td>@count</td>
                                </tr>
                            }
                        </tbody>
                    </table>
        </CollapsibleCard>

        @* --- Meeting matrix --- *@
        <CollapsibleCard Id="@MatrixAnchorId" Title="@Lang.Get("MeetingMatrixTitle")" CssClass="mb-4 table-scroll-anchor" @bind-Expanded="matrixExpanded">
                    <p class="text-muted">@Lang.Get("MeetingMatrixSubtitle")</p>
                    <div class="mb-3">
                        <table class="table table-bordered table-sm" style="width:auto;">
                            <thead>
                                <tr>
                                    <th class="text-center">@Lang.Get("Meetings")</th>
                                    <th class="text-center">@Lang.Get("Pairs")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var entry in matrixDistribution)
                                {
                                    <tr>
                                        <td class="text-center @GetMatrixCellClass(entry.Key)">@entry.Key</td>
                                        <td class="text-center">@entry.Value</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered table-sm meeting-matrix">
                            <thead>
                                <tr>
                                    <th class="sticky-col"></th>
                                    @foreach (var p in sortedParticipants)
                                    {
                                        <th class="text-center rotate-header">
                                            <div><span>@p.Number. @p.Name</span></div>
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in sortedParticipants)
                                {
                                    <tr>
                                        <td class="sticky-col fw-bold text-nowrap">@row.Number. @row.Name</td>
                                        @foreach (var col in sortedParticipants)
                                        {
                                            @if (row.Id == col.Id)
                                            {
                                                <td class="text-center bg-dark text-white">&mdash;</td>
                                            }
                                            else
                                            {
                                                var key = TableAssignmentService.MakeKey(row.Id, col.Id);
                                                var count = tournamentMatrix.GetValueOrDefault(key, 0);
                                                <td class="text-center @GetMatrixCellClass(count)">@count</td>
                                            }
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
        </CollapsibleCard>
    }

    @if (saved)
    {
        <div class="alert alert-success mt-3">@Lang.Get("TournamentSaved")</div>
    }
}

<style>
    .meeting-matrix { font-size: 0.8rem; }
    .meeting-matrix th.rotate-header { height: 120px; white-space: nowrap; vertical-align: bottom; padding: 0 4px; }
    .meeting-matrix th.rotate-header > div { transform: rotate(-60deg); transform-origin: left bottom; width: 1.5em; }
    .meeting-matrix th.rotate-header > div > span { display: inline-block; padding-bottom: 4px; }
    .meeting-matrix td, .meeting-matrix th { padding: 2px 4px; min-width: 28px; }
    .sticky-col { position: sticky; left: 0; background: white; z-index: 1; }
    .matrix-low { background-color: #d4edda; color: #155724; }
    .matrix-mid { background-color: #fff3cd; color: #856404; }
    .matrix-high { background-color: #f8d7da; color: #721c24; }
    .cell-zero { background-color: #f8f9fa; color: #adb5bd; }
    .cell-low { background-color: #d4edda; }
    .cell-mid { background-color: #fff3cd; }
    .cell-high { background-color: #f8d7da; }
</style>

@code {
    private string? statusExplanation;

    private ScoreStatusHelper.Status AllSessionsScoreStatus()
    {
        if (tournament == null || tournament.Sessions.Count == 0)
            return ScoreStatusHelper.Status.Normal;
        var ordered = tournament.Sessions.OrderBy(s => s.SessionNumber).ToList();
        var perEntry = ordered.Select((s, i) =>
            ScoreStatusHelper.Classify(s.Tables, ordered.Skip(i + 1).Select(o => o.Tables)));
        return ScoreStatusHelper.Aggregate(perEntry);
    }

    private void ShowStatusExplanation(ScoreStatusHelper.Status status, bool isAggregated)
    {
        statusExplanation = (status, isAggregated) switch
        {
            (ScoreStatusHelper.Status.Partial, false) => Lang.Get("StatusExpl_Partial"),
            (ScoreStatusHelper.Status.Stale, false) => Lang.Get("StatusExpl_Stale"),
            (ScoreStatusHelper.Status.Partial, true) => Lang.Get("StatusExpl_PartialAll"),
            (ScoreStatusHelper.Status.Stale, true) => Lang.Get("StatusExpl_StaleAll"),
            _ => null,
        };
    }

    [Parameter] public Guid Id { get; set; }

    private Tournament? tournament;
    private bool showRegenerateConfirm;
    private bool copiedToClipboard;
    private int? copiedSingleHanchan;
    private bool showExportAll;
    private bool showExportScoresheetsAll;
    private int? exportSingleHanchan;
    private int? exportScoresheetSingleHanchan;
    private bool saved;
    private bool assignmentsExpanded = true;
    private bool threePlayerExpanded;
    private bool matrixExpanded;
    private string tournamentActiveTab = "tables";
    private int tournamentStartingPoints = 30000;
    private List<int> uma4Players = new() { 15000, 5000, -5000, -15000 };
    private List<int> uma3Players = new() { 12500, 0, -12500 };
    private bool externalScoringEnabled;
    // Bumped after each successful import so @key changes on the rendered ScoreTables,
    // forcing Blazor to dispose stale instances and rebuild with the freshly written model.
    private int scoreTableVersion;

    // Meeting matrix data
    private List<TournamentParticipant> sortedParticipants = new();
    private Dictionary<string, int> tournamentMatrix = new();
    private List<KeyValuePair<int, int>> matrixDistribution = new();

    private HashSet<int> expandedHanchans = new();

    // Element id to smooth-scroll into view after the next render, set by the sidebar jump entries,
    // plus which JS scroller to use: "scrollToElement" reserves the sticky table-nav strip's height
    // (table/hanchan jumps under a strip); "scrollToAnchor" is a plain scroll honouring the target's
    // CSS scroll-margin (the bottom info cards, which sit below all strips).
    private string? pendingScrollId;
    private string pendingScrollFn = "scrollToElement";

    private const string DistributionAnchorId = "tnav-distribution";
    private const string MatrixAnchorId = "tnav-matrix";

    private List<Guid> selectedPlayerIds = new();
    private int? selectedSessionNumber;
    private Guid? draggedPlayerId;
    private int? draggedSessionNumber;

    protected override void OnInitialized() => Lang.OnLanguageChanged += StateHasChanged;
    public void Dispose()
    {
        Lang.OnLanguageChanged -= StateHasChanged;
        Ctx.Clear();
    }

    private void ToggleHanchan(int sessionNumber)
    {
        if (!expandedHanchans.Remove(sessionNumber))
            expandedHanchans.Add(sessionNumber);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            tournament = await TournamentService.GetByIdAsync(Id);
            var settings = await SettingsService.GetAsync();
            tournamentStartingPoints = tournament?.StartingPoints ?? settings.TournamentStartingPoints;
            uma4Players = tournament?.Uma4Players != null ? new List<int>(tournament.Uma4Players) : new List<int>(settings.TournamentUma4Players);
            uma3Players = tournament?.Uma3Players != null ? new List<int>(tournament.Uma3Players) : new List<int>(settings.TournamentUma3Players);
            externalScoringEnabled = settings.EnableExternalScoring;
            if (tournament != null && tournament.IsGenerated)
            {
                BuildTournamentMatrix();
                expandedHanchans = new HashSet<int>(tournament.Sessions.Select(s => s.SessionNumber));
            }
            StateHasChanged();
        }
        // Keep the sidebar's tournament sub-nav in sync (also reflects IsGenerated flipping after
        // Generate, since this runs on every render). Set() no-ops when nothing changed.
        if (tournament != null)
        {
            TournamentNav.Set(Id, tournament.IsGenerated);
            // Once generated, the page owns the whole tournament sidebar (view selectors + jump
            // lists) via the contextual nav; before that, fall back to NavMenu's URL-based sub-nav.
            if (tournament.IsGenerated) PublishNav();
            else { Ctx.Clear(); navSignature = ""; }
        }

        if (pendingScrollId != null)
        {
            var id = pendingScrollId;
            var fn = pendingScrollFn;
            pendingScrollId = null;
            await JS.InvokeVoidAsync(fn, id);
        }
    }

    private void GenerateSessions()
    {
        if (tournament == null) return;

        if (tournament.IsGenerated)
        {
            showRegenerateConfirm = true;
            return;
        }

        DoGenerate();
    }

    private void ConfirmRegenerate()
    {
        showRegenerateConfirm = false;
        DoGenerate();
    }

    private async void DoGenerate()
    {
        if (tournament == null) return;

        tournament.Sessions = AssignmentService.GenerateAllSessions(
            tournament.Participants, tournament.SessionCount);
        tournament.IsGenerated = true;

        // Assign default start times from settings
        var settings = await SettingsService.GetAsync();
        var defaultTimes = settings.TournamentStartTimes.OrderBy(t => t).ToList();
        for (int i = 0; i < tournament.Sessions.Count; i++)
        {
            tournament.Sessions[i].StartTime = i < defaultTimes.Count
                ? defaultTimes[i]
                : null;
        }

        BuildTournamentMatrix();
        expandedHanchans = new HashSet<int>(tournament.Sessions.Select(s => s.SessionNumber));

        await TournamentService.SaveAsync(tournament);
        saved = true;
        _ = ResetSavedFlag();
        StateHasChanged();
    }

    private async Task OnSessionHourChanged(TournamentSession session, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var h) && h >= 0)
        {
            var currentMinute = session.StartTime?.Minutes ?? 0;
            session.StartTime = new TimeSpan(h, currentMinute, 0);
        }
        else
        {
            session.StartTime = null;
        }
        if (tournament != null)
            await TournamentService.SaveAsync(tournament);
    }

    private async Task OnSessionMinuteChanged(TournamentSession session, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var m) && m >= 0)
        {
            var currentHour = session.StartTime?.Hours ?? 0;
            session.StartTime = new TimeSpan(currentHour, m, 0);
        }
        else
        {
            session.StartTime = null;
        }
        if (tournament != null)
            await TournamentService.SaveAsync(tournament);
    }

    private int CountThreePlayerTables(Guid participantId)
    {
        if (tournament == null) return 0;
        int count = 0;
        foreach (var session in tournament.Sessions)
        {
            foreach (var table in session.Tables)
            {
                if (table.PlayerCount == 3 && table.PlayerIds.Contains(participantId))
                    count++;
            }
        }
        return count;
    }

    private string GetParticipantDisplay(Guid id)
    {
        var p = tournament?.Participants.FirstOrDefault(x => x.Id == id);
        return p != null ? $"{p.Number}. {p.Name}" : Lang.Get("Unknown");
    }

