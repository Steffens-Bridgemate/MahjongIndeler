    private List<ScoresheetHtmlBuilder.ScoresheetTable> BuildScoresheetTables(TournamentSession session, string? hanchanLabel = null)
    {
        return session.Tables.Select(t =>
        {
            var names = t.PlayerIds.Select(id => GetParticipantDisplay(id)).ToList();
            if (t.PlayerCount == 3)
                names.Add(Lang.Get("MrX"));
            // When scanning is on, stamp the table's invite QR onto the scoresheet's side panel.
            // Reuses the cached QrCodeRenderer (same URL as the QR modal → shared cache).
            string? qr = null;
            if (externalScoringEnabled)
            {
                // Payload carries only the compact ShortName (the scoring app rebuilds Hanchan/Table).
                qr = Invites.BuildInviteQrSvg(session.Id, session.SessionNumber, t, GetParticipantDisplay,
                    tournamentStartingPoints, t.PlayerCount == 3 ? uma3Players : uma4Players, tournament!.ShortName, Nav.BaseUri);
            }
            return new ScoresheetHtmlBuilder.ScoresheetTable(t.TableNumber, t.PlayerCount, names, tournamentStartingPoints, hanchanLabel, qr);
        }).ToList();
    }

