    private record AllScoresEntry(string Label, TableAssignment Table);
    private record AllScoresTableGroup(int TableNumber, List<AllScoresEntry> Entries);

    private List<AllScoresTableGroup> BuildAllScoresEntries()
    {
        if (tournament == null) return new();

        var orderedSessions = tournament.Sessions.OrderBy(s => s.SessionNumber).ToList();
        var allTableNumbers = orderedSessions
            .SelectMany(s => s.Tables.Select(t => t.TableNumber))
            .Distinct()
            .OrderBy(n => n)
            .ToList();

        var result = new List<AllScoresTableGroup>();
        foreach (var tableNum in allTableNumbers)
        {
            var entries = new List<AllScoresEntry>();
            foreach (var session in orderedSessions)
            {
                var table = session.Tables.FirstOrDefault(t => t.TableNumber == tableNum);
                if (table == null) continue;
                var timeStr = session.StartTime is { } st ? st.ToString(@"hh\:mm") : "";
                var label = $"{Lang.Get("Hanchan")} #{session.SessionNumber} {timeStr}".Trim();
                entries.Add(new AllScoresEntry(label, table));
            }
            if (entries.Count > 0)
                result.Add(new AllScoresTableGroup(tableNum, entries));
        }
        return result;
    }

