    // shows at a time. The per-hanchan flags hold the session number of the open group (or null).
    private void SetExportAll(bool expanded)
    {
        showExportAll = expanded;
        if (expanded) showExportScoresheetsAll = false;
    }

    private void SetExportScoresheetsAll(bool expanded)
    {
        showExportScoresheetsAll = expanded;
        if (expanded) showExportAll = false;
    }

    private void SetExportSingleHanchan(int sessionNumber, bool expanded)
    {
        exportSingleHanchan = expanded ? sessionNumber : (int?)null;
        if (expanded) exportScoresheetSingleHanchan = null;
    }

    private void SetExportScoresheetSingleHanchan(int sessionNumber, bool expanded)
    {
        exportScoresheetSingleHanchan = expanded ? sessionNumber : (int?)null;
        if (expanded) exportSingleHanchan = null;
    }

    private List<ScoresheetHtmlBuilder.ScoresheetTable> BuildAllScoresheetTables()
    {
        var result = new List<ScoresheetHtmlBuilder.ScoresheetTable>();
        foreach (var session in tournament!.Sessions.OrderBy(s => s.SessionNumber))
        {
            var label = BuildScoresheetSubtitle(session.SessionNumber);
            result.AddRange(BuildScoresheetTables(session, label));
        }
        return result;
    }

    private async Task PrintScoresheetsAll()
    {
        if (tournament == null) return;
        var title = $"{Lang.Get("Scoresheets")} — {tournament.Name}";
        var subtitle = Lang.FormatDate(tournament.Date);
        var doc = ScoresheetHtmlBuilder.BuildDocument(title, subtitle, BuildAllScoresheetTables(), Lang.Get, includePrintButton: true);
        await JS.InvokeVoidAsync("openHtmlInNewTab", doc);
    }

    private async Task DownloadScoresheetsAll()
    {
        if (tournament == null) return;
        var title = $"{Lang.Get("Scoresheets")} — {tournament.Name}";
        var subtitle = Lang.FormatDate(tournament.Date);
        var doc = ScoresheetHtmlBuilder.BuildDocument(title, subtitle, BuildAllScoresheetTables(), Lang.Get);
        var filename = $"scoresheets_{tournament.Name.Replace(" ", "_")}_{tournament.Date:yyyy-MM-dd}.html";
        await JS.InvokeVoidAsync("downloadHtmlFile", filename, doc);
    }

