    private static string? StatusDotClass(ScoreStatusHelper.Status s) => s switch
    {
        ScoreStatusHelper.Status.Complete => "bg-success",
        ScoreStatusHelper.Status.Partial => "bg-warning",
        ScoreStatusHelper.Status.Stale => "bg-danger",
        _ => null,
    };

    private Func<Task>? ScoresExplain(ScoreStatusHelper.Status s)
        => s is ScoreStatusHelper.Status.Partial or ScoreStatusHelper.Status.Stale
            ? () => { ShowStatusExplanation(s, isAggregated: true); StateHasChanged(); return Task.CompletedTask; }
            : null;

    // Builds the tournament's contextual sidebar: back-to-tournaments + Participants, the three
    // view selectors (Assignments / Scores per Hanchan / Scores per Table) each followed — when it
    // is the active view — by an indented jump list (its hanchans, or its table numbers), then
    // Guidesheets + Rankings. Replaces the former in-page tab strip + per-hanchan TableNavStrips.
    private List<ContextNavEntry> BuildTournamentNav()
    {
        var entries = new List<ContextNavEntry>();
        if (tournament == null) return entries;

        // Top-level "back" out of the tournament: home icon + generic "Back" label (target stays
        // the Tournaments list).
        entries.Add(new ContextNavEntry
        {
            Label = Lang.Get("Back"),
            IconClass = "bi-house-door-fill-nav-menu",
            Href = "tournaments",
        });
        entries.Add(new ContextNavEntry
        {
            Label = Lang.Get("TournamentParticipants"),
            IconClass = "bi-people-fill-nav-menu",
            Href = $"tournament/{Id}/participants",
        });

        var ordered = tournament.Sessions.OrderBy(s => s.SessionNumber).ToList();

        // Assignments + per-hanchan jump list (green dot = all tables scanned, when scanning is on).
        entries.Add(new ContextNavEntry
        {
            Label = Lang.Get("Assignments"),
            IconClass = "bi-table-nav-menu",
            IsActive = tournamentActiveTab == "tables",
            OnSelect = () => { SelectTab("tables"); return Task.CompletedTask; },
        });
        if (tournamentActiveTab == "tables")
        {
            foreach (var s in ordered)
            {
                var sn = s.SessionNumber;
                entries.Add(new ContextNavEntry
                {
                    Indent = 1,
                    Label = $"{Lang.Get("Hanchan")} {sn}",
                    StatusClass = externalScoringEnabled && AllTablesScannedIn(s) ? "bg-success" : null,
                    OnSelect = () => { JumpToHanchan(sn, "tables"); return Task.CompletedTask; },
                });
            }
        }

        var aggStatus = AllSessionsScoreStatus();

        // Scores per Hanchan + per-hanchan jump list (per-hanchan status dots).
        entries.Add(new ContextNavEntry
        {
            Label = Lang.Get("ScoresPerHanchan"),
            IconClass = "bi-card-list-nav-menu",
            IsActive = tournamentActiveTab == "scores",
            OnSelect = () => { SelectTab("scores"); return Task.CompletedTask; },
            OnExplain = ScoresExplain(aggStatus),
        });
        if (tournamentActiveTab == "scores")
        {
            for (int i = 0; i < ordered.Count; i++)
            {
                var s = ordered[i];
                var sn = s.SessionNumber;
                var status = ScoreStatusHelper.Classify(s.Tables, ordered.Skip(i + 1).Select(o => o.Tables));
                entries.Add(new ContextNavEntry
                {
                    Indent = 1,
                    Label = $"{Lang.Get("Hanchan")} {sn}",
                    StatusClass = StatusDotClass(status),
                    OnSelect = () => { JumpToHanchan(sn, "scores"); return Task.CompletedTask; },
                });
            }
        }

        // Scores per Table + per-table-number jump list (dot = all hanchans' instance complete).
        entries.Add(new ContextNavEntry
        {
            Label = Lang.Get("ScoresPerTable"),
            IconClass = "bi-grid-3x3-gap-nav-menu",
            IsActive = tournamentActiveTab == "allscores",
            OnSelect = () => { SelectTab("allscores"); return Task.CompletedTask; },
            OnExplain = ScoresExplain(aggStatus),
        });
        if (tournamentActiveTab == "allscores")
        {
            foreach (var group in BuildAllScoresEntries())
            {
                var tn = group.TableNumber;
                var allComplete = group.Entries.All(e => ScoreStatusHelper.TableIsComplete(e.Table));
                var anyScore = group.Entries.Any(e => ScoreStatusHelper.TablesHaveAnyScore(new List<TableAssignment> { e.Table }));
                var st = allComplete ? ScoreStatusHelper.Status.Complete
                    : anyScore ? ScoreStatusHelper.Status.Partial
                    : ScoreStatusHelper.Status.Normal;
                entries.Add(new ContextNavEntry
                {
                    Indent = 1,
                    Label = $"{Lang.Get("Table")} {tn}",
                    StatusClass = StatusDotClass(st),
                    OnSelect = () => { JumpToTable(tn); return Task.CompletedTask; },
                });
            }
        }

        // Auxiliary info cards at the bottom of the page (not views — they expand + scroll).
        entries.Add(new ContextNavEntry
        {
            Label = Lang.Get("ThreePlayerDistribution"),
            IconClass = "bi-person-lines-fill-nav-menu",
            OnSelect = () => { JumpToDistribution(); return Task.CompletedTask; },
        });
        entries.Add(new ContextNavEntry
        {
            Label = Lang.Get("MeetingMatrixTitle"),
            IconClass = "bi-diagram-3-fill-nav-menu",
            OnSelect = () => { JumpToMatrix(); return Task.CompletedTask; },
        });

        entries.Add(new ContextNavEntry
        {
            Label = Lang.Get("TournamentGuidesheets"),
            IconClass = "bi-card-checklist-nav-menu",
            Href = $"tournament/{Id}/guidesheets",
        });
        entries.Add(new ContextNavEntry
        {
            Label = Lang.Get("Rankings"),
            IconClass = "bi-bar-chart-fill-nav-menu",
            Href = $"tournament/{Id}/rankings",
        });

        return entries;
    }

    // Publish to the sidebar only when the visible signature changes, so frequent re-renders don't
    // churn the nav (mirrors WeeklySessionPage.PublishNav).
    private string navSignature = "";
    private void PublishNav()
    {
        var entries = BuildTournamentNav();
        var sig = string.Join("|", entries.Select(e =>
            $"{e.Label}/{e.Indent}/{e.IsActive}/{e.StatusClass}/{e.Disabled}/{e.Href}/{e.OnExplain != null}"));
        if (sig == navSignature) return;
        navSignature = sig;
        Ctx.Set(entries);
    }

