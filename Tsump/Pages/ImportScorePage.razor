@page "/import-score"
@using Tsump.Models
@using Tsump.Services
@using Tsump.Scoring
@inject NavigationManager Nav
@inject LanguageService Lang
@inject MemberService MemberService
@inject ScoreImportService ScoreImport
@implements IDisposable

<PageTitle>@Lang.Get("ImportScoreTitle") - Tsumo!</PageTitle>

<h1><i class="bi bi-box-arrow-in-down me-2"></i>@Lang.Get("ImportScoreTitle")</h1>

@if (decodeError)
{
    <div class="alert alert-danger">
        <strong>@Lang.Get("ScoringInvalidLink")</strong>
        <div class="small mt-1">@Lang.Get("ScoringInvalidLinkHint")</div>
    </div>
}
else if (lookupError)
{
    <div class="alert alert-warning">
        <strong>@Lang.Get("ImportScoreNoMatch")</strong>
    </div>
    <a href="session" class="btn btn-secondary">&larr; @Lang.Get("BackToSession")</a>
}
else if (result == null || lookup == null)
{
    <p>@Lang.Get("Loading")</p>
}
else if (applied)
{
    <div class="alert alert-success">@Lang.Get("ImportScoreApplied")</div>
    <a href="session" class="btn btn-primary">&larr; @Lang.Get("BackToSession")</a>
}
else
{
    <h5 class="text-muted mb-2">
        @Lang.FormatDate(lookup.Hanchan.Date)
        @if (lookup.Hanchan.StartTime.HasValue)
        {
            <span> &middot; @lookup.Hanchan.StartTime.Value.ToString(@"hh\:mm")</span>
        }
        &middot; @Lang.Get("Table") @lookup.Table.TableNumber
    </h5>

    <p>@Lang.Get("ImportScoreConfirm")</p>

    @if (alreadyScoredWarning)
    {
        <div class="alert alert-warning">@Lang.Get("ImportScoreOverwriteWarning")</div>
    }

    <table class="table table-sm table-bordered" style="max-width:500px;">
        <thead>
            <tr>
                <th>@Lang.Get("Player")</th>
                <th class="text-end">@Lang.Get("EndShort")</th>
                <th class="text-end">@Lang.Get("LoanShort")</th>
                <th class="text-end">@Lang.Get("PenaltyShort")</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in result.Scores)
            {
                <tr>
                    <td>@ResolveName(s.PlayerId)</td>
                    <td class="text-end">@FormatPoints(s.EndPoints)</td>
                    <td class="text-end">@(s.Loan != 0 ? FormatPoints(s.Loan) : "")</td>
                    <td class="text-end">@(s.Penalty != 0 ? FormatPoints(s.Penalty) : "")</td>
                </tr>
            }
        </tbody>
    </table>

    <button class="btn btn-success" @onclick="Apply">
        <i class="bi bi-check2 me-1"></i>@Lang.Get("ImportScoreApply")
    </button>
}

@code {
    private ScoringResult? result;
    private ScoreImportService.Lookup? lookup;
    private List<Member> members = new();
    private bool decodeError;
    private bool lookupError;
    private bool alreadyScoredWarning;
    private bool applied;

    protected override void OnInitialized() => Lang.OnLanguageChanged += StateHasChanged;
    public void Dispose() => Lang.OnLanguageChanged -= StateHasChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        DecodeFragment();
        if (decodeError || result == null)
        {
            StateHasChanged();
            return;
        }

        members = await MemberService.GetAllAsync();
        lookup = await ScoreImport.FindAsync(result);
        if (lookup == null)
        {
            lookupError = true;
        }
        else if (lookup.Table.Score != null
                 && lookup.Table.Score.PlayerScores.Any(p => !p.IsVirtual && p.EndPoints.HasValue))
        {
            alreadyScoredWarning = true;
        }

        StateHasChanged();
    }

    private void DecodeFragment()
    {
        var uri = new Uri(Nav.Uri);
        var fragment = uri.Fragment.TrimStart('#');
        if (string.IsNullOrEmpty(fragment))
        {
            decodeError = true;
            return;
        }
        var prefix = "r=";
        var payload = fragment.StartsWith(prefix, StringComparison.Ordinal) ? fragment.Substring(prefix.Length) : fragment;
        result = ScoringPayloadCodec.DecodeResult(payload);
        if (result == null || result.Scores == null || result.Scores.Count < 3 || result.Scores.Count > 4)
            decodeError = true;
    }

    private string ResolveName(Guid id)
        => members.FirstOrDefault(m => m.Id == id)?.Name ?? id.ToString();

    private static string FormatPoints(int value) => (value / 1000.0).ToString("+0.0;-0.0;0.0");

    private async Task Apply()
    {
        if (result == null || lookup == null) return;

        var outcome = await ScoreImport.ApplyAsync(result, Lang.Get, confirmOverwrite: true);
        if (outcome.Success)
        {
            applied = true;
            StateHasChanged();
        }
    }
}
