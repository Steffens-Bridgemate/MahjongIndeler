@page "/tournament/{Id:guid}/participants"
@using Tsump.Models
@using Tsump.Services
@inject TournamentService TournamentService
@inject LanguageService Lang
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject SettingsService SettingsService
@implements IDisposable

<PageTitle>@Lang.Get("TournamentParticipants") - Tsumo!</PageTitle>

<div class="mb-3">
    <button class="btn btn-outline-secondary btn-sm" @onclick="GoToList">
        &larr; @Lang.Get("BackToTournaments")
    </button>
</div>

@if (tournament == null)
{
    <p>@Lang.Get("Loading")</p>
}
else
{
    <h1>@tournament.Name</h1>
    <p class="text-muted">@Lang.FormatDate(tournament.Date) &middot; @tournament.SessionCount @Lang.Get("HanchansCount")</p>

    @* --- Sub-navigation --- *@
    <ul class="nav nav-tabs mb-4">
        <li class="nav-item">
            <a class="nav-link active" href="tournament/@Id/participants">@Lang.Get("TournamentParticipants")</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="tournament/@Id">@Lang.Get("TournamentAssignments")</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(tournament.IsGenerated ? "" : "disabled")" href="@(tournament.IsGenerated ? $"tournament/{Id}/guidesheets" : "#")">@Lang.Get("TournamentGuidesheets")</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(tournament.IsGenerated ? "" : "disabled")" href="@(tournament.IsGenerated ? $"tournament/{Id}/rankings" : "#")">@Lang.Get("Rankings")</a>
        </li>
    </ul>

    @* --- CSV import/export --- *@
    <div class="d-flex align-items-center gap-2 mb-2 flex-wrap justify-content-end">
        <button class="btn btn-outline-secondary btn-sm" @onclick="TriggerCsvImport">
            @Lang.Get("ImportCsv")
        </button>
        <InputFile id="csvImportInput" style="display:none" accept=".csv,text/csv" OnChange="OnCsvFileSelected" />
        @if (tournament.Participants.Count > 0)
        {
            <button class="btn btn-outline-secondary btn-sm" @onclick="ExportCsv">
                @Lang.Get("ExportCsv")
            </button>
        }
    </div>

    @* --- Generate / Edit buttons --- *@
    <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
        <label class="form-label mb-0">@Lang.Get("GeneratePlayers")</label>
        <input type="number" class="form-control" style="max-width: 80px;" min="13"
               @bind="generatePlayerCount" />
        <button class="btn btn-outline-primary btn-sm" @onclick="GeneratePlayers"
                disabled="@(generatePlayerCount < 13)">
            @Lang.Get("Generate")
        </button>
        @if (generatePlayerCount < 13)
        {
            <small class="text-warning">@Lang.Get("NeedAtLeast13")</small>
        }

        @if (tournament.Participants.Count > 0)
        {
            <button class="btn btn-outline-secondary btn-sm ms-auto" @onclick="RequestRandomize">
                @Lang.Get("RandomizeNumbers")
            </button>
            <button class="btn btn-sm @(editingNames ? "btn-success" : "btn-outline-secondary")"
                    @onclick="ToggleEditNames">
                @(editingNames ? Lang.Get("Save") : Lang.Get("EditNames"))
            </button>
        }
    </div>

    @if (showRandomizeConfirm)
    {
        <div class="alert alert-warning py-2 mb-2">
            @Lang.Get("ConfirmRandomize")
            <button class="btn btn-sm btn-warning ms-2" @onclick="ConfirmRandomize">@Lang.Get("YesContinue")</button>
            <button class="btn btn-sm btn-secondary ms-1" @onclick="() => showRandomizeConfirm = false">@Lang.Get("Cancel")</button>
        </div>
    }

    @if (showResetWarning)
    {
        <div class="alert alert-warning py-2 mb-2">
            @Lang.Get("ChangeParticipantsWarning")
            <button class="btn btn-sm btn-warning ms-2" @onclick="ConfirmReset">@Lang.Get("YesContinue")</button>
            <button class="btn btn-sm btn-secondary ms-1" @onclick="() => showResetWarning = false">@Lang.Get("Cancel")</button>
        </div>
    }

    @if (showGenerateConfirm)
    {
        <div class="alert alert-warning py-2 mb-2">
            @Lang.Get("ConfirmGenerateParticipants")
            <button class="btn btn-sm btn-warning ms-2" @onclick="GeneratePlayers">@Lang.Get("YesContinue")</button>
            <button class="btn btn-sm btn-secondary ms-1" @onclick="() => showGenerateConfirm = false">@Lang.Get("Cancel")</button>
        </div>
    }

    @if (csvImportError != null)
    {
        <div class="alert alert-danger py-1 mb-2">@csvImportError</div>
    }

    @* --- Participants table --- *@
    <table class="table table-sm">
        <thead>
            <tr>
                <th style="width: 50px;">@Lang.Get("ParticipantNumber")</th>
                <th style="min-width: 14em;">@Lang.Get("ParticipantName")</th>
                <th>@Lang.Get("LeagueId")</th>
                <th style="width: 40px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in tournament.Participants.OrderBy(x => x.Number))
            {
                var participant = p;
                <tr @key="participant.Id">
                    <td>@participant.Number</td>
                    <td>
                        @if (editingNames)
                        {
                            <input id="participant-name-@participant.Number"
                                   class="form-control form-control-sm"
                                   value="@participant.Name"
                                   @oninput="e => OnEditParticipantName(participant, e)"
                                   @onkeydown="e => OnEditParticipantKeyDown(participant, e)"
                                   @onkeydown:preventDefault="@false"
                                   placeholder="@Lang.Get("ParticipantName")" />
                        }
                        else
                        {
                            @participant.Name
                        }
                    </td>
                    <td>
                        @if (editingNames)
                        {
                            <input class="form-control form-control-sm"
                                   value="@participant.LeagueId"
                                   @oninput="e => participant.LeagueId = e.Value?.ToString() ?? string.Empty"
                                   @onkeydown="e => OnEditParticipantKeyDown(participant, e)"
                                   @onkeydown:preventDefault="@false"
                                   placeholder="@Lang.Get("LeagueId")" />
                        }
                        else
                        {
                            @participant.LeagueId
                        }
                    </td>
                    <td>
                        <button class="btn btn-sm text-danger p-0" style="font-size: 1.5em; line-height: 1;" title="@Lang.Get("Remove")" tabindex="-1" @onclick="() => RemoveParticipant(participant.Id)">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @* --- Add participant --- *@
    <div class="d-flex align-items-center gap-2 mt-2">
        <input class="form-control" style="max-width: 250px;" placeholder="@Lang.Get("ParticipantName")"
               value="@newParticipantName" @oninput="OnParticipantNameInput" @onkeydown="OnParticipantKeyDown" />
        <button class="btn btn-success btn-sm" @onclick="AddParticipant"
                disabled="@(string.IsNullOrWhiteSpace(newParticipantName))">
            @Lang.Get("AddParticipant")
        </button>
    </div>

    @* --- Scoring overrides --- *@
    <div class="card mt-4">
        <div class="card-header d-flex align-items-center" style="cursor:pointer;" @onclick="() => scoringExpanded = !scoringExpanded">
            <h5 class="mb-0 flex-grow-1">@Lang.Get("ScoringOverrides")</h5>
            <span class="ms-2">@(scoringExpanded ? "\u25B2" : "\u25BC")</span>
        </div>
        @if (scoringExpanded)
        {
            <div class="card-body">
                <p class="text-muted">@Lang.Get("ScoringOverridesDesc")</p>
                <div class="row mb-2">
                    <div class="col-md-4 mb-2">
                        <label class="form-label">@Lang.Get("StartingPoints")</label>
                        <input type="text" inputmode="decimal" class="form-control" style="max-width:120px;"
                               value="@FormatPoints(tournament.StartingPoints ?? clubTournamentStartingPoints)"
                               @onchange="e => OnOverrideStartingPoints(e)" />
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-6 mb-2">
                        <label class="form-label">@Lang.Get("Uma4Players")</label>
                        <div class="d-flex gap-1">
                            @{ var u4 = tournament.Uma4Players ?? clubUma4Players; }
                            @for (int idx = 0; idx < u4.Count; idx++)
                            {
                                var i = idx;
                                <input type="text" inputmode="decimal" class="form-control form-control-sm text-center" style="max-width:80px;"
                                       value="@FormatPointsSigned(u4[i])"
                                       @onchange="e => OnOverrideUma4(i, e)" />
                            }
                        </div>
                    </div>
                    <div class="col-md-6 mb-2">
                        <label class="form-label">@Lang.Get("Uma3Players")</label>
                        <div class="d-flex gap-1">
                            @{ var u3 = tournament.Uma3Players ?? clubUma3Players; }
                            @for (int idx = 0; idx < u3.Count; idx++)
                            {
                                var i = idx;
                                <input type="text" inputmode="decimal" class="form-control form-control-sm text-center" style="max-width:80px;"
                                       value="@FormatPointsSigned(u3[i])"
                                       @onchange="e => OnOverrideUma3(i, e)" />
                            }
                        </div>
                    </div>
                </div>
                <button class="btn btn-sm btn-outline-secondary" @onclick="ResetScoringOverrides">@Lang.Get("UseDefaults")</button>
            </div>
        }
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private Tournament? tournament;
    private string newParticipantName = string.Empty;
    private int generatePlayerCount = 20;
    private bool scoringExpanded;
    private int clubTournamentStartingPoints = 30000;
    private List<int> clubUma4Players = new() { 15000, 5000, -5000, -15000 };
    private List<int> clubUma3Players = new() { 12500, 0, -12500 };
    private bool editingNames;
    private string? csvImportError;
    private bool userLoweredFirst;
    private bool resetConfirmed;
    private bool showResetWarning;
    private bool showRandomizeConfirm;
    private bool showGenerateConfirm;
    private Func<Task>? pendingAction;

    protected override void OnInitialized() => Lang.OnLanguageChanged += StateHasChanged;
    public void Dispose() => Lang.OnLanguageChanged -= StateHasChanged;

    private void GoToList() => Nav.NavigateTo("tournaments");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            tournament = await TournamentService.GetByIdAsync(Id);
            if (tournament != null && tournament.Participants.Count >= 13)
                generatePlayerCount = tournament.Participants.Count;
            var settings = await SettingsService.GetAsync();
            clubTournamentStartingPoints = settings.TournamentStartingPoints;
            clubUma4Players = new List<int>(settings.TournamentUma4Players);
            clubUma3Players = new List<int>(settings.TournamentUma3Players);
            StateHasChanged();
        }
    }

    private void OnParticipantNameInput(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? "";

        if (value.Length == 1 && !userLoweredFirst)
        {
            value = value.ToUpper();
        }
        else if (value.Length >= 1 && char.IsLower(value[0]))
        {
            userLoweredFirst = true;
        }
        else if (value.Length >= 1 && char.IsUpper(value[0]))
        {
            userLoweredFirst = false;
        }

        newParticipantName = value;
    }

    private async Task OnParticipantKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(newParticipantName))
            await AddParticipant();
    }

    private async Task AddParticipant()
    {
        if (tournament == null || string.IsNullOrWhiteSpace(newParticipantName))
            return;

        if (NeedsResetConfirmation())
        {
            pendingAction = AddParticipant;
            showResetWarning = true;
            return;
        }

        var nextNumber = tournament.Participants.Count > 0
            ? tournament.Participants.Max(p => p.Number) + 1
            : 1;

        tournament.Participants.Add(new TournamentParticipant
        {
            Name = newParticipantName.Trim(),
            Number = nextNumber
        });

        ResetAssignments();
        await TournamentService.SaveAsync(tournament);
        newParticipantName = string.Empty;
        userLoweredFirst = false;
    }

    private async Task GeneratePlayers()
    {
        if (tournament == null || generatePlayerCount < 13) return;

        if (NeedsResetConfirmation())
        {
            pendingAction = GeneratePlayers;
            showResetWarning = true;
            return;
        }

        if (tournament.Participants.Count > 0 && !showGenerateConfirm)
        {
            showGenerateConfirm = true;
            return;
        }
        showGenerateConfirm = false;

        tournament.Participants.Clear();
        for (int i = 1; i <= generatePlayerCount; i++)
        {
            tournament.Participants.Add(new TournamentParticipant
            {
                Name = string.Empty,
                Number = i
            });
        }

        editingNames = true;
        ResetAssignments();
        await TournamentService.SaveAsync(tournament);
    }

    private async Task ExportCsv()
    {
        if (tournament == null || tournament.Participants.Count == 0) return;

        var sb = new System.Text.StringBuilder();
        foreach (var p in tournament.Participants.OrderBy(x => x.Number))
        {
            sb.AppendLine($"{p.Number};{p.Name};{p.LeagueId}");
        }

        var bytes = System.Text.Encoding.UTF8.GetBytes(sb.ToString());
        var base64 = Convert.ToBase64String(bytes);
        var filename = $"{tournament.Name}_participants.csv";
        await JS.InvokeVoidAsync("downloadFile", filename, base64);
    }

    private async Task TriggerCsvImport()
    {
        if (NeedsResetConfirmation())
        {
            pendingAction = TriggerCsvImport;
            showResetWarning = true;
            return;
        }
        csvImportError = null;
        await JS.InvokeVoidAsync("triggerFileInput", "csvImportInput");
    }

    private async Task OnCsvFileSelected(InputFileChangeEventArgs e)
    {
        csvImportError = null;
        if (tournament == null) return;

        try
        {
            using var stream = e.File.OpenReadStream(maxAllowedSize: 1024 * 1024);
            using var reader = new System.IO.StreamReader(stream);
            var content = await reader.ReadToEndAsync();

            var lines = content.Split('\n', StringSplitOptions.RemoveEmptyEntries);
            var participants = new List<TournamentParticipant>();

            foreach (var rawLine in lines)
            {
                var line = rawLine.Trim();
                if (string.IsNullOrEmpty(line)) continue;

                var separator = line.Contains(';') ? ';' : ',';
                var parts = line.Split(separator);

                if (parts.Length < 1) continue;

                if (!int.TryParse(parts[0].Trim(), out var number))
                    continue;

                var name = parts.Length > 1 ? parts[1].Trim() : string.Empty;
                var leagueId = parts.Length > 2 ? parts[2].Trim() : string.Empty;

                participants.Add(new TournamentParticipant
                {
                    Number = number,
                    Name = name,
                    LeagueId = leagueId
                });
            }

            if (participants.Count == 0)
            {
                csvImportError = Lang.Get("InvalidFileFormat");
                return;
            }

            tournament.Participants = participants;
            if (participants.Count >= 13)
                generatePlayerCount = participants.Count;
            ResetAssignments();
            await TournamentService.SaveAsync(tournament);
        }
        catch
        {
            csvImportError = Lang.Get("InvalidFileFormat");
        }
    }

    private async Task ToggleEditNames()
    {
        if (editingNames && tournament != null)
            await TournamentService.SaveAsync(tournament);
        editingNames = !editingNames;
    }

    private void OnEditParticipantName(TournamentParticipant participant, ChangeEventArgs e)
    {
        participant.Name = e.Value?.ToString() ?? "";
    }

    private async Task OnEditParticipantKeyDown(TournamentParticipant participant, KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && tournament != null)
        {
            await TournamentService.SaveAsync(tournament);

            var sorted = tournament.Participants.OrderBy(p => p.Number).ToList();
            var currentIndex = sorted.FindIndex(p => p.Id == participant.Id);

            TournamentParticipant? next = null;
            for (int i = 1; i < sorted.Count; i++)
            {
                var candidate = sorted[(currentIndex + i) % sorted.Count];
                if (string.IsNullOrWhiteSpace(candidate.Name))
                {
                    next = candidate;
                    break;
                }
            }

            if (next != null)
                await JS.InvokeVoidAsync("focusElement", $"participant-name-{next.Number}");
        }
    }

    private async Task RemoveParticipant(Guid participantId)
    {
        if (tournament == null) return;

        if (NeedsResetConfirmation())
        {
            pendingAction = () => RemoveParticipant(participantId);
            showResetWarning = true;
            return;
        }

        tournament.Participants.RemoveAll(p => p.Id == participantId);

        var sorted = tournament.Participants.OrderBy(p => p.Number).ToList();
        for (int i = 0; i < sorted.Count; i++)
            sorted[i].Number = i + 1;

        ResetAssignments();
        await TournamentService.SaveAsync(tournament);
    }

    private bool NeedsResetConfirmation()
    {
        return tournament != null && tournament.IsGenerated && !resetConfirmed;
    }

    private void ConfirmReset()
    {
        resetConfirmed = true;
        showResetWarning = false;
        if (pendingAction != null)
        {
            var action = pendingAction;
            pendingAction = null;
            _ = action();
        }
    }

    private void RequestRandomize()
    {
        showRandomizeConfirm = true;
    }

    private async Task ConfirmRandomize()
    {
        showRandomizeConfirm = false;
        if (tournament == null || tournament.Participants.Count == 0) return;

        if (NeedsResetConfirmation())
        {
            pendingAction = ConfirmRandomize;
            showResetWarning = true;
            return;
        }

        var rng = new Random();
        var numbers = Enumerable.Range(1, tournament.Participants.Count).OrderBy(_ => rng.Next()).ToList();
        for (int i = 0; i < tournament.Participants.Count; i++)
            tournament.Participants[i].Number = numbers[i];

        ResetAssignments();
        await TournamentService.SaveAsync(tournament);
    }

    private void ResetAssignments()
    {
        if (tournament == null) return;
        tournament.Sessions.Clear();
        tournament.IsGenerated = false;
        resetConfirmed = false;
    }

    private static string FormatPoints(int value) => (value / 1000.0).ToString("0.0");
    private static string FormatPointsSigned(int value) => (value / 1000.0).ToString("+0.0;-0.0;0.0");
    private static int ParsePoints(string? input, int fallback)
    {
        if (string.IsNullOrWhiteSpace(input)) return fallback;
        var normalized = input.Replace(',', '.');
        if (decimal.TryParse(normalized, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var d))
            return (int)Math.Round(d * 1000);
        return fallback;
    }

    private async Task OnOverrideStartingPoints(ChangeEventArgs e)
    {
        if (tournament == null) return;
        tournament.StartingPoints = ParsePoints(e.Value?.ToString(), clubTournamentStartingPoints);
        await TournamentService.SaveAsync(tournament);
    }

    private async Task OnOverrideUma4(int index, ChangeEventArgs e)
    {
        if (tournament == null) return;
        tournament.Uma4Players ??= new List<int>(clubUma4Players);
        tournament.Uma4Players[index] = ParsePoints(e.Value?.ToString(), 0);
        await TournamentService.SaveAsync(tournament);
    }

    private async Task OnOverrideUma3(int index, ChangeEventArgs e)
    {
        if (tournament == null) return;
        tournament.Uma3Players ??= new List<int>(clubUma3Players);
        tournament.Uma3Players[index] = ParsePoints(e.Value?.ToString(), 0);
        await TournamentService.SaveAsync(tournament);
    }

    private async Task ResetScoringOverrides()
    {
        if (tournament == null) return;
        tournament.StartingPoints = null;
        tournament.Uma4Players = null;
        tournament.Uma3Players = null;
        await TournamentService.SaveAsync(tournament);
    }
}
