@page "/tournament/{Id:guid}/rankings"
@using Tsump.Models
@using Tsump.Services
@inject TournamentService TournamentService
@inject SettingsService SettingsService
@inject LanguageService Lang
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject TournamentNavContext TournamentNav
@implements IDisposable

<PageTitle>@Lang.Get("Rankings") - Tsumo!</PageTitle>

@if (tournament == null)
{
    <p>@Lang.Get("Loading")</p>
}
else
{
    <h1><i class="bi bi-bar-chart-fill me-2"></i>@tournament.Name</h1>
    <p class="text-muted">@Lang.FormatDate(tournament.Date) &middot; @tournament.SessionCount @Lang.Get("HanchansCount")</p>

    <div class="d-flex align-items-center mb-2 flex-wrap gap-1">
        <ExportButtonGroup TriggerLabel="@Lang.Get("ExportRankings")" TriggerIcon="bi-list-ol" Small="true"
                           TriggerClass="btn-outline-secondary"
                           @bind-Expanded="showExportRankings"
                           OnCopy="CopyRankingsToClipboard" Copied="copiedRankingsToClipboard"
                           OnPrint="OpenRankings" OnDownload="DownloadRankings" />
    </div>

    <RankingTable Entries="BuildTournamentRankings()" />
}

@code {
    [Parameter] public Guid Id { get; set; }

    private Tournament? tournament;
    private bool showExportRankings;
    private bool copiedRankingsToClipboard;

    protected override void OnInitialized() => Lang.OnLanguageChanged += StateHasChanged;
    public void Dispose() => Lang.OnLanguageChanged -= StateHasChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            tournament = await TournamentService.GetByIdAsync(Id);
            StateHasChanged();
        }
        if (tournament != null) TournamentNav.Set(Id, tournament.IsGenerated);
    }

    private string GetParticipantDisplay(Guid id)
    {
        var p = tournament?.Participants.FirstOrDefault(x => x.Id == id);
        return p != null ? $"{p.Number}. {p.Name}" : Lang.Get("Unknown");
    }

    private List<RankingTable.RankingEntry> BuildTournamentRankings()
    {
        if (tournament == null) return new();

        var hanchans = tournament.Sessions
            .Where(s => s.Tables.Any(t => t.Score != null))
            .OrderBy(s => s.SessionNumber)
            .Select(s => (Label: $"{Lang.Get("Hanchan")} {s.SessionNumber}", Tables: s.Tables))
            .ToList();

        var allParticipantIds = tournament.Participants.Select(p => p.Id).ToHashSet();
        return RankingTable.BuildRankings(hanchans, GetParticipantDisplay, allParticipantIds);
    }

    private (string html, string text) BuildRankingsContent()
    {
        var title = $"{Lang.Get("Rankings")} — {tournament?.Name}";
        return RankingTable.BuildExportContent(BuildTournamentRankings(), title, Lang);
    }

    private async Task CopyRankingsToClipboard()
    {
        var (html, text) = BuildRankingsContent();
        await JS.InvokeVoidAsync("copyToClipboard", html, text);
        copiedRankingsToClipboard = true;
        _ = ResetCopiedRankingsFlag();
    }

    private async Task OpenRankings()
    {
        var (html, _) = BuildRankingsContent();
        var title = $"{Lang.Get("Rankings")} — {tournament?.Name}";
        await JS.InvokeVoidAsync("openHtmlInNewTab", RankingTable.WrapAsHtmlDocument(title, html, includePrintButton: true));
    }

    private async Task DownloadRankings()
    {
        var (html, _) = BuildRankingsContent();
        var title = $"{Lang.Get("Rankings")} — {tournament?.Name}";
        var filename = $"rankings_{tournament?.Name}.html";
        await JS.InvokeVoidAsync("downloadHtmlFile", filename, RankingTable.WrapAsHtmlDocument(title, html));
    }

    private async Task ResetCopiedRankingsFlag()
    {
        await Task.Delay(2000);
        copiedRankingsToClipboard = false;
        await InvokeAsync(StateHasChanged);
    }
}
