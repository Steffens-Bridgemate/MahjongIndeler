@page "/members"
@using Tsump.Models
@using Tsump.Services
@inject MemberService MemberService
@inject SessionService SessionService
@inject LanguageService Lang
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>@Lang.Get("Members") - Tsumo!</PageTitle>

<h1>@Lang.Get("ClubMembers")</h1>

<div class="mb-3 d-flex align-items-center gap-2 flex-wrap">
    <button class="btn btn-primary" @onclick="ShowAddForm">@Lang.Get("AddMember")</button>
    <button class="btn btn-outline-secondary btn-sm" @onclick="TriggerCsvImport">
        @Lang.Get("ImportMembersCsv")
    </button>
    <InputFile id="memberCsvImportInput" style="display:none" accept=".csv,text/csv" OnChange="OnCsvFileSelected" />
    @if (members != null && members.Count > 0)
    {
        <button class="btn btn-outline-secondary btn-sm" @onclick="ToggleExportPanel">
            @Lang.Get("ExportMembersCsv")
        </button>
    }
</div>

@if (showExportPanel && members != null && members.Count > 0)
{
    <div class="card mb-4">
        <div class="card-header d-flex align-items-center">
            <h5 class="mb-0 flex-grow-1">@Lang.Get("ExportMembersCsv") (@exportSelectedIds.Count @Lang.Get("selected") @Lang.Get("of") @members.Count)</h5>
        </div>
        <div class="card-body">
            <div class="mb-2">
                <button class="btn btn-sm btn-outline-success me-1" @onclick="ExportSelectAll">@Lang.Get("SelectAllMembers")</button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="ExportSelectNone">@Lang.Get("DeselectAllMembers")</button>
            </div>
            <div class="mb-3">
                <input type="text" class="form-control" placeholder="@Lang.Get("SearchMembers")"
                       style="max-width: 300px; border-radius: 15px;"
                       @bind="exportSearchText" @bind:event="oninput" />
            </div>
            <div class="row">
                @foreach (var member in FilteredExportMembers())
                {
                    <div class="col-md-4 col-sm-6 mb-2">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox"
                                   checked="@exportSelectedIds.Contains(member.Id)"
                                   @onchange="e => ToggleExportMember(member.Id, (bool)(e.Value ?? false))" />
                            <label class="form-check-label">@member.Name</label>
                        </div>
                    </div>
                }
            </div>
            <div class="mt-3">
                <button class="btn btn-success btn-sm" @onclick="ExportCsv"
                        disabled="@(exportSelectedIds.Count == 0)">
                    @Lang.Get("ExportSelected")
                </button>
                <button class="btn btn-secondary btn-sm ms-1" @onclick="() => showExportPanel = false">@Lang.Get("Cancel")</button>
            </div>
        </div>
    </div>
}

@if (csvImportError != null)
{
    <div class="alert alert-danger py-1 mb-2">@csvImportError</div>
}
@if (csvImportSuccess != null)
{
    <div class="alert alert-success py-1 mb-2">@csvImportSuccess</div>
}

@if (showForm)
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">@(isEditing ? Lang.Get("EditMember") : Lang.Get("AddNewMember"))</h5>
            <EditForm Model="currentMember" OnValidSubmit="SaveMember">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label class="form-label">@Lang.Get("Name")</label>
                    <input class="form-control" value="@currentMember.Name" @oninput="OnNameInput" />
                </div>
                <div class="mb-3">
                    <label class="form-label">@Lang.Get("Email")</label>
                    <InputText class="form-control" @bind-Value="currentMember.Email" />
                </div>
                <div class="mb-3">
                    <label class="form-label">@Lang.Get("Phone")</label>
                    <InputText class="form-control" @bind-Value="currentMember.Phone" />
                </div>
                <div class="mb-3">
                    <label class="form-label">@Lang.Get("ExtraThreePlayerTables")</label>
                    <InputNumber class="form-control" style="max-width: 120px;" @bind-Value="currentMember.ExtraThreePlayerTableCount" />
                    <small class="text-muted">@Lang.Get("ExtraThreePlayerTablesDesc")</small>
                </div>
                <div class="mb-3 form-check">
                    <InputCheckbox class="form-check-input" @bind-Value="currentMember.IsActive" />
                    <label class="form-check-label">@Lang.Get("Active")</label>
                </div>
                <button type="submit" class="btn btn-success me-2">@Lang.Get("Save")</button>
                <button type="button" class="btn btn-secondary" @onclick="CancelForm">@Lang.Get("Cancel")</button>
            </EditForm>
        </div>
    </div>
}

@if (members == null)
{
    <p>@Lang.Get("Loading")</p>
}
else if (members.Count == 0)
{
    <p class="text-muted">@Lang.Get("NoMembersYet")</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th style="width: 50px;"></th>
                <th>@Lang.Get("Name")</th>
                <th>@Lang.Get("Email")</th>
                <th>@Lang.Get("Phone")</th>
                <th>@Lang.Get("Joined")</th>
                <th class="text-center" style="cursor:pointer;" @onclick="() => activeSortDescending = !activeSortDescending">
                    @Lang.Get("Active") <span>@(activeSortDescending ? "\u25BC" : "\u25B2")</span>
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var member in (activeSortDescending ? members.OrderByDescending(m => m.IsActive) : members.OrderBy(m => m.IsActive)).ThenBy(m => m.Name))
            {
                <tr>
                    <td>
                        <div class="d-flex align-items-center gap-1 member-actions">
                            <button class="btn btn-sm btn-outline-primary d-flex align-items-center justify-content-center member-action-btn" title="@Lang.Get("Edit")" @onclick="() => EditMember(member)"><i class="bi bi-pencil"></i></button>
                            <button class="btn btn-sm btn-outline-danger d-flex align-items-center justify-content-center @(deleteConfirmId == member.Id ? "member-action-btn-confirm" : "member-action-btn")"
                                    title="@(deleteConfirmId == member.Id ? Lang.Get("ConfirmDeletion") : Lang.Get("Remove"))"
                                    @onclick="() => DeleteClicked(member.Id)"><i class="bi bi-trash"></i></button>
                        </div>
                    </td>
                    <td>@member.Name</td>
                    <td>@member.Email</td>
                    <td>@member.Phone</td>
                    <td>@FormatDate(member.JoinedDate)</td>
                    <td class="text-center">
                        @if (member.IsActive)
                        {
                            <span class="badge bg-success" style="font-size: 1em;">&check;</span>
                        }
                        else
                        {
                            <span class="badge bg-danger" style="font-size: 1em;">&times;</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <p class="text-muted">@Lang.Get("Total"): @members.Count @Lang.Get("members") (@members.Count(m => m.IsActive) @Lang.Get("active"))</p>
}

<style>
    .member-action-btn { width: 20px; height: 20px; }
    .member-action-btn-confirm { width: 26px; height: 26px; }
    .member-actions { flex-direction: column; }
    @@media (min-width: 768px) {
        .member-actions { flex-direction: row; }
    }
</style>

@code {
    private List<Member>? members;
    private Member currentMember = new();
    private bool showForm;
    private bool isEditing;
    private bool userLoweredFirst;
    private Guid? deleteConfirmId;
    private bool activeSortDescending = true;
    private string? csvImportError;
    private string? csvImportSuccess;
    private bool showExportPanel;
    private HashSet<Guid> exportSelectedIds = new();
    private string exportSearchText = string.Empty;

    protected override void OnInitialized() => Lang.OnLanguageChanged += StateHasChanged;
    public void Dispose() => Lang.OnLanguageChanged -= StateHasChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            members = await MemberService.GetAllAsync();
            StateHasChanged();
        }
    }

    private void ShowAddForm()
    {
        currentMember = new Member();
        isEditing = false;
        showForm = true;
        userLoweredFirst = false;
        deleteConfirmId = null;
    }

    private void EditMember(Member member)
    {
        currentMember = new Member
        {
            Id = member.Id,
            Name = member.Name,
            Email = member.Email,
            Phone = member.Phone,
            JoinedDate = member.JoinedDate,
            IsActive = member.IsActive,
            ExtraThreePlayerTableCount = member.ExtraThreePlayerTableCount
        };
        isEditing = true;
        showForm = true;
        userLoweredFirst = member.Name.Length > 0 && char.IsLower(member.Name[0]);
        deleteConfirmId = null;
    }

    private async Task SaveMember()
    {
        if (string.IsNullOrWhiteSpace(currentMember.Name))
            return;

        if (isEditing)
            await MemberService.UpdateAsync(currentMember);
        else
            await MemberService.AddAsync(currentMember);

        members = await MemberService.GetAllAsync();
        showForm = false;
        deleteConfirmId = null;
    }

    private void OnNameInput(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? "";

        if (value.Length == 1 && !userLoweredFirst)
        {
            // Auto-capitalize the first letter on initial typing
            value = value.ToUpper();
        }
        else if (value.Length >= 1 && char.IsLower(value[0]))
        {
            // User explicitly typed or changed first char to lowercase
            userLoweredFirst = true;
        }
        else if (value.Length >= 1 && char.IsUpper(value[0]))
        {
            userLoweredFirst = false;
        }

        currentMember.Name = value;
    }

    private void CancelForm()
    {
        showForm = false;
        deleteConfirmId = null;
    }

    private async Task DeleteClicked(Guid id)
    {
        if (deleteConfirmId == id)
        {
            // Check if member participates in any past sessions
            var allSessions = await SessionService.GetAllAsync();
            var hasHistory = allSessions.Any(s => s.PresentMemberIds.Contains(id));

            if (hasHistory)
            {
                // Deactivate instead of deleting
                var member = members!.FirstOrDefault(m => m.Id == id);
                if (member != null)
                {
                    member.IsActive = false;
                    await MemberService.UpdateAsync(member);
                }
            }
            else
            {
                await MemberService.DeleteAsync(id);
            }

            members = await MemberService.GetAllAsync();
            deleteConfirmId = null;
        }
        else
        {
            deleteConfirmId = id;
        }
    }

    private static readonly string[] DutchMonths = { "jan", "feb", "mrt", "apr", "mei", "jun", "jul", "aug", "sep", "okt", "nov", "dec" };
    private static readonly string[] EnglishMonths = { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };

    private string FormatDate(DateTime date)
    {
        var month = Lang.IsDutch ? DutchMonths[date.Month - 1] : EnglishMonths[date.Month - 1];
        var yy = date.ToString("yy");
        return Lang.IsDutch
            ? $"{date.Day:D2}-{month}-{yy}"
            : $"{month} {date.Day:D2}, {yy}";
    }

    private void ToggleExportPanel()
    {
        showExportPanel = !showExportPanel;
        if (showExportPanel && members != null)
        {
            exportSelectedIds = members.Where(m => m.IsActive).Select(m => m.Id).ToHashSet();
            exportSearchText = string.Empty;
        }
    }

    private void ToggleExportMember(Guid id, bool selected)
    {
        if (selected) exportSelectedIds.Add(id);
        else exportSelectedIds.Remove(id);
    }

    private void ExportSelectAll()
    {
        if (members == null) return;
        exportSelectedIds = members.Select(m => m.Id).ToHashSet();
    }

    private void ExportSelectNone()
    {
        exportSelectedIds.Clear();
    }

    private IEnumerable<Member> FilteredExportMembers()
    {
        if (members == null) return Enumerable.Empty<Member>();
        var sorted = members.OrderByDescending(m => m.IsActive).ThenBy(m => m.Name);
        if (string.IsNullOrWhiteSpace(exportSearchText)) return sorted;
        return sorted.Where(m => m.Name.Contains(exportSearchText, StringComparison.OrdinalIgnoreCase));
    }

    private async Task ExportCsv()
    {
        if (members == null || exportSelectedIds.Count == 0) return;

        var sb = new System.Text.StringBuilder();
        var selected = members.Where(m => exportSelectedIds.Contains(m.Id)).OrderBy(m => m.Name).ToList();
        for (int i = 0; i < selected.Count; i++)
        {
            sb.AppendLine($"{i + 1};{selected[i].Name};");
        }

        var bytes = System.Text.Encoding.UTF8.GetBytes(sb.ToString());
        var base64 = Convert.ToBase64String(bytes);
        var filename = $"members-{DateTime.Now:yy-MMdd-HHmm}.csv";
        await JS.InvokeVoidAsync("downloadFile", filename, base64);
        showExportPanel = false;
    }

    private async Task TriggerCsvImport()
    {
        csvImportError = null;
        csvImportSuccess = null;
        await JS.InvokeVoidAsync("triggerFileInput", "memberCsvImportInput");
    }

    private async Task OnCsvFileSelected(InputFileChangeEventArgs e)
    {
        csvImportError = null;
        csvImportSuccess = null;

        try
        {
            using var stream = e.File.OpenReadStream(maxAllowedSize: 1024 * 1024);
            using var reader = new System.IO.StreamReader(stream);
            var content = await reader.ReadToEndAsync();

            var lines = content.Split('\n', StringSplitOptions.RemoveEmptyEntries);
            int imported = 0;
            var existingNames = members?.Select(m => m.Name.Trim().ToLowerInvariant()).ToHashSet() ?? new();

            foreach (var rawLine in lines)
            {
                var line = rawLine.Trim();
                if (string.IsNullOrEmpty(line)) continue;

                var separator = line.Contains(';') ? ';' : ',';
                var parts = line.Split(separator);

                // Expect: Number;Name;LeagueId (at least 2 columns, first must be a number)
                if (parts.Length < 2) continue;
                if (!int.TryParse(parts[0].Trim(), out _)) continue;

                var name = parts[1].Trim();
                if (string.IsNullOrEmpty(name)) continue;

                // Skip duplicates by name
                if (existingNames.Contains(name.ToLowerInvariant())) continue;

                await MemberService.AddAsync(new Member { Name = name });
                existingNames.Add(name.ToLowerInvariant());
                imported++;
            }

            if (imported == 0)
            {
                csvImportError = Lang.Get("MembersImportError");
                return;
            }

            members = await MemberService.GetAllAsync();
            csvImportSuccess = $"{imported} {Lang.Get("MembersImported")}";
        }
        catch
        {
            csvImportError = Lang.Get("MembersImportError");
        }
    }
}
