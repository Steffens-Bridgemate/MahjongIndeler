@page "/tournaments"
@using Tsump.Models
@using Tsump.Services
@inject TournamentService TournamentService
@inject LanguageService Lang
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>@Lang.Get("Tournaments") - Tsumo!</PageTitle>

<h1><i class="bi bi-trophy-fill me-2"></i>@Lang.Get("Tournaments")</h1>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="ShowCreateForm">@Lang.Get("CreateTournament")</button>
</div>

@if (showForm)
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">@(editId == null ? Lang.Get("CreateTournament") : Lang.Get("EditTournament"))</h5>
            <div class="mb-3">
                <label class="form-label">@Lang.Get("TournamentName")</label>
                <input class="form-control" @bind="newName" />
            </div>
            <div class="mb-3">
                <label class="form-label">@Lang.Get("TournamentShortName")</label>
                <input class="form-control" style="max-width: 200px;" maxlength="12" @bind="newShortName" />
                <small class="text-muted">@Lang.Get("TournamentShortNameHint")</small>
            </div>
            <div class="mb-3">
                <label class="form-label">@Lang.Get("TournamentDate")</label>
                <input type="date" class="form-control" @bind="newDate" />
            </div>
            <div class="mb-3">
                <label class="form-label">@Lang.Get("NumberOfHanchans")</label>
                <select class="form-select" style="max-width: 120px;" @bind="newSessionCount">
                    @for (int i = 3; i <= 8; i++)
                    {
                        <option value="@i">@i</option>
                    }
                </select>
            </div>
            @if (showEditResetWarning)
            {
                <div class="alert alert-warning py-2">
                    @Lang.Get("ChangeHanchansWarning")
                    <button class="btn btn-sm btn-warning ms-2" @onclick="ConfirmEditReset">@Lang.Get("YesContinue")</button>
                    <button class="btn btn-sm btn-secondary ms-1" @onclick="() => showEditResetWarning = false">@Lang.Get("Cancel")</button>
                </div>
            }
            <button class="btn btn-success me-2" @onclick="SaveForm">@Lang.Get("Save")</button>
            <button class="btn btn-secondary" @onclick="CloseForm">@Lang.Get("Cancel")</button>
        </div>
    </div>
}

@if (tournaments == null)
{
    <p>@Lang.Get("Loading")</p>
}
else if (tournaments.Count == 0)
{
    <p class="text-muted">@Lang.Get("NoTournamentsYet")</p>
}
else
{
    <div class="row">
        @foreach (var t in tournaments.OrderByDescending(x => x.Date))
        {
            <div class="col-md-6 mb-3">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">@t.Name</h5>
                        <p class="card-text text-muted">
                            @Lang.FormatDate(t.Date) &middot;
                            @t.Participants.Count @Lang.Get("ParticipantCount") &middot;
                            @t.SessionCount @Lang.Get("HanchansCount")
                            @if (t.IsGenerated)
                            {
                                <span class="badge bg-success ms-2">&#10003;</span>
                            }
                        </p>
                        <div class="d-flex align-items-center flex-wrap gap-1">
                            <button class="btn btn-primary btn-sm" @onclick="() => OpenTournament(t)">
                                @Lang.Get("OpenTournament")
                            </button>
                            <button class="btn btn-outline-secondary btn-sm" title="@Lang.Get("Edit")" @onclick="() => EditTournament(t)">
                                <i class="bi bi-pencil"></i>
                            </button>
                            @if (deleteConfirmId == t.Id)
                            {
                                <span class="text-danger ms-1">@Lang.Get("DeleteTournamentConfirm")</span>
                                <button class="btn btn-danger btn-sm" @onclick="() => ConfirmDelete(t.Id)">@Lang.Get("YesDelete")</button>
                                <button class="btn btn-secondary btn-sm" @onclick="() => deleteConfirmId = null">@Lang.Get("Cancel")</button>
                            }
                            else
                            {
                                <button class="btn btn-outline-danger btn-sm" @onclick="() => deleteConfirmId = t.Id">@Lang.Get("Remove")</button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<Tournament>? tournaments;
    private bool showForm;
    // null = the form is creating a new tournament; otherwise it's editing this existing one.
    private Guid? editId;
    private string newName = string.Empty;
    private string newShortName = string.Empty;
    private DateTime newDate = DateTime.Today;
    private int newSessionCount = 4;
    private Guid? deleteConfirmId;
    // Editing a generated tournament's hanchan count wipes its assignments — gate that behind a confirm.
    private bool showEditResetWarning;
    private bool editResetConfirmed;

    protected override void OnInitialized() => Lang.OnLanguageChanged += StateHasChanged;
    public void Dispose() => Lang.OnLanguageChanged -= StateHasChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            tournaments = await TournamentService.GetAllAsync();
            StateHasChanged();
        }
    }

    private void ShowCreateForm()
    {
        editId = null;
        newName = string.Empty;
        newShortName = string.Empty;
        newDate = DateTime.Today;
        newSessionCount = 4;
        showEditResetWarning = false;
        editResetConfirmed = false;
        showForm = true;
    }

    private void EditTournament(Tournament t)
    {
        editId = t.Id;
        newName = t.Name;
        newShortName = t.ShortName ?? string.Empty;
        newDate = t.Date;
        newSessionCount = t.SessionCount;
        showEditResetWarning = false;
        editResetConfirmed = false;
        deleteConfirmId = null;
        showForm = true;
    }

    private void CloseForm()
    {
        showForm = false;
        showEditResetWarning = false;
    }

    private Task SaveForm() => editId == null ? CreateTournament() : SaveEdit();

    private async Task CreateTournament()
    {
        if (string.IsNullOrWhiteSpace(newName))
            return;

        var tournament = new Tournament
        {
            Name = newName.Trim(),
            ShortName = string.IsNullOrWhiteSpace(newShortName) ? null : newShortName.Trim(),
            Date = newDate,
            SessionCount = newSessionCount
        };

        await TournamentService.SaveAsync(tournament);
        tournaments = await TournamentService.GetAllAsync();
        showForm = false;

        Nav.NavigateTo($"tournament/{tournament.Id}/participants");
    }

    private async Task SaveEdit()
    {
        if (string.IsNullOrWhiteSpace(newName)) return;
        var t = tournaments?.FirstOrDefault(x => x.Id == editId);
        if (t == null) return;

        var hanchansChanged = newSessionCount != t.SessionCount;

        // Only a hanchan-count change on a generated tournament invalidates the assignments — warn
        // and clear them on confirm. Name / short-name / date edits always save silently.
        if (t.IsGenerated && hanchansChanged && !editResetConfirmed)
        {
            showEditResetWarning = true;
            return;
        }

        t.Name = newName.Trim();
        t.ShortName = string.IsNullOrWhiteSpace(newShortName) ? null : newShortName.Trim();
        t.Date = newDate;
        if (hanchansChanged)
        {
            t.SessionCount = newSessionCount;
            if (t.IsGenerated)
            {
                t.Sessions.Clear();
                t.IsGenerated = false;
            }
        }

        await TournamentService.SaveAsync(t);
        tournaments = await TournamentService.GetAllAsync();
        CloseForm();
    }

    private async Task ConfirmEditReset()
    {
        editResetConfirmed = true;
        showEditResetWarning = false;
        await SaveEdit();
    }

    private void OpenTournament(Tournament tournament)
    {
        // A generated tournament has table assignments — land on the Assignments view
        // (which defaults to the Tables tab); otherwise start on Participants.
        Nav.NavigateTo(tournament.IsGenerated
            ? $"tournament/{tournament.Id}"
            : $"tournament/{tournament.Id}/participants");
    }

    private async Task ConfirmDelete(Guid id)
    {
        await TournamentService.DeleteAsync(id);
        tournaments = await TournamentService.GetAllAsync();
        deleteConfirmId = null;
    }
}
