@page "/workflow"
@using Tsump.Services
@inject LocalStorageService Storage
@inject LanguageService Lang
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject SettingsService SettingsService
@implements IDisposable

<PageTitle>@Lang.Get("Workflow") - Tsumo!</PageTitle>

<h1><i class="bi bi-card-checklist me-2"></i>@Lang.Get("Workflow")</h1>
<p class="text-muted">@Lang.Get("WorkflowDesc")</p>

@if (stepsLoaded)
{
    var activeSteps = steps.Where(s => !s.Optional || s.Enabled).ToList();
    var allDone = activeSteps.All(s => s.Done);
    <div class="mb-3 p-2 rounded @(allDone ? "bg-primary-subtle border border-primary" : "bg-light")">
        <button class="btn @(allDone ? "btn-primary" : "btn-outline-secondary") btn-sm" disabled="@(!allDone)" @onclick="ResetWorkflow">
            @Lang.Get("ResetWorkflow")
        </button>
        @if (!allDone)
        {
            <small class="text-muted ms-2">@Lang.Get("ResetWorkflowHint")</small>
        }
    </div>

    <div class="list-group">
        @for (int i = 0; i < steps.Count; i++)
        {
            var step = steps[i];
            var index = i;
            var isSkipped = step.Optional && !step.Enabled;
            var prevDone = index == 0 || IsPreviousEffectiveDone(index);
            var isActive = !isSkipped && prevDone && !step.Done;
            var isEnabled = !isSkipped && prevDone;
            var statusClass = isSkipped ? "list-group-item-light text-muted"
                : step.Done ? "list-group-item-success"
                : isActive ? "border-primary"
                : "list-group-item-light text-muted";
            var itemOpacity = isActive ? "1" : (step.Done || isSkipped || !isEnabled) ? "0.6" : "0.6";

            <div class="list-group-item @statusClass" style="opacity: @itemOpacity;">
                <div class="d-flex align-items-start">
                    <div class="me-3 mt-1">
                        @if (isEnabled)
                        {
                            @if (step.Done)
                            {
                                <button class="btn btn-success btn-sm wf-toggle-btn"
                                        title="@Lang.Get("MarkUncompleted")"
                                        @onclick="() => ToggleStep(index, false)">
                                    <i class="bi bi-check-lg text-white"></i>
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-outline-secondary btn-sm wf-toggle-btn"
                                        title="@Lang.Get("MarkCompleted")"
                                        @onclick="() => ToggleStep(index, true)">
                                    <i class="bi bi-check-lg"></i>
                                </button>
                            }
                        }
                        else
                        {
                            <span class="wf-toggle-btn d-inline-flex align-items-center justify-content-center text-muted" style="opacity:0.3;">
                                <i class="bi bi-check-lg"></i>
                            </span>
                        }
                    </div>
                    <div class="flex-grow-1">
                        <div class="fw-bold mb-1">
                            @Lang.Get(step.TitleKey)
                            @if (isSkipped)
                            {
                                <span class="badge bg-secondary ms-2">@Lang.Get("Disabled")</span>
                            }
                        </div>
                        <div class="small @(isActive ? "text-muted" : "")">@Lang.Get(step.DescKey)</div>
                        @if (step.TargetPage != null && isActive)
                        {
                            <button class="btn btn-sm btn-primary mt-2"
                                    @onclick="() => NavigateToStep(index)">
                                @Lang.Get(step.ButtonKey!)
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private const string StorageKey = "tsump_workflow";
    private bool stepsLoaded;

    private bool hasSaveFilePicker;
    private bool enableScoreEntry;
    private List<WorkflowStep> steps = new();

    protected override void OnInitialized() => Lang.OnLanguageChanged += StateHasChanged;
    public void Dispose() => Lang.OnLanguageChanged -= StateHasChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            hasSaveFilePicker = await JS.InvokeAsync<bool>("eval", "!!window.showSaveFilePicker");
            var settings = await SettingsService.GetAsync();
            enableScoreEntry = settings.EnableScoreEntry;
            BuildSteps();

            var saved = await Storage.GetAsync<Dictionary<string, bool>>(StorageKey);
            if (saved != null)
            {
                foreach (var step in steps)
                {
                    if (saved.TryGetValue(step.Key, out var done))
                        step.Done = done;
                }
            }
            stepsLoaded = true;
            StateHasChanged();
        }
    }

    private void BuildSteps()
    {
        steps = new List<WorkflowStep>
        {
            new() { Key = "import", TitleKey = "WfStep1Title", DescKey = "WfStep1Desc", TargetPage = "data", ButtonKey = "WfStep1Button" },
            new() { Key = "session", TitleKey = "WfStep2Title", DescKey = "WfStep2Desc", TargetPage = "session", ButtonKey = "WfStep2Button" },
            new() { Key = "publish", TitleKey = "WfStep2aTitle", DescKey = "WfStep2aDesc" },
            new() { Key = "scores", TitleKey = "WfStepScoresTitle", DescKey = "WfStepScoresDesc",
                     TargetPage = "session?tab=allscores", ButtonKey = "WfStepScoresButton",
                     Optional = true, Enabled = enableScoreEntry },
            new() { Key = "export", TitleKey = hasSaveFilePicker ? "WfStep3TitleSaveAs" : "WfStep3Title",
                     DescKey = hasSaveFilePicker ? "WfStep3DescSaveAs" : "WfStep3Desc",
                     TargetPage = "data", ButtonKey = "WfStep3Button" },
        };

        if (!hasSaveFilePicker)
        {
            steps.Add(new() { Key = "copyback", TitleKey = "WfStep4Title", DescKey = "WfStep4Desc" });
        }
    }

    private bool IsPreviousEffectiveDone(int index)
    {
        for (int i = index - 1; i >= 0; i--)
        {
            if (steps[i].Optional && !steps[i].Enabled)
                continue;
            return steps[i].Done;
        }
        return true;
    }

    private async Task ToggleStep(int index, bool value)
    {
        steps[index].Done = value;
        if (!value)
        {
            for (int i = index + 1; i < steps.Count; i++)
                steps[i].Done = false;
        }
        await SaveState();
    }

    private async Task SaveState()
    {
        var state = new Dictionary<string, bool>();
        foreach (var step in steps)
            state[step.Key] = step.Done;
        await Storage.SetAsync(StorageKey, state);
    }

    private void NavigateToStep(int index)
    {
        var step = steps[index];
        var page = step.TargetPage!;
        var separator = page.Contains('?') ? '&' : '?';
        page += $"{separator}fromWorkflow={step.Key}";
        Nav.NavigateTo(page);
    }

    private async Task ResetWorkflow()
    {
        foreach (var step in steps)
            step.Done = false;
        await SaveState();
    }

    private class WorkflowStep
    {
        public string Key { get; set; } = "";
        public string TitleKey { get; set; } = "";
        public string DescKey { get; set; } = "";
        public string? TargetPage { get; set; }
        public string? ButtonKey { get; set; }
        public bool Done { get; set; }
        public bool Optional { get; set; }
        public bool Enabled { get; set; } = true;
    }
}
