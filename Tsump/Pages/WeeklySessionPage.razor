    private Hanchan? PreviousHanchanWithTables()
    {
        return hanchansOnDate
            .Where(h => h.Id != currentHanchan?.Id && h.Tables.Count > 0)
            .OrderByDescending(h => h.StartTime ?? TimeSpan.Zero)
