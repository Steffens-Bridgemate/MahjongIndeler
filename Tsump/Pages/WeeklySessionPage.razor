@page "/session"
@using Tsump.Models
@using Tsump.Services
@using Tsump.Scoring
@inject MemberService MemberService
@inject SessionService SessionService
@inject TableAssignmentService TableAssignmentService
@inject ScoreImportService ScoreImport
@inject LanguageService Lang
@inject SettingsService SettingsService
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject LocalStorageService Storage
@implements IDisposable

<PageTitle>@Lang.Get("WeeklySession") - Tsumo!</PageTitle>

<h1><i class="bi bi-calendar-week me-2"></i>@Lang.Get("WeeklySession")</h1>

<div class="row mb-3">
    <div class="col-auto">
        <label class="form-label"><strong>@Lang.Get("SessionDate")</strong></label>
        <input type="date" class="form-control" style="max-width: 250px;"
               value="@sessionDate.ToString("yyyy-MM-dd")"
               @onchange="OnDateChanged" />
    </div>
    <div class="col-auto">
        <label class="form-label"><strong>@Lang.Get("StartTime")</strong></label>
        <div class="d-flex align-items-center gap-1">
            <select class="form-select" style="max-width: 75px;"
                    value="@(hanchanStartTime.HasValue? hanchanStartTime.Value.Hours : -1)"
                    disabled="@IsLockedPastSession"
                    @onchange="OnHourChanged">
                <option value="-1">--</option>
                @for (int h = 0; h < 24; h++)
                {
                    var hh = h;
                    <option value="@hh">@hh.ToString("D2")</option>
                }
            </select>
            <span>:</span>
            <select class="form-select" style="max-width: 75px;"
                    value="@(hanchanStartTime.HasValue? hanchanStartTime.Value.Minutes : -1)"
                    disabled="@IsLockedPastSession"
                    @onchange="OnMinuteChanged">
                <option value="-1">--</option>
                @for (int m = 0; m < 60; m += 5)
                {
                    var mm = m;
                    <option value="@mm">@mm.ToString("D2")</option>
                }
            </select>
        </div>
    </div>
    <div class="col-auto d-flex align-items-end">
        <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox"
                   checked="@excludeFromOptimization"
                   disabled="@IsLockedPastSession"
                   @onchange="e => excludeFromOptimization = (bool)(e.Value ?? false)" />
            <label class="form-check-label">@Lang.Get("ExcludeFromOptimization")</label>
        </div>
    </div>
</div>

@if (hanchansOnDate.Count > 0 || currentHanchan == null)
{
    <div class="d-flex align-items-center mb-2 flex-wrap gap-1">
        <button class="btn btn-sm btn-outline-success" @onclick="StartNewHanchan"
                disabled="@(currentHanchan != null && !currentHanchan.IsFinalized)">
            + @Lang.Get("NewSession")
        </button>
        @if (hanchansOnDate.Count(s => s.Tables.Count > 0) > 1)
        {
            @if (showExportAll)
            {
                <button class="btn btn-sm btn-outline-secondary" @onclick="CopyAllHanchansToClipboard">
                    <i class="bi bi-clipboard me-1"></i>@(copiedAllToClipboard? Lang.Get("Copied") : Lang.Get("CopyToClipboard"))
                </button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="OpenAllHanchans">
                    <i class="bi bi-printer me-1"></i>@Lang.Get("OpenPrint")
                </button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="DownloadAllHanchans">
                    <i class="bi bi-download me-1"></i>@Lang.Get("DownloadHtml")
                </button>
            }
            else
            {
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => showExportAll = true">
                    <i class="bi bi-table me-1"></i>@Lang.Get("ExportAssignments")
                </button>
            }
        }
    </div>
    <ul class="nav nav-tabs mb-0">
        @foreach (var s in hanchansOnDate.OrderBy(s => s.StartTime ?? TimeSpan.Zero))
        {
            var isActive = currentHanchan?.Id == s.Id && activeTab != "rankings" && activeTab != "allscores";
            var sessionLabel = GetSessionLabel(s);
            <li class="nav-item">
                <a class="nav-link @(isActive ? "active" : "")" href="javascript:void(0)" @onclick="() => SelectHanchan(s)">
                    @sessionLabel
                </a>
            </li>
        }
        @if (hanchansOnDate.Count > 1)
        {
            <li class="nav-item">
                <a class="nav-link @(activeTab == "allscores" ? "active" : "")" href="javascript:void(0)" @onclick="ActivateAllScoresTab">
                    @Lang.Get("AllScores")
                </a>
            </li>
        }
        @if (hanchansOnDate.Any(h => h.Tables.Any(t => t.Score != null)))
        {
            <li class="nav-item">
                <a class="nav-link @(activeTab == "rankings" ? "active" : "")" href="javascript:void(0)" @onclick="ActivateRankingsTab">
                    @Lang.Get("Rankings")
                </a>
            </li>
        }
    </ul>
}

@if (IsLockedPastSession)
{
    <div class="alert alert-warning">
        @Lang.Get("PastSessionReadOnly")
    </div>
}

@if (members == null)
{
    <p>@Lang.Get("Loading")</p>
}
else if (members.Count == 0)
{
    <p class="text-muted">@Lang.Get("NoMembersRegistered") <a href="members">@Lang.Get("AddMembersLink")</a>.</p>
}
else
{
    <div class="tab-content-panel">
    @if (activeTab != "rankings" && activeTab != "allscores")
    {
    <div class="card mb-4">
        <div class="card-header d-flex align-items-center" style="cursor: pointer;" @onclick="() => attendanceExpanded = !attendanceExpanded">
            <h5 class="mb-0 flex-grow-1">@Lang.Get("Attendance") (@presentIds.Count @Lang.Get("present") @Lang.Get("of") @activeMembers.Count @Lang.Get("active"))</h5>
            <span class="ms-2">@(attendanceExpanded ? "\u25B2" : "\u25BC")</span>
        </div>
        @if (attendanceExpanded)
        {
            <div class="card-body">
                @if (showAttendanceWarning)
                {
                    <div class="alert alert-warning py-2 mb-2">
                        @Lang.Get("ChangeAttendanceWarning")
                        <button class="btn btn-sm btn-warning ms-2" @onclick="ConfirmAttendanceReset">@Lang.Get("YesContinue")</button>
                        <button class="btn btn-sm btn-secondary ms-1" @onclick="CancelAttendanceReset">@Lang.Get("Cancel")</button>
                    </div>
                }
                @if (!IsLockedPastSession)
                {
                    <div class="mb-2">
                        <button class="btn btn-sm btn-outline-success me-1" @onclick="SelectAll">@Lang.Get("AllPresent")</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="SelectNone">@Lang.Get("AllAbsent")</button>
                    </div>
                }
                <div class="mb-3">
                    <input type="text" class="form-control" placeholder="@Lang.Get("SearchMembers")"
                           style="max-width: 300px; border-radius: 15px;"
                           @bind="searchText" @bind:event="oninput" />
                </div>
                <div class="row">
                    @foreach (var member in FilteredMembers())
                    {
                        <div class="col-md-4 col-sm-6 mb-2">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       checked="@presentIds.Contains(member.Id)"
                                       disabled="@IsLockedPastSession"
                                       @onchange="e => ToggleAttendance(member.Id, (bool)(e.Value ?? false))" />
                                <label class="form-check-label">@member.Name</label>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    @if (!IsLockedPastSession)
    {
        <div class="mb-3">
            @if (tables.Count == 0)
            {
                <button class="btn btn-primary me-2" @onclick="GenerateTables" disabled="@(presentIds.Count < 3)">
                    @Lang.Get("GenerateTableAssignments")
                </button>
                @if (PreviousHanchanWithTables() != null)
                {
                    <button class="btn btn-outline-primary me-2" @onclick="CopyTablesFromPrevious">
                        @Lang.Get("CopyTables")
                    </button>
                }
                <button class="btn btn-outline-secondary me-2" @onclick="ShowCopyFromHistory">
                    <i class="bi bi-clipboard-plus me-1"></i>@Lang.Get("CopyFromHistory")
                </button>
            }
            <button class="btn save-hanchan-btn icon-btn @(saved ? "btn-outline-secondary" : "btn-success")" @onclick="SaveHanchan" disabled="@(tables.Count == 0)" title="@Lang.Get("SaveHanchan")">
                <i class="bi bi-floppy"></i>
            </button>
            @if (workflowStepKey != null)
            {
                <button class="btn @(saved ? "btn-primary" : "btn-outline-secondary") ms-2"
                        disabled="@(!saved)" @onclick="BackToWorkflow">
                    &larr; @Lang.Get("BackToWorkflow")
                </button>
                @if (!saved)
                {
                    <small class="text-muted ms-2">@Lang.Get("BackToWorkflowHint")</small>
                }
            }
            @if (tables.Count > 0)
            {
                @if (showRegenerateConfirm)
                {
                    <span class="alert alert-warning d-inline-block ms-2 mb-0 py-1">
                        @Lang.Get("RegenerateConfirm")
                        <button class="btn btn-sm btn-warning ms-2 me-1" @onclick="ConfirmRegenerate">@Lang.Get("YesRegenerate")</button>
                        <button class="btn btn-sm btn-secondary" @onclick="CancelRegenerate">@Lang.Get("Cancel")</button>
                    </span>
                }
                else
                {
                    <button class="btn btn-outline-primary ms-2" @onclick="RequestRegenerate" disabled="@(presentIds.Count < 3)">
                        <i class="bi bi-arrow-repeat me-1"></i>@Lang.Get("Regenerate")
                    </button>
                }
            }
            @if (currentHanchan != null)
            {
                @if (showDeleteConfirm)
                {
                    <span class="alert alert-danger d-inline-block ms-2 mb-0 py-1">
                        @Lang.Get("DeleteHanchanConfirm")
                        <button class="btn btn-sm btn-danger ms-2 me-1" @onclick="ConfirmDeleteHanchan">@Lang.Get("YesDelete")</button>
                        <button class="btn btn-sm btn-secondary" @onclick="CancelDeleteHanchan">@Lang.Get("Cancel")</button>
                    </span>
                }
                else
                {
                    <button class="btn btn-outline-danger ms-2" @onclick="RequestDeleteHanchan">
                        <i class="bi bi-trash me-1"></i>@Lang.Get("DeleteHanchan")
                    </button>
                }
            }
            @if (presentIds.Count < 3)
            {
                <span class="text-warning ms-2">@Lang.Get("NeedAtLeast3")</span>
            }
        </div>

        @if (showCopyFromHistory)
        {
            <div class="card mb-3">
                <div class="card-header d-flex align-items-center">
                    <h6 class="mb-0 flex-grow-1">@Lang.Get("SelectSessionToCopy")</h6>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => showCopyFromHistory = false">@Lang.Get("Cancel")</button>
                </div>
                <div class="card-body p-0" style="max-height: 300px; overflow-y: auto;">
                    @if (historySessions == null || historySessions.Count == 0)
                    {
                        <p class="text-muted p-3 mb-0">@Lang.Get("NoSessionsYet")</p>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var s in historySessions)
                            {
                                var sessionNum = GetHistorySessionNumber(s);
                                var timeStr = s.StartTime.HasValue ? s.StartTime.Value.ToString(@"hh\:mm") : "";
                                var tableWord = s.Tables.Count == 1 ? Lang.Get("table") : Lang.Get("tables");
                                <button class="list-group-item list-group-item-action" @onclick="() => CopyFromHistorySession(s)">
                                    @Lang.FormatDate(s.Date)@(sessionNum.HasValue ? $" #{sessionNum}" : "")@(timeStr != "" ? $" ({timeStr})" : "")
                                    &mdash; @s.PresentMemberIds.Count @Lang.Get("present"), @s.Tables.Count @tableWord
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    }

    @if (IsLockedPastSession && currentHanchan != null)
    {
        <div class="mb-3">
            @if (showDeleteConfirm)
            {
                <div class="alert alert-danger d-inline-block">
                    @Lang.Get("DeleteHanchanConfirm")
                    <button class="btn btn-sm btn-danger ms-2 me-1" @onclick="ConfirmDeleteHanchan">@Lang.Get("YesDelete")</button>
                    <button class="btn btn-sm btn-secondary" @onclick="CancelDeleteHanchan">@Lang.Get("Cancel")</button>
                </div>
            }
            else
            {
                <button class="btn btn-outline-danger" @onclick="RequestDeleteHanchan">
                    <i class="bi bi-trash me-1"></i>@Lang.Get("DeleteHanchan")
                </button>
            }
        </div>
    }
    } @* end: activeTab != rankings/allscores *@

    <div class="tab-fade" @key="@TabContentKey">
    @if (activeTab == "rankings")
    {
        <div class="d-flex align-items-center mb-2 flex-wrap gap-1">
            @if (showExportRankings)
            {
                <button class="btn btn-sm btn-outline-secondary" @onclick="CopyRankingsToClipboard">
                    <i class="bi bi-clipboard me-1"></i>@(copiedRankingsToClipboard ? Lang.Get("Copied") : Lang.Get("CopyToClipboard"))
                </button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="OpenRankings">
                    <i class="bi bi-printer me-1"></i>@Lang.Get("OpenPrint")
                </button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="DownloadRankings">
                    <i class="bi bi-download me-1"></i>@Lang.Get("DownloadHtml")
                </button>
            }
            else
            {
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => showExportRankings = true">
                    <i class="bi bi-list-ol me-1"></i>@Lang.Get("ExportRankings")
                </button>
            }
        </div>
        <RankingTable Entries="BuildWeeklyRankings()" />
    }
    else if (activeTab == "allscores")
    {
        @foreach (var tableGroup in BuildAllScoresEntries())
        {
            <h5 class="mt-3 mb-2">@Lang.Get("Table") @tableGroup.TableNumber</h5>
            @foreach (var entry in tableGroup.Entries)
            {
                <h6 class="text-muted mb-1">@entry.Label</h6>
                <ScoreTable Table="entry.Table" PlayerNameResolver="GetPlayerName"
                            OnScoresComplete="SaveAllScores" OnScoresCleared="SaveAllScores"
                            DefaultStartingPoints="weeklyStartingPoints" Uma4Players="uma4Players" Uma3Players="uma3Players" />
            }
        }
    }
    else if (tables.Count > 0)
    {
        <div class="d-flex align-items-center mb-2 flex-wrap gap-1">
            @if (showExportSingle)
            {
                <button class="btn btn-sm btn-outline-secondary" @onclick="CopyTablesToClipboard">
                    <i class="bi bi-clipboard me-1"></i>@(copiedToClipboard? Lang.Get("Copied") : Lang.Get("CopyToClipboard"))
                </button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="OpenSingleHanchan">
                    <i class="bi bi-printer me-1"></i>@Lang.Get("OpenPrint")
                </button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="DownloadSingleHanchan">
                    <i class="bi bi-download me-1"></i>@Lang.Get("DownloadHtml")
                </button>
            }
            else
            {
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => showExportSingle = true">
                    <i class="bi bi-table me-1"></i>@Lang.Get("ExportAssignments")
                </button>
            }
            @if (showExportScoresheetsSingle)
            {
                <button class="btn btn-sm btn-outline-secondary" @onclick="PrintScoresheetsSingle">
                    <i class="bi bi-printer me-1"></i>@Lang.Get("PrintScoresheets")
                </button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="DownloadScoresheetsSingle">
                    <i class="bi bi-download me-1"></i>@Lang.Get("DownloadScoresheets")
                </button>
            }
            else
            {
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => showExportScoresheetsSingle = true">
                    <i class="bi bi-card-checklist me-1"></i>@Lang.Get("ExportScoresheets")
                </button>
            }
        </div>

        <ul class="nav nav-tabs mb-3">
            <li class="nav-item">
                <a class="nav-link @(activeTab == "tables" ? "active" : "")" href="javascript:void(0)" @onclick='() => activeTab = "tables"'>
                    @Lang.Get("TableAssignments")
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(activeTab == "scores" ? "active" : "")" href="javascript:void(0)" @onclick="ActivateScoresTab">
                    @Lang.Get("Scores")
                </a>
            </li>
        </ul>

        @if (activeTab == "tables")
        {
            @if (!IsLockedPastSession && selectedPlayerIds.Count > 0)
            {
                <div class="mb-3">
                    <span class="text-muted me-2">
                        @Lang.Get("Selected"): @string.Join(", ", selectedPlayerIds.Select(id => GetPlayerName(id)))
                    </span>
                    @if (selectedPlayerIds.Count == 2)
                    {
                        <button class="btn btn-sm btn-warning me-1" @onclick="SwapSelectedPlayers">
                            @Lang.Get("SwapPlayers")
                        </button>
                    }
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ClearSelection">
                        @Lang.Get("ClearSelection")
                    </button>
                </div>
            }

            <div class="row">
                @foreach (var table in tables)
                {
                    <div class="col-md-4 mb-3">
                        <div class="card @(table.PlayerCount == 3 ? "border-warning" : "border-success")">
                            <div class="card-header @(table.PlayerCount == 3 ? "bg-warning text-dark" : "bg-success text-white")">
                                @Lang.Get("Table") @table.TableNumber (@table.PlayerCount @Lang.Get("players"))
                            </div>
                            <ul class="list-group list-group-flush">
                                @foreach (var playerId in table.PlayerIds)
                                {
                                    var pid = playerId;
                                    var player = members.FirstOrDefault(m => m.Id == pid);
                                    var isSelected = selectedPlayerIds.Contains(pid);
                                    <li class="list-group-item d-flex align-items-center @(isSelected ? "list-group-item-primary" : "")"
                                        style="cursor: @(IsLockedPastSession ? "default" : "grab")"
                                        draggable="@(!IsLockedPastSession)"
                                        @ondragstart="() => OnDragStart(pid)"
                                        @ondragover:preventDefault
                                        @ondrop="() => OnDrop(pid)"
                                        @onclick="() => OnPlayerClick(pid)">
                                        <span>@(player?.Name ?? Lang.Get("Unknown"))</span>
                                    </li>
                                }
                            </ul>
                            @if (externalScoringEnabled)
                            {
                                var tableRef = table;
                                <div class="card-footer p-2">
                                    <div class="d-flex gap-1">
                                        <button class="btn btn-sm btn-outline-secondary flex-grow-1"
                                                @onclick="() => ShareScoringLink(tableRef)"
                                                title="@Lang.Get("ShareScoringLink")">
                                            <i class="bi bi-link-45deg me-1"></i>@(sharedScoringLinkTableNumber == tableRef.TableNumber ? Lang.Get("Copied") : Lang.Get("ShareScoringLink"))
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary"
                                                @onclick="() => ShowScoringQrFor(tableRef)"
                                                title="@Lang.Get("ShowQrCode")"
                                                aria-label="@Lang.Get("ShowQrCode")">
                                            <i class="bi bi-qr-code"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            @if (presentIds.Count - tables.Sum(t => t.PlayerCount) > 0)
            {
                <div class="alert alert-info">
                    @(presentIds.Count - tables.Sum(t => t.PlayerCount)) @Lang.Get("UnassignedPlayers")
                </div>
            }
        }
        else if (activeTab == "scores")
        {
            @if (externalScoringEnabled)
            {
                <div class="mb-3">
                    @if (!showImportResult)
                    {
                        <button class="btn btn-outline-secondary" @onclick="OpenImportResult">
                            <i class="bi bi-box-arrow-in-down me-1"></i>@Lang.Get("ImportResult")
                        </button>
                    }
                    else
                    {
                        <div class="card">
                            <div class="card-header d-flex align-items-center">
                                <h6 class="mb-0 flex-grow-1">@Lang.Get("ImportResultPanelTitle")</h6>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="CancelImportResult">@Lang.Get("Cancel")</button>
                            </div>
                            <div class="card-body">
                                @if (importStatus == ImportStatus.Reading)
                                {
                                    <p class="text-muted small mb-0">@Lang.Get("ImportResultReading")</p>
                                }
                                else if (importStatus == ImportStatus.Preview || importStatus == ImportStatus.AlreadyScored)
                                {
                                    @if (pendingImportLookup != null)
                                    {
                                        var pl = pendingImportLookup;
                                        var headerClass = pl.Table.PlayerCount == 3 ? "bg-warning text-dark" : "bg-success text-white";
                                        <div class="@headerClass py-1 px-2 mb-2 rounded">
                                            @Lang.FormatDate(pl.Hanchan.Date)
                                            @if (pl.Hanchan.StartTime.HasValue)
                                            {
                                                <span> &middot; @pl.Hanchan.StartTime.Value.ToString(@"hh\:mm")</span>
                                            }
                                            &middot; @Lang.Get("Table") @pl.Table.TableNumber
                                            <span class="ms-1">(@pl.Table.PlayerCount @Lang.Get("players"))</span>
                                        </div>
                                    }
                                    <p>@Lang.Get("ImportScoreConfirm")</p>

                                    @if (importStatus == ImportStatus.AlreadyScored)
                                    {
                                        <div class="alert alert-warning py-2 mb-2">@Lang.Get("ImportScoreOverwriteWarning")</div>
                                    }

                                    <table class="table table-sm table-bordered" style="max-width:500px;">
                                        <thead>
                                            <tr>
                                                <th>@Lang.Get("Player")</th>
                                                <th class="text-end">@Lang.Get("EndShort")</th>
                                                <th class="text-end">@Lang.Get("LoanShort")</th>
                                                <th class="text-end">@Lang.Get("PenaltyShort")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var s in pendingImportResult!.Scores)
                                            {
                                                <tr>
                                                    <td>@GetPlayerName(s.PlayerId)</td>
                                                    <td class="text-end">@FormatImportScore(s.EndPoints)</td>
                                                    <td class="text-end">@(s.Loan != 0 ? FormatImportScore(s.Loan) : "")</td>
                                                    <td class="text-end">@(s.Penalty != 0 ? FormatImportScore(s.Penalty) : "")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>

                                    <button class="btn btn-success me-2" @onclick="() => ApplyImportPreview(confirmOverwrite: true)">
                                        <i class="bi bi-check2 me-1"></i>@(importStatus == ImportStatus.AlreadyScored ? Lang.Get("YesOverwrite") : Lang.Get("ImportScoreApply"))
                                    </button>
                                    <button class="btn btn-outline-secondary" @onclick="CancelImportResult">@Lang.Get("Cancel")</button>
                                }
                                else if (importStatus == ImportStatus.NotResultLink
                                         || importStatus == ImportStatus.NoResult
                                         || importStatus == ImportStatus.NoMatchingTable)
                                {
                                    @if (importStatus == ImportStatus.NotResultLink)
                                    {
                                        <div class="alert alert-warning py-2 mb-2">@Lang.Get("ImportResultErrorNotResult")</div>
                                    }
                                    else if (importStatus == ImportStatus.NoMatchingTable)
                                    {
                                        <div class="alert alert-warning py-2 mb-2">@Lang.Get("ImportResultNoMatchHint")</div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-warning py-2 mb-2">@Lang.Get("ImportResultNoneInClipboard")</div>
                                    }

                                    <button class="btn btn-outline-primary" @onclick="TryImportFromClipboard">
                                        <i class="bi bi-arrow-repeat me-1"></i>@Lang.Get("Retry")
                                    </button>
                                }
                                else if (importStatus == ImportStatus.Applied)
                                {
                                    <div class="alert alert-success py-2 mb-2">@Lang.Get("ImportScoreApplied")</div>
                                    <button class="btn btn-primary me-2" @onclick="TryImportFromClipboard">
                                        <i class="bi bi-arrow-right-circle me-1"></i>@Lang.Get("Next")
                                    </button>
                                    <button class="btn btn-outline-secondary" @onclick="CancelImportResult">@Lang.Get("Close")</button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            @foreach (var table in tables)
            {
                <ScoreTable @key="(scoreTableVersion, table.TableNumber)"
                            Table="table" PlayerNameResolver="GetPlayerName"
                            OnScoresComplete="SaveScores" OnScoresCleared="SaveScores"
                            DefaultStartingPoints="weeklyStartingPoints" Uma4Players="uma4Players" Uma3Players="uma3Players" />
            }
        }
    }
    </div>
    </div>

}

