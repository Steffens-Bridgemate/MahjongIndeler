    private void AppendTablesHtml(System.Text.StringBuilder html, System.Text.StringBuilder text, List<TableAssignment> tablesToRender)
    {
        html.Append("<div style=\"overflow:hidden;\">");

        for (int i = 0; i < tablesToRender.Count; i++)
        {
            var table = tablesToRender[i];
            var is3 = table.PlayerCount == 3;
            var headerBg = is3 ? "#ffc107" : "#198754";
            var headerColor = is3 ? "#000" : "#fff";
            var borderColor = is3 ? "#ffc107" : "#198754";

            html.Append($"<div class=\"table-block\" style=\"float:left;width:31.5%;margin:0 0.9% 14px;\">");
            html.Append($"<div style=\"border:1px solid {borderColor};border-radius:4px;overflow:hidden;font-family:Verdana,sans-serif;font-size:13px;\">");
            html.Append($"<div style=\"background:{headerBg};color:{headerColor};padding:4px 8px;font-weight:bold;white-space:nowrap;\">");
            html.Append($"{Lang.Get("Table")} {table.TableNumber} ({table.PlayerCount} {Lang.Get("players")})");
            html.Append("</div>");

            text.AppendLine($"*{Lang.Get("Table")} {table.TableNumber}* ({table.PlayerCount} {Lang.Get("players")})");

            foreach (var playerId in table.PlayerIds)
            {
                var name = GetPlayerName(playerId);
                html.Append($"<div style=\"padding:3px 8px;border-top:1px solid #dee2e6;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\">{name}</div>");
                text.AppendLine($"  {name}");
            }

            html.Append("</div></div>");

            if (i + 1 < tablesToRender.Count)
                text.AppendLine();
        }

        html.Append("</div>");
    }

    private (string html, string text) BuildSingleHanchanContent()
    {
        var ordered = hanchansOnDate.OrderBy(s => s.StartTime ?? TimeSpan.Zero).ToList();
        var hanchanNumber = currentHanchan != null
            ? ordered.IndexOf(currentHanchan) + 1
            : ordered.Count + 1;
        var timeStr = hanchanStartTime.HasValue ? hanchanStartTime.Value.ToString(@"hh\:mm") : "";
        var dateText = Lang.FormatDate(sessionDate);
        var hanchanText = $"{Lang.Get("Hanchan")} {hanchanNumber}";
        if (timeStr.Length > 0)
            hanchanText += $" {timeStr}";

        var html = new System.Text.StringBuilder();
        var text = new System.Text.StringBuilder();

        html.Append($"<div style=\"font-family:Verdana,sans-serif;font-size:14px;font-weight:bold;margin-bottom:4px;\">{dateText}</div>");
        html.Append($"<div style=\"font-family:Verdana,sans-serif;font-size:14px;font-weight:bold;margin-bottom:14px;\">{hanchanText}</div>");
        text.AppendLine($"*{dateText}*");
        text.AppendLine($"*{hanchanText}*");
        text.AppendLine();

        AppendTablesHtml(html, text, tables);

        return (html.ToString(), text.ToString().TrimEnd());
    }

    private (string html, string text) BuildAllHanchansContent()
    {
        var orderedHanchans = hanchansOnDate
            .Where(s => s.Tables.Count > 0)
            .OrderBy(s => s.StartTime ?? TimeSpan.Zero)
            .ToList();

        var html = new System.Text.StringBuilder();
        var text = new System.Text.StringBuilder();

        var dateHeader = Lang.FormatDate(sessionDate);
        html.Append($"<div style=\"font-family:Verdana,sans-serif;font-size:14px;font-weight:bold;margin-bottom:8px;\">{dateHeader}</div>");
        text.AppendLine($"*{dateHeader}*");
        text.AppendLine();

        for (int hi = 0; hi < orderedHanchans.Count; hi++)
        {
            var hanchan = orderedHanchans[hi];
            var hanchanIndex = hi + 1;
            var timeStr = hanchan.StartTime.HasValue ? hanchan.StartTime.Value.ToString(@"hh\:mm") : "";
            var hanchanHeader = $"{Lang.Get("Hanchan")} {hanchanIndex}";
            if (timeStr.Length > 0)
                hanchanHeader += $" {timeStr}";

            html.Append("<div style=\"break-inside:avoid;page-break-inside:avoid;\">");
            html.Append($"<div style=\"font-family:Verdana,sans-serif;font-size:14px;font-weight:bold;margin:12px 0 14px;\">{hanchanHeader}</div>");
            text.AppendLine($"*{hanchanHeader}*");

            AppendTablesHtml(html, text, hanchan.Tables);
            html.Append("</div>");
            text.AppendLine();
        }

        return (html.ToString(), text.ToString().TrimEnd());
    }

    private string WrapAsHtmlDocument(string title, string bodyContent, bool includePrintButton = false)
    {
        var printBtn = includePrintButton
            ? "<div class=\"no-print\"><button onclick=\"window.print()\" style=\"padding:8px 20px;font-size:16px;cursor:pointer;\">Print</button></div>"
            : "";
        return "<!DOCTYPE html><html><head><meta charset=\"utf-8\">" +
               "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">" +
               $"<title>{title}</title>" +
               "<style>" +
               "body { font-family: Verdana, Arial, sans-serif; margin: 0; padding: 2px; } " +
               ".no-print { position:sticky;top:0;z-index:100;padding:8px;margin-bottom:6px;background:#f0f0f0;border-bottom:1px solid #ccc; } " +
               "@media screen and (max-width:600px) { .table-block { float:none !important;width:100% !important;margin:0 0 10px !important; } } " +
               "@media print { .no-print { display:none; } body { padding:0; } }" +
               "</style></head><body>" +
               printBtn + bodyContent + "</body></html>";
    }

    private async Task OpenImportResult()
    {
        showImportResult = true;
        importStatus = ImportStatus.Reading;
        pendingImportResult = null;
        pendingImportLookup = null;
        StateHasChanged();
        await TryImportFromClipboard();
    }

    private async Task TryImportFromClipboard()
    {
        importStatus = ImportStatus.Reading;
        pendingImportResult = null;
        pendingImportLookup = null;
        StateHasChanged();

        string? clip = null;
        try
        {
            clip = await JS.InvokeAsync<string?>("readClipboardText");
        }
        catch { /* permission denied or unsupported — fall through to NoResult */ }

        await ProcessClipboardText(clip);
    }

    private void CancelImportResult()
    {
        showImportResult = false;
        importStatus = ImportStatus.Reading;
        pendingImportResult = null;
        pendingImportLookup = null;
    }

    private static readonly System.Text.RegularExpressions.Regex ResultPayloadRegex
        = new(@"r=([A-Za-z0-9_\-]+)", System.Text.RegularExpressions.RegexOptions.Compiled);

    private async Task ProcessClipboardText(string? text)
    {
        var raw = (text ?? "").Trim();
        if (raw.Length == 0)
        {
            importStatus = ImportStatus.NoResult;
            StateHasChanged();
            return;
        }

        // URL-decode in case the user copied something with %23 (encoded #) etc.
        var decoded = Uri.UnescapeDataString(raw);

        // Detect scoring-invite URLs (they have #p=…) so we can show a clear message instead
        // of generic "no result link".
        if (decoded.Contains("#p=", StringComparison.Ordinal) || decoded.Contains("?p=", StringComparison.Ordinal))
        {
            importStatus = ImportStatus.NotResultLink;
            StateHasChanged();
            return;
        }

        // Extract the payload: try `r=<base64url>` first, then fall back to treating the
        // whole string as the bare payload (for users who copied just the fragment).
        var match = ResultPayloadRegex.Match(decoded);
        var payload = match.Success ? match.Groups[1].Value : decoded;

        var parsed = ScoringPayloadCodec.DecodeResult(payload);
        if (parsed == null || parsed.Scores == null || parsed.Scores.Count < 3 || parsed.Scores.Count > 4)
        {
            importStatus = ImportStatus.NoResult;
            StateHasChanged();
            return;
        }

        var lookup = await ScoreImport.FindAsync(parsed);
        if (lookup == null)
        {
            importStatus = ImportStatus.NoMatchingTable;
            pendingImportResult = parsed;
            StateHasChanged();
            return;
        }

        pendingImportResult = parsed;
        pendingImportLookup = lookup;
        // If the target already has scores, surface that in the preview view so the user
        // knows the Apply button overwrites.
        importStatus = lookup.Table.Score != null
                       && lookup.Table.Score.PlayerScores.Any(p => !p.IsVirtual && p.EndPoints.HasValue)
            ? ImportStatus.AlreadyScored
            : ImportStatus.Preview;
        StateHasChanged();
    }

    private async Task ApplyImportPreview(bool confirmOverwrite)
    {
        if (pendingImportResult == null) return;

        var outcome = await ScoreImport.ApplyAsync(pendingImportResult, Lang.Get, confirmOverwrite);
        if (!outcome.Success)
        {
            importStatus = outcome.Reason == ScoreImportService.FailureReason.AlreadyScored
                ? ImportStatus.AlreadyScored
                : ImportStatus.NoMatchingTable;
            StateHasChanged();
            return;
        }

        importStatus = ImportStatus.Applied;

        // Refresh local view so the Scores/Rankings tabs reflect the imported values.
        var allHanchans = await SessionService.GetAllAsync();
        hanchansOnDate = allHanchans.Where(s => s.Date.Date == sessionDate.Date).ToList();
        if (currentHanchan != null && outcome.Hanchan?.Id == currentHanchan.Id)
        {
            currentHanchan = outcome.Hanchan;
            tables = currentHanchan.Tables;
            // Bump the @key so each rendered ScoreTable rebuilds with the fresh model.
            scoreTableVersion++;
        }

        StateHasChanged();
    }

    private async Task<(string url, string title)?> BuildScoringInviteUrl(TableAssignment table)
    {
        if (!externalScoringEnabled)
        {
            Nav.NavigateTo("settings");
            return null;
        }
        if (currentHanchan == null)
        {
            // Defensive: save the hanchan first so the invite has a stable Id to round-trip.
            await SaveHanchan();
            if (currentHanchan == null) return null;
        }

        var names = table.PlayerIds.Select(GetPlayerName).ToList();
        var uma = table.PlayerCount == 3 ? uma3Players : uma4Players;
        var title = $"{Lang.FormatDate(sessionDate)} — {BuildHanchanSubtitle()} — {Lang.Get("Table")} {table.TableNumber}";

        // Carry the full base (origin + subpath, e.g. "https://example.com/MahjongIndeler/")
        // so the scoring app's return URL hits this organizer deployment, not the host root.
        var organizerOrigin = Nav.BaseUri.TrimEnd('/');
        var invite = new ScoringInvite(
            currentHanchan.Id,
            table.TableNumber,
            names,
            new List<Guid>(table.PlayerIds),
            weeklyStartingPoints,
            new List<int>(uma),
            title,
            organizerOrigin);

        var encoded = ScoringPayloadCodec.EncodeInvite(invite);
        var url = $"{ScoringAppConfig.DeployedUrl.TrimEnd('/')}/score#p={encoded}";
        return (url, title);
    }

