    private int? GetHistorySessionNumber(Hanchan session)
    {
        if (historySessions == null) return null;
        var sameDateSessions = historySessions.Where(s => s.Date.Date == session.Date.Date).ToList();
        if (sameDateSessions.Count <= 1) return null;
        var ordered = sameDateSessions.OrderBy(s => s.StartTime ?? TimeSpan.Zero).ToList();
        return ordered.IndexOf(session) + 1;
    }

