    private async Task SaveHanchan()
    {
        if (IsLockedPastSession) return;

        var hanchan = new Hanchan
        {
            Date = sessionDate,
            StartTime = hanchanStartTime,
            PresentMemberIds = presentIds.ToList(),
            AbsentMemberIds = activeMembers
                .Where(m => !presentIds.Contains(m.Id))
                .Select(m => m.Id)
                .ToList(),
            Tables = tables,
            IsFinalized = true,
            ExcludeFromOptimization = excludeFromOptimization
        };

        if (currentHanchan != null)
            hanchan.Id = currentHanchan.Id;

        await SessionService.SaveAsync(hanchan);
        currentHanchan = hanchan;

        // Propagate the ExcludeFromOptimization flag to all other hanchans on the same date,
        // so the flag is effectively per-date.
        var allHanchans = await SessionService.GetAllAsync();
        foreach (var other in allHanchans.Where(s =>
                     s.Id != hanchan.Id &&
                     s.Date.Date == sessionDate.Date &&
                     s.ExcludeFromOptimization != excludeFromOptimization))
        {
            other.ExcludeFromOptimization = excludeFromOptimization;
            await SessionService.SaveAsync(other);
        }

        // Refresh the session list for this date
        allHanchans = await SessionService.GetAllAsync();
        hanchansOnDate = allHanchans.Where(s => s.Date.Date == sessionDate.Date).ToList();

        saved = true;
        attendanceExpanded = false;
    }

