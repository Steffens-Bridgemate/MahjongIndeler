    private record AllScoresEntry(string Label, TableAssignment Table);
    private record AllScoresTableGroup(int TableNumber, List<AllScoresEntry> Entries);

    private List<AllScoresTableGroup> BuildAllScoresEntries()
    {
        var orderedHanchans = hanchansOnDate
            .Where(h => h.Tables.Count > 0)
            .OrderBy(h => h.StartTime ?? TimeSpan.Zero)
            .ToList();

        var allTableNumbers = orderedHanchans
            .SelectMany(h => h.Tables.Select(t => t.TableNumber))
            .Distinct()
            .OrderBy(n => n)
            .ToList();

        var result = new List<AllScoresTableGroup>();
        foreach (var tableNum in allTableNumbers)
        {
            var entries = new List<AllScoresEntry>();
            for (int i = 0; i < orderedHanchans.Count; i++)
            {
                var h = orderedHanchans[i];
                var table = h.Tables.FirstOrDefault(t => t.TableNumber == tableNum);
                if (table == null) continue;
                var timeStr = h.StartTime is { } st ? st.ToString(@"hh\:mm") : "";
                var label = orderedHanchans.Count > 1 ? $"{Lang.Get("Hanchan")} #{i + 1} {timeStr}".Trim() : timeStr;
                entries.Add(new AllScoresEntry(label, table));
            }
            if (entries.Count > 0)
                result.Add(new AllScoresTableGroup(tableNum, entries));
        }
        return result;
    }

    private async Task SaveAllScores()
    {
        foreach (var h in hanchansOnDate)
            await SessionService.SaveAsync(h);
    }

    private List<RankingTable.RankingEntry> BuildWeeklyRankings()
    {
        var orderedHanchans = hanchansOnDate
            .Where(h => h.Tables.Any(t => t.Score != null))
            .OrderBy(h => h.StartTime ?? TimeSpan.Zero)
            .ToList();

        var hanchans = orderedHanchans.Select((h, i) =>
        {
            var timeStr = h.StartTime is { } st ? st.ToString(@"hh\:mm") : "";
            var label = orderedHanchans.Count > 1 ? $"#{i + 1} {timeStr}".Trim() : timeStr;
            return (Label: label, Tables: h.Tables);
        }).ToList();

        return RankingTable.BuildRankings(hanchans, GetPlayerName);
    }

    private (string html, string text) BuildRankingsContent()
    {
        var entries = BuildWeeklyRankings();
        var dateText = Lang.FormatDate(sessionDate);
        var title = $"{Lang.Get("Rankings")} — {dateText}";

        var html = new System.Text.StringBuilder();
        var text = new System.Text.StringBuilder();

        html.Append($"<div style=\"font-family:Verdana,sans-serif;font-size:14px;font-weight:bold;margin-bottom:8px;\">{title}</div>");
        text.AppendLine($"*{title}*");
        text.AppendLine();

        var hanchanLabels = entries.Count > 0 ? entries[0].HanchanScores.Select(h => h.Label).ToList() : new List<string>();

        html.Append("<table style=\"border-collapse:collapse;font-family:Verdana,sans-serif;font-size:12px;\">");
        html.Append("<thead><tr>");
        html.Append($"<th style=\"border:1px solid #999;padding:4px 8px;background:#f5f5f5;\">{Lang.Get("Rank")}</th>");
        html.Append($"<th style=\"border:1px solid #999;padding:4px 8px;background:#f5f5f5;\">{Lang.Get("Name")}</th>");
        html.Append($"<th style=\"border:1px solid #999;padding:4px 8px;background:#f5f5f5;text-align:center;\">{Lang.Get("TotalScore")}</th>");
        foreach (var label in hanchanLabels)
            html.Append($"<th style=\"border:1px solid #999;padding:4px 8px;background:#f5f5f5;text-align:center;\">{label}</th>");
        html.Append("</tr></thead><tbody>");

        // Plain-text variant uses fixed-width column padding wrapped in WhatsApp/Markdown
        // monospace fences (```). Names are clipped to 20 chars so columns stay aligned on phones.
        const int NameWidth = 20;
        const int ScoreWidth = 6;
        const int RankWidth = 3;
        int hanchanWidth = Math.Max(ScoreWidth, hanchanLabels.Count > 0 ? hanchanLabels.Max(l => l.Length) : ScoreWidth);

        string Clip(string s, int w) => s.Length <= w ? s : s.Substring(0, w);
        string PadR(string s, int w) => Clip(s, w).PadRight(w);
        string PadL(string s, int w) => Clip(s, w).PadLeft(w);

        var textLines = new List<string>();
        var header = PadL(Lang.Get("Rank"), RankWidth)
                     + " " + PadR(Lang.Get("Name"), NameWidth)
                     + " " + PadL(Lang.Get("TotalScore"), ScoreWidth);
        foreach (var label in hanchanLabels)
            header += " " + PadL(label, hanchanWidth);
        textLines.Add(header);
        textLines.Add(new string('-', header.Length));

        int rank = 1;
        foreach (var entry in entries)
        {
            html.Append("<tr>");
            html.Append($"<td style=\"border:1px solid #999;padding:4px 8px;\">{rank}</td>");
            html.Append($"<td style=\"border:1px solid #999;padding:4px 8px;\">{entry.Name}</td>");
            html.Append($"<td style=\"border:1px solid #999;padding:4px 8px;text-align:center;font-weight:bold;\">{FormatScore(entry.Total)}</td>");
            foreach (var hs in entry.HanchanScores)
            {
                var cell = hs.Score.HasValue ? FormatScore(hs.Score.Value) : "—";
                html.Append($"<td style=\"border:1px solid #999;padding:4px 8px;text-align:center;\">{cell}</td>");
            }
            html.Append("</tr>");

            var line = PadL(rank.ToString(), RankWidth)
                       + " " + PadR(entry.Name, NameWidth)
                       + " " + PadL(FormatScore(entry.Total), ScoreWidth);
            foreach (var hs in entry.HanchanScores)
                line += " " + PadL(hs.Score.HasValue ? FormatScore(hs.Score.Value) : "-", hanchanWidth);
            textLines.Add(line);
            rank++;
        }
        html.Append("</tbody></table>");

        text.AppendLine("```");
        foreach (var line in textLines)
            text.AppendLine(line);
        text.AppendLine("```");

        return (html.ToString(), text.ToString().TrimEnd());
    }

    private static string FormatScore(int value) => (value / 1000.0).ToString("+0.0;-0.0;0.0");

