@page "/history"
@using Tsump.Models
@using Tsump.Services
@inject SessionService SessionService
@inject MemberService MemberService
@inject LanguageService Lang
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>@Lang.Get("SessionHistory") - Tsumo!</PageTitle>

<h1><i class="bi bi-clock-history me-2"></i>@Lang.Get("SessionHistory")</h1>

@if (sessions == null)
{
    <p>@Lang.Get("Loading")</p>
}
else if (sessions.Count == 0)
{
    <p class="text-muted">@Lang.Get("NoSessionsYet") <a href="session">@Lang.Get("CreateFirstSession")</a>.</p>
}
else
{
    <div class="accordion" id="historyAccordion">
        @foreach (var session in sessions.OrderByDescending(s => s.Date).ThenByDescending(s => s.StartTime ?? TimeSpan.Zero))
        {
            var collapseId = $"collapse-{session.Id:N}";
            var headingId = $"heading-{session.Id:N}";
            var tableWord = session.Tables.Count == 1 ? Lang.Get("table") : Lang.Get("tables");
            var sessionNumber = GetSessionNumber(session);
            var timeStr = session.StartTime.HasValue ? session.StartTime.Value.ToString(@"hh\:mm") : "";
            <div class="accordion-item">
                <h2 class="accordion-header d-flex align-items-center" id="@headingId">
                    <button class="accordion-button collapsed flex-grow-1" type="button"
                            data-bs-toggle="collapse" data-bs-target="#@collapseId">
                        @Lang.FormatDate(session.Date)@(sessionNumber.HasValue ? $" #{sessionNumber}" : "")@(timeStr != "" ? $" ({timeStr})" : "") &mdash;
                        @session.PresentMemberIds.Count @Lang.Get("present"),
                        @session.Tables.Count @tableWord
                        @if (session.ExcludeFromOptimization)
                        {
                            <span class="badge bg-secondary ms-2">@Lang.Get("ExcludedFromOptimization")</span>
                        }
                    </button>
                    <button class="btn btn-sm btn-outline-primary me-2" title="@Lang.Get("GoTo")" @onclick="() => GoToSession(session.Date)">
                        <i class="bi bi-arrow-right"></i>
                    </button>
                </h2>
                <div id="@collapseId" class="accordion-collapse collapse" data-bs-parent="#historyAccordion">
                    <div class="accordion-body">
                        <h6>@Lang.Get("PresentPlayers")</h6>
                        <div class="mb-3">
                            @foreach (var playerId in session.PresentMemberIds)
                            {
                                var name = GetMemberName(playerId);
                                <span class="badge bg-success me-1 mb-1">@name</span>
                            }
                        </div>

                        @if (session.AbsentMemberIds.Count > 0)
                        {
                            <h6>@Lang.Get("AbsentPlayers")</h6>
                            <div class="mb-3">
                                @foreach (var playerId in session.AbsentMemberIds)
                                {
                                    var name = GetMemberName(playerId);
                                    <span class="badge bg-secondary me-1 mb-1">@name</span>
                                }
                            </div>
                        }

                        @if (session.Tables.Count > 0)
                        {
                            <h6>@Lang.Get("TableAssignments")</h6>
                            <div class="row">
                                @foreach (var table in session.Tables)
                                {
                                    <div class="col-md-4 mb-2">
                                        <div class="card @(table.PlayerCount == 3 ? "border-warning" : "border-success")">
                                            <div class="card-header @(table.PlayerCount == 3 ? "bg-warning text-dark" : "bg-success text-white") py-1">
                                                @Lang.Get("Table") @table.TableNumber (@table.PlayerCount)
                                            </div>
                                            <ul class="list-group list-group-flush">
                                                @foreach (var pid in table.PlayerIds)
                                                {
                                                    <li class="list-group-item py-1">@GetMemberName(pid)</li>
                                                }
                                            </ul>
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        @if (deleteConfirmId == session.Id)
                        {
                            <div class="alert alert-danger d-inline-block mt-2 mb-0 py-1">
                                @Lang.Get("DeleteHanchanConfirm")
                                <button class="btn btn-sm btn-danger ms-2 me-1" @onclick="() => ConfirmDeleteSession(session.Id)">@Lang.Get("YesDelete")</button>
                                <button class="btn btn-sm btn-secondary" @onclick="CancelDelete">@Lang.Get("Cancel")</button>
                            </div>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-danger mt-2" @onclick="() => RequestDelete(session.Id)">
                                @Lang.Get("DeleteHanchan")
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="mt-4">
        <h4>@Lang.Get("PlayerStatistics")</h4>
        <table class="table table-sm table-striped">
            <thead>
                <tr>
                    <th style="cursor:pointer;" @onclick='() => SetSort("name")'>
                        @Lang.Get("Player") @SortIndicator("name")
                    </th>
                    <th style="cursor:pointer;" @onclick='() => SetSort("sessions")'>
                        @Lang.Get("SessionsAttended") @SortIndicator("sessions")
                    </th>
                    <th style="cursor:pointer;" @onclick='() => SetSort("three")'>
                        @Lang.Get("TimesAt3Table") @SortIndicator("three")
                    </th>
                    <th style="cursor:pointer;" @onclick='() => SetSort("threepct")'>
                        % @SortIndicator("threepct")
                    </th>
                    <th style="cursor:pointer;" @onclick='() => SetSort("four")'>
                        @Lang.Get("TimesAt4Table") @SortIndicator("four")
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var stat in SortedStats)
                {
                    <tr>
                        <td>@stat.Name</td>
                        <td>@stat.SessionsAttended</td>
                        <td>@stat.ThreePlayerCount</td>
                        <td>@(stat.SessionsAttended > 0 ? $"{Math.Round(100.0 * stat.ThreePlayerCount / stat.SessionsAttended):0}" : "")</td>
                        <td>@stat.FourPlayerCount</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Hanchan>? sessions;
    private List<Member> members = new();
    private List<PlayerStat> playerStats = new();
    private Guid? deleteConfirmId;
    private string sortColumn = "name";
    private bool sortDescending = false;
    private string? secondarySortColumn = null;
    private bool secondarySortDescending = false;

    private IEnumerable<PlayerStat> SortedStats
    {
        get
        {
            var ordered = ApplySort(playerStats.AsEnumerable(), sortColumn, sortDescending);
            if (secondarySortColumn != null && secondarySortColumn != sortColumn)
                ordered = ApplyThenSort(ordered, secondarySortColumn, secondarySortDescending);
            return ordered;
        }
    }

    private static IOrderedEnumerable<PlayerStat> ApplySort(IEnumerable<PlayerStat> source, string column, bool descending) => column switch
    {
        "sessions" => descending ? source.OrderByDescending(s => s.SessionsAttended) : source.OrderBy(s => s.SessionsAttended),
        "three"    => descending ? source.OrderByDescending(s => s.ThreePlayerCount)  : source.OrderBy(s => s.ThreePlayerCount),
        "threepct" => descending ? source.OrderByDescending(s => ThreePercentage(s))  : source.OrderBy(s => ThreePercentage(s)),
        "four"     => descending ? source.OrderByDescending(s => s.FourPlayerCount)   : source.OrderBy(s => s.FourPlayerCount),
        _          => descending ? source.OrderByDescending(s => s.Name)              : source.OrderBy(s => s.Name),
    };

    private static IOrderedEnumerable<PlayerStat> ApplyThenSort(IOrderedEnumerable<PlayerStat> source, string column, bool descending) => column switch
    {
        "sessions" => descending ? source.ThenByDescending(s => s.SessionsAttended) : source.ThenBy(s => s.SessionsAttended),
        "three"    => descending ? source.ThenByDescending(s => s.ThreePlayerCount)  : source.ThenBy(s => s.ThreePlayerCount),
        "threepct" => descending ? source.ThenByDescending(s => ThreePercentage(s))  : source.ThenBy(s => ThreePercentage(s)),
        "four"     => descending ? source.ThenByDescending(s => s.FourPlayerCount)   : source.ThenBy(s => s.FourPlayerCount),
        _          => descending ? source.ThenByDescending(s => s.Name)              : source.ThenBy(s => s.Name),
    };

    private static double ThreePercentage(PlayerStat s) =>
        s.SessionsAttended > 0 ? (double)s.ThreePlayerCount / s.SessionsAttended : 0;

    private void SetSort(string column)
    {
        if (sortColumn == column)
            sortDescending = !sortDescending;
        else
        {
            secondarySortColumn = sortColumn;
            secondarySortDescending = sortDescending;
            sortColumn = column;
            sortDescending = column != "name";
        }
    }

    private MarkupString SortIndicator(string column)
    {
        if (sortColumn == column)
            return new MarkupString($"<span class='text-primary'>{(sortDescending ? "▼" : "▲")}</span>");
        if (secondarySortColumn == column)
            return new MarkupString($"<span class='text-muted' style='font-size:0.75em;'>{(secondarySortDescending ? "▼" : "▲")}<sup>2</sup></span>");
        return new MarkupString("");
    }

    protected override void OnInitialized() => Lang.OnLanguageChanged += StateHasChanged;
    public void Dispose() => Lang.OnLanguageChanged -= StateHasChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            members = await MemberService.GetAllAsync();
            sessions = await SessionService.GetAllAsync();
            CalculateStats();
            StateHasChanged();
        }
    }

    private string GetMemberName(Guid id)
    {
        return members.FirstOrDefault(m => m.Id == id)?.Name ?? Lang.Get("Unknown");
    }

    private int? GetSessionNumber(Hanchan session)
    {
        if (sessions == null) return null;
        var sameDateSessions = sessions.Where(s => s.Date.Date == session.Date.Date).ToList();
        if (sameDateSessions.Count <= 1) return null;
        var ordered = sameDateSessions.OrderBy(s => s.StartTime ?? TimeSpan.Zero).ToList();
        return ordered.IndexOf(session) + 1;
    }

    private void CalculateStats()
    {
        if (sessions == null) return;

        var stats = new Dictionary<Guid, PlayerStat>();
        foreach (var member in members)
        {
            stats[member.Id] = new PlayerStat
            {
                Name = member.Name,
                ThreePlayerCount = member.ExtraThreePlayerTableCount
            };
        }

        foreach (var session in sessions.Where(s => !s.ExcludeFromOptimization))
        {
            foreach (var pid in session.PresentMemberIds)
            {
                if (stats.TryGetValue(pid, out var stat))
                    stat.SessionsAttended++;
            }

            foreach (var table in session.Tables)
            {
                foreach (var pid in table.PlayerIds)
                {
                    if (stats.TryGetValue(pid, out var stat))
                    {
                        if (table.PlayerCount == 3)
                            stat.ThreePlayerCount++;
                        else if (table.PlayerCount == 4)
                            stat.FourPlayerCount++;
                    }
                }
            }
        }

        playerStats = stats.Values.Where(s => s.SessionsAttended > 0).ToList();
    }

    private void GoToSession(DateTime date)
    {
        Nav.NavigateTo($"session?date={date:yyyy-MM-dd}");
    }

    private void RequestDelete(Guid id)
    {
        deleteConfirmId = id;
    }

    private void CancelDelete()
    {
        deleteConfirmId = null;
    }

    private async Task ConfirmDeleteSession(Guid id)
    {
        deleteConfirmId = null;
        await SessionService.DeleteAsync(id);
        sessions = await SessionService.GetAllAsync();
        CalculateStats();
    }

    private class PlayerStat
    {
        public string Name { get; set; } = "";
        public int SessionsAttended { get; set; }
        public int ThreePlayerCount { get; set; }
        public int FourPlayerCount { get; set; }
    }
}
