@page "/matrix"
@using Tsump.Models
@using Tsump.Services
@inject SessionService SessionService
@inject MemberService MemberService
@inject LanguageService Lang
@implements IDisposable

<PageTitle>@Lang.Get("MeetingMatrixTitle") - Tsumo!</PageTitle>

<h1><i class="bi bi-grid-3x3-gap me-2"></i>@Lang.Get("MeetingMatrixTitle")</h1>
<p class="text-muted">@Lang.Get("MeetingMatrixSubtitle")</p>

@if (members == null)
{
    <p>@Lang.Get("Loading")</p>
}
else if (activePlayers.Count == 0)
{
    <p class="text-muted">@Lang.Get("NoSessionData")</p>
}
else
{
    <div class="mb-3">
        <table class="table table-bordered table-sm" style="width:auto;">
            <thead>
                <tr>
                    <th class="text-center">@Lang.Get("Meetings")</th>
                    <th class="text-center">@Lang.Get("Pairs")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in meetingDistribution)
                {
                    var count = entry.Key;
                    <tr class="@(highlightedMeetingCount == count ? "table-primary" : "")"
                        style="cursor:pointer;"
                        @onclick="() => ToggleHighlight(count)">
                        <td class="text-center @GetCellClass(count)">@count</td>
                        <td class="text-center">@entry.Value</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-sm meeting-matrix">
            <thead>
                <tr>
                    <th class="sticky-col"></th>
                    @foreach (var player in activePlayers)
                    {
                        <th class="text-center rotate-header">
                            <div><span>@player.Name</span></div>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in activePlayers)
                {
                    <tr>
                        <td class="sticky-col fw-bold text-nowrap">@row.Name</td>
                        @foreach (var col in activePlayers)
                        {
                            @if (row.Id == col.Id)
                            {
                                <td class="text-center bg-dark text-white">&mdash;</td>
                            }
                            else
                            {
                                var key = MakeKey(row.Id, col.Id);
                                var count = matrix.GetValueOrDefault(key, 0);
                                <td class="text-center @GetMatrixCellClass(count)">@count</td>
                            }
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<style>
    .meeting-matrix {
        font-size: 0.8rem;
    }

    .meeting-matrix th.rotate-header {
        height: 120px;
        white-space: nowrap;
        vertical-align: bottom;
        padding: 0 4px;
    }

    .meeting-matrix th.rotate-header > div {
        transform: rotate(-60deg);
        transform-origin: left bottom;
        width: 1.5em;
        margin-left: 0.7em;
    }

    .meeting-matrix th.rotate-header > div > span {
        display: inline-block;
        padding-bottom: 4px;
    }

    .meeting-matrix td, .meeting-matrix th {
        padding: 2px 4px;
        min-width: 28px;
    }

    .sticky-col {
        position: sticky;
        left: 0;
        background: white;
        z-index: 1;
    }

    .matrix-low {
        background-color: #d4edda;
        color: #155724;
    }

    .matrix-mid {
        background-color: #fff3cd;
        color: #856404;
    }

    .matrix-high {
        background-color: #f8d7da;
        color: #721c24;
    }

    .cell-zero {
        background-color: #f8f9fa;
        color: #adb5bd;
    }

    .cell-low {
        background-color: #d4edda;
    }

    .cell-mid {
        background-color: #fff3cd;
    }

    .cell-high {
        background-color: #f8d7da;
    }

    .cell-highlight {
        background-color: #0d6efd !important;
        color: #fff !important;
        font-weight: bold;
    }

    .cell-dimmed {
        opacity: 0.25;
    }
</style>

@code {
    private List<Member>? members;
    private List<Member> activePlayers = new();
    private Dictionary<string, int> matrix = new();
    private List<KeyValuePair<int, int>> meetingDistribution = new();
    private int? highlightedMeetingCount;

    protected override void OnInitialized() => Lang.OnLanguageChanged += StateHasChanged;
    public void Dispose() => Lang.OnLanguageChanged -= StateHasChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            members = await MemberService.GetAllAsync();
            var sessions = (await SessionService.GetAllAsync()).Where(s => !s.ExcludeFromOptimization).ToList();
            BuildMatrix(sessions);
            StateHasChanged();
        }
    }

    private void BuildMatrix(List<Hanchan> sessions)
    {
        var attendedIds = new HashSet<Guid>(
            sessions.SelectMany(s => s.PresentMemberIds));

        activePlayers = members!
            .Where(m => attendedIds.Contains(m.Id))
            .OrderBy(m => m.Name)
            .ToList();

        matrix.Clear();

        foreach (var session in sessions)
        {
            foreach (var table in session.Tables)
            {
                for (int i = 0; i < table.PlayerIds.Count; i++)
                {
                    for (int j = i + 1; j < table.PlayerIds.Count; j++)
                    {
                        var key = MakeKey(table.PlayerIds[i], table.PlayerIds[j]);
                        matrix[key] = matrix.GetValueOrDefault(key, 0) + 1;
                    }
                }
            }
        }

        // Build distribution: count pairs per number of meetings
        var n = activePlayers.Count;
        var totalPairs = n * (n - 1) / 2;
        var metPairs = matrix.Count(kv => kv.Value > 0);
        var zeroPairs = totalPairs - metPairs;

        var dist = new Dictionary<int, int>();
        if (zeroPairs > 0)
            dist[0] = zeroPairs;
        foreach (var kv in matrix)
        {
            if (kv.Value > 0)
                dist[kv.Value] = dist.GetValueOrDefault(kv.Value) + 1;
        }
        meetingDistribution = dist.OrderBy(kv => kv.Key).ToList();
    }

    private static string MakeKey(Guid a, Guid b)
    {
        return string.Compare(a.ToString(), b.ToString(), StringComparison.Ordinal) < 0
            ? $"{a}_{b}"
            : $"{b}_{a}";
    }

    private void ToggleHighlight(int count)
    {
        highlightedMeetingCount = highlightedMeetingCount == count ? null : count;
    }

    private string GetMatrixCellClass(int count)
    {
        if (highlightedMeetingCount.HasValue)
            return count == highlightedMeetingCount.Value ? "cell-highlight" : "cell-dimmed";
        return GetCellClass(count);
    }

    private static string GetCellClass(int count) => count switch
    {
        0 => "cell-zero",
        <= 2 => "cell-low",
        <= 5 => "cell-mid",
        _ => "cell-high"
    };
}
