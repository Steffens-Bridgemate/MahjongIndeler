@inherits LayoutComponentBase
@using Tsump.Models
@using Tsump.Services
@using Microsoft.JSInterop
@inject LanguageService Lang
@inject SettingsService SettingsService
@inject IJSRuntime JS
@implements IDisposable

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            @* Keep the language buttons as one flex unit so the narrow-screen space-between can't
               split them. When the primary language IS English, show a single (selected) button —
               a reminder that the language is configurable in Settings. *@
            <div class="d-flex gap-1">
                @if (Lang.PrimaryLanguage != "en")
                {
                    <button class="btn btn-sm @(Lang.Language == Lang.PrimaryLanguage ? "btn-primary" : "btn-outline-secondary") d-flex align-items-center gap-1"
                            @onclick="() => SetLanguage(Lang.PrimaryLanguage)">
                        <FlagIcon Code="@Lang.PrimaryLanguage" /><span>@Lang.PrimaryLanguage.ToUpper()</span>
                    </button>
                }
                <button class="btn btn-sm @(Lang.IsEnglish ? "btn-primary" : "btn-outline-secondary") d-flex align-items-center gap-1"
                        @onclick='() => SetLanguage("en")'>
                    <FlagIcon Code="en" /><span>EN</span>
                </button>
            </div>
            @if (!string.IsNullOrWhiteSpace(style.WebsiteUrl))
            {
                <a href="@style.WebsiteUrl" target="_blank">@(string.IsNullOrWhiteSpace(style.WebsiteLabel) ? style.WebsiteUrl : style.WebsiteLabel)</a>
            }
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<AppUpdateBanner />

@code {
    private ClubStyle style = new();

    protected override void OnInitialized()
    {
        Lang.OnLanguageChanged += StateHasChanged;
        SettingsService.OnChanged += OnSettingsChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadAndApplyStyle();
        }
    }

    private async Task LoadAndApplyStyle()
    {
        var settings = await SettingsService.GetAsync();
        style = settings.Style;
        // Set the club's primary language; the active display language follows it on each load
        // (the top-row toggle to English is session-only).
        Lang.Configure(settings.PrimaryLanguage);
        await JS.InvokeVoidAsync("applyClubStyle", style.PrimaryColor, style.LinkColor);
        StateHasChanged();
    }

    // Settings saved elsewhere (the Style tab) — re-read the link and re-apply colours.
    private async void OnSettingsChanged()
    {
        await LoadAndApplyStyle();
    }

    private void SetLanguage(string lang)
    {
        Lang.SetLanguage(lang);
    }

    public void Dispose()
    {
        Lang.OnLanguageChanged -= StateHasChanged;
        SettingsService.OnChanged -= OnSettingsChanged;
    }
}
