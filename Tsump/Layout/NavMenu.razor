@using Tsump.Models
@using Tsump.Services
@using Microsoft.AspNetCore.Components.Routing
@inject LanguageService Lang
@inject AppModeService Mode
@inject SettingsService SettingsService
@inject NavigationManager Nav
@inject TournamentNavContext TournamentNav
@inject ContextNavService Ctx
@implements IDisposable

<div class="top-row ps-3 navbar navbar-light">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            @if (!string.IsNullOrWhiteSpace(style.LogoImage))
            {
                <img src="@style.LogoImage" alt="@style.BrandText" />
            }
            else
            {
                <span>@style.BrandText</span>
            }
            <span class="text-muted" style="font-size: 0.6em;">v@(Tsump.AppVersion.Version)</span>
        </a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        @if (Ctx.Entries.Count > 0)
        {
            @* Page-supplied contextual nav (e.g. the weekly session): the owning page builds these
               entries from its own state and handlers, and clears them on leaving. *@
            @foreach (var entry in Ctx.Entries)
            {
                var e = entry;
                <div class="nav-item px-3">
                    @if (e.Href is { } href)
                    {
                        <NavLink class="nav-link" href="@href">
                            @if (e.IconClass is { } ic) { <span class="bi @ic" aria-hidden="true"></span> }
                            else if (e.StatusClass is { } sc) { <span class="nav-status-dot @sc"></span> }
                            @e.Label
                        </NavLink>
                    }
                    else if (e.Disabled)
                    {
                        <a class="nav-link disabled" aria-disabled="true">
                            @if (e.IconClass is { } ic) { <span class="bi @ic" aria-hidden="true"></span> }
                            else if (e.StatusClass is { } sc) { <span class="nav-status-dot @sc"></span> }
                            @e.Label
                        </a>
                    }
                    else
                    {
                        <a class="nav-link @(e.IsActive ? "active" : "")" href="javascript:void(0)"
                           @onclick="@(() => InvokeSelect(e))">
                            @if (e.IconClass is { } ic) { <span class="bi @ic" aria-hidden="true"></span> }
                            else if (e.StatusClass is { } sc) { <span class="nav-status-dot @sc"></span> }
                            @e.Label
                            @if (e.OnExplain is not null)
                            {
                                <span class="nav-explain" @onclick:stopPropagation="true"
                                      @onclick="@(() => InvokeExplain(e))">?</span>
                            }
                        </a>
                    }
                </div>
            }
        }
        else if (CurrentTournamentId is Guid tid)
        {
            @* Inside a tournament the sidebar becomes the tournament's own sub-nav; "Back to
               tournaments" returns to the general menu. Guidesheets/Rankings stay disabled until the
               tournament is generated (TournamentNavContext, kept fresh by the pages). *@
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="tournaments">
                    <span class="bi bi-trophy-fill-nav-menu" aria-hidden="true"></span> @Lang.Get("Tournaments")
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@($"tournament/{tid}/participants")">
                    <span class="bi bi-people-fill-nav-menu" aria-hidden="true"></span> @Lang.Get("TournamentParticipants")
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@($"tournament/{tid}")" Match="NavLinkMatch.All">
                    <span class="bi bi-table-nav-menu" aria-hidden="true"></span> @Lang.Get("TournamentAssignments")
                </NavLink>
            </div>
            <div class="nav-item px-3">
                @if (TournamentGenerated(tid))
                {
                    <NavLink class="nav-link" href="@($"tournament/{tid}/guidesheets")">
                        <span class="bi bi-card-checklist-nav-menu" aria-hidden="true"></span> @Lang.Get("TournamentGuidesheets")
                    </NavLink>
                }
                else
                {
                    <a class="nav-link disabled" aria-disabled="true">
                        <span class="bi bi-card-checklist-nav-menu" aria-hidden="true"></span> @Lang.Get("TournamentGuidesheets")
                    </a>
                }
            </div>
            <div class="nav-item px-3">
                @if (TournamentGenerated(tid))
                {
                    <NavLink class="nav-link" href="@($"tournament/{tid}/rankings")">
                        <span class="bi bi-bar-chart-fill-nav-menu" aria-hidden="true"></span> @Lang.Get("Rankings")
                    </NavLink>
                }
                else
                {
                    <a class="nav-link disabled" aria-disabled="true">
                        <span class="bi bi-bar-chart-fill-nav-menu" aria-hidden="true"></span> @Lang.Get("Rankings")
                    </a>
                }
            </div>
        }
        else
        {
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> @Lang.Get("Home")
            </NavLink>
        </div>

        @if (Mode.CurrentMode == AppMode.Weekly)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="workflow">
                    <span class="bi bi-card-checklist-nav-menu" aria-hidden="true"></span> @Lang.Get("Workflow")
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="members">
                    <span class="bi bi-people-fill-nav-menu" aria-hidden="true"></span> @Lang.Get("Members")
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="session">
                    <span class="bi bi-calendar-week-nav-menu" aria-hidden="true"></span> @Lang.Get("WeeklySession")
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="history">
                    <span class="bi bi-clock-history-nav-menu" aria-hidden="true"></span> @Lang.Get("History")
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="matrix">
                    <span class="bi bi-grid-3x3-gap-nav-menu" aria-hidden="true"></span> @Lang.Get("MeetingMatrix")
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="competition-ranking">
                    <span class="bi bi-bar-chart-fill-nav-menu" aria-hidden="true"></span> @Lang.Get("CompetitionRanking")
                </NavLink>
            </div>
        }
        else
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="tournaments">
                    <span class="bi bi-trophy-fill-nav-menu" aria-hidden="true"></span> @Lang.Get("Tournaments")
                </NavLink>
            </div>
        }

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="data">
                <span class="bi bi-database-nav-menu" aria-hidden="true"></span> @Lang.Get("DataManagement")
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="settings">
                <span class="bi bi-gear-fill-nav-menu" aria-hidden="true"></span> @Lang.Get("Settings")
            </NavLink>
        </div>
        @if (scanLoggingEnabled)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="scan-log">
                    <span class="bi bi-card-list-nav-menu" aria-hidden="true"></span> @Lang.Get("ScanLog")
                </NavLink>
            </div>
        }
        }
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;
    private bool scanLoggingEnabled;
    private ClubStyle style = new();

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    // Tournament id from the current URL (the /tournament/{id}[/...] sub-pages). Drives whether the
    // sidebar shows the tournament sub-nav; null on every other route.
    private Guid? CurrentTournamentId
    {
        get
        {
            var path = Nav.ToBaseRelativePath(Nav.Uri);
            var cut = path.IndexOfAny(new[] { '?', '#' });
            if (cut >= 0) path = path[..cut];
            var segs = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
            return segs.Length >= 2 && segs[0] == "tournament" && Guid.TryParse(segs[1], out var id)
                ? id : null;
        }
    }

    // Only trust the generated flag when it's for the tournament we're actually showing.
    private bool TournamentGenerated(Guid id) => TournamentNav.Id == id && TournamentNav.IsGenerated;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Mode.LoadAsync();
            await RefreshScanLogging();
            StateHasChanged();
        }
    }

    protected override void OnInitialized()
    {
        Lang.OnLanguageChanged += StateHasChanged;
        Mode.OnModeChanged += StateHasChanged;
        SettingsService.OnChanged += OnSettingsChanged;
        Nav.LocationChanged += OnLocationChanged;
        TournamentNav.OnChanged += OnContextChanged;
        Ctx.OnChanged += OnContextChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);
    private void OnContextChanged() => InvokeAsync(StateHasChanged);

    private async Task InvokeSelect(ContextNavEntry e) { if (e.OnSelect != null) await e.OnSelect(); }
    private async Task InvokeExplain(ContextNavEntry e) { if (e.OnExplain != null) await e.OnExplain(); }

    // Re-read the logging flag when settings are saved so the Log item appears/disappears
    // without a page reload.
    private async void OnSettingsChanged()
    {
        await RefreshScanLogging();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshScanLogging()
    {
        var settings = await SettingsService.GetAsync();
        scanLoggingEnabled = settings.EnableScanLogging;
        style = settings.Style;
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    public void Dispose()
    {
        Lang.OnLanguageChanged -= StateHasChanged;
        Mode.OnModeChanged -= StateHasChanged;
        SettingsService.OnChanged -= OnSettingsChanged;
        Nav.LocationChanged -= OnLocationChanged;
        TournamentNav.OnChanged -= OnContextChanged;
        Ctx.OnChanged -= OnContextChanged;
    }
}
