@using Tsump.Models
@using Tsump.Scoring
@using Tsump.Services
@inject ScoreImportService ScoreImport
@inject ScanLogService ScanLog
@inject LanguageService Lang
@inject IJSRuntime JS
@implements IDisposable

@if (IsEnabled)
{
    <div class="mb-3">
        @if (!showPanel)
        {
            <button class="btn btn-outline-secondary" @onclick="OpenPanel">
                <i class="bi bi-box-arrow-in-down me-1"></i>@Lang.Get("ImportResult")
            </button>
        }
        else
        {
            <div class="card">
                <div class="card-header d-flex align-items-center">
                    <h6 class="mb-0 flex-grow-1">@Lang.Get("ImportResultPanelTitle")</h6>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ClosePanel">@Lang.Get("Close")</button>
                </div>
                <div class="card-body">
                    @if (status == ImportStatus.HandScanning)
                    {
                        @* Offscreen, focusable capture input for HID-scanner keystrokes / typing.
                           Uncontrolled: JS (attachScanCapture) accumulates the burst and hands the
                           complete scan to .NET in one OnScanComplete call, so a slow event loop
                           can't truncate it. Only present in this state. *@
                        <textarea @ref="scanInputRef" class="scan-capture-hidden" rows="1"
                                  autocomplete="off" aria-label="@Lang.Get("ReadyToScan")" />
                        <div class="text-center my-3" role="button" tabindex="-1"
                             @onclick="RefocusScanInput" title="@Lang.Get("ReadyToScan")">
                            <i class="bi bi-qr-code text-primary" style="font-size: 3rem; line-height: 1;"></i>
                            <div class="progress mt-3 mx-auto" style="height: 6px; max-width: 240px;">
                                @if (isScanning)
                                {
                                    @* Scanning: a fill that repeatedly grows left→right (~1s/cycle). *@
                                    <div class="progress-bar scan-fill"></div>
                                }
                                else
                                {
                                    @* Waiting: indeterminate striped sweep. *@
                                    <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 100%;"></div>
                                }
                            </div>
                            <div class="text-muted small mt-2">@(isScanning ? Lang.Get("ScanningNow") : Lang.Get("ReadyToScan"))</div>
                        </div>
                        <div class="text-center">
                            <button class="btn btn-outline-secondary" @onclick="ReturnToNeutral">
                                <i class="bi bi-x-lg me-1"></i>@Lang.Get("Cancel")
                            </button>
                        </div>
                    }
                    else if (status == ImportStatus.Preview || status == ImportStatus.AlreadyScored)
                    {
                        @if (pendingLookup != null)
                        {
                            var pl = pendingLookup.Context;
                            var headerClass = pl.Table.PlayerCount == 3 ? "bg-warning text-dark" : "bg-success text-white";
                            <div class="@headerClass py-1 px-2 mb-2 rounded">
                                @pl.DisplayLabel
                                <span class="ms-1">(@pl.Table.PlayerCount @Lang.Get("players"))</span>
                            </div>
                        }
                        <p>@Lang.Get("ImportScoreConfirm")</p>

                        @if (status == ImportStatus.AlreadyScored)
                        {
                            <div class="alert alert-warning py-2 mb-2">@Lang.Get("ImportScoreOverwriteWarning")</div>
                        }

                        <table class="table table-sm table-bordered" style="max-width:500px;">
                            <thead>
                                <tr>
                                    <th>@Lang.Get("Player")</th>
                                    <th class="text-end">@Lang.Get("EndShort")</th>
                                    <th class="text-end">@Lang.Get("LoanShort")</th>
                                    <th class="text-end">@Lang.Get("PenaltyShort")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @* Position-based: row i of the result applies to the i-th
                                   non-virtual PlayerId on the matched table. *@
                                @for (int i = 0; i < pendingResult!.Scores.Count; i++)
                                {
                                    var s = pendingResult.Scores[i];
                                    var pids = pendingLookup!.Context.Table.PlayerIds;
                                    var playerName = i < pids.Count ? ResolveName(pids[i]) : "—";
                                    var end = s[ScoringPayloadCodec.ScoreEndPoints];
                                    var loan = s[ScoringPayloadCodec.ScoreLoan];
                                    var pen = s[ScoringPayloadCodec.ScorePenalty];
                                    <tr>
                                        <td>@playerName</td>
                                        <td class="text-end">@FormatPoints(end)</td>
                                        <td class="text-end">@(loan != 0 ? FormatPoints(loan) : "")</td>
                                        <td class="text-end">@(pen != 0 ? FormatPoints(pen) : "")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <button class="btn btn-success me-2" @onclick="() => Apply(confirmOverwrite: true)">
                            <i class="bi bi-check2 me-1"></i>@(status == ImportStatus.AlreadyScored ? Lang.Get("YesOverwrite") : Lang.Get("ImportScoreApply"))
                        </button>
                        <button class="btn btn-outline-secondary" @onclick="ReturnToNeutral">@Lang.Get("Cancel")</button>
                    }
                    else if (status == ImportStatus.Scanning)
                    {
                        <p class="text-muted small mb-2">@Lang.Get("ScanQrHint")</p>
                        <div id="qr-scanner-view" style="max-width:480px; width:100%; margin:0 auto;"></div>

                        <div class="d-flex align-items-center mt-2 small">
                            <div class="spinner-border spinner-border-sm text-primary me-2" role="status" aria-hidden="true"></div>
                            <span class="text-muted">
                                @Lang.Get("ScanLooking")
                                @if (scanElapsedSeconds >= 1)
                                {
                                    <span class="ms-1">(@scanElapsedSeconds s)</span>
                                }
                            </span>
                        </div>

                        @if (scanElapsedSeconds >= 8)
                        {
                            <div class="alert alert-info py-2 mt-2 mb-2 small">@Lang.Get("ScanStillLooking")</div>
                        }

                        <ul class="text-muted small mt-2 mb-2 ps-3">
                            <li>@Lang.Get("ScanTipFraming")</li>
                            <li>@Lang.Get("ScanTipFocus")</li>
                            <li>@Lang.Get("ScanTipLight")</li>
                            @if (scanElapsedSeconds >= 8)
                            {
                                <li>@Lang.Get("ScanTipLaptop")</li>
                            }
                        </ul>

                        <button class="btn btn-outline-secondary" @onclick="ReturnToNeutral">
                            <i class="bi bi-x-lg me-1"></i>@Lang.Get("Cancel")
                        </button>
                    }
                    else if (status == ImportStatus.FileDecoding)
                    {
                        <div class="d-flex align-items-center small">
                            <div class="spinner-border spinner-border-sm text-primary me-2" role="status" aria-hidden="true"></div>
                            <span class="text-muted">@Lang.Get("FileDecoding")</span>
                        </div>
                    }
                    else if (status == ImportStatus.Applied)
                    {
                        <div class="alert alert-success py-2 mb-2">@Lang.Get("ImportScoreApplied")</div>
                        @if (method == InputMethod.Clipboard)
                        {
                            @* Clipboard: wait for the user. "Next" repeats the clipboard read and is
                               focused so the Enter key triggers it. *@
                            <div class="d-flex flex-wrap gap-2">
                                <button class="btn btn-primary" @ref="nextButtonRef" @onclick="StartClipboard">
                                    <i class="bi bi-arrow-right-circle me-1"></i>@Lang.Get("Next")
                                </button>
                                <button class="btn btn-outline-secondary" @onclick="ReturnToNeutral">@Lang.Get("Cancel")</button>
                            </div>
                        }
                        else
                        {
                            @* Camera / hand-scanner / image: the banner shows briefly, then the panel
                               auto-continues (restart camera, re-arm hand scanner, or back to neutral). *@
                            <p class="text-muted small mb-0">@Lang.Get("ReadyToScan")</p>
                        }
                    }
                    else
                    {
                        @* Neutral + error states: optional banner, then the four method buttons. *@
                        @if (status == ImportStatus.NotResultLink)
                        {
                            <div class="alert alert-warning py-2 mb-2">@Lang.Get("ImportResultErrorNotResult")</div>
                        }
                        else if (status == ImportStatus.NoResult)
                        {
                            <div class="alert alert-warning py-2 mb-2">@Lang.Get("ImportResultNoneInClipboard")</div>
                        }
                        else if (status == ImportStatus.NoMatchingTable)
                        {
                            <div class="alert alert-warning py-2 mb-2">@Lang.Get("ImportResultNoMatchHint")</div>
                        }
                        else if (status == ImportStatus.ScanError)
                        {
                            <div class="alert alert-danger py-2 mb-2">@(scanErrorMessage ?? Lang.Get("ScanCameraError"))</div>
                        }
                        else if (status == ImportStatus.FileScanFailed)
                        {
                            <div class="alert alert-warning py-2 mb-2">@Lang.Get("FileScanNoQr")</div>
                        }
                        else if (status == ImportStatus.ScanTruncated)
                        {
                            <div class="alert alert-warning py-2 mb-2">@Lang.Get("ImportResultErrorTruncated")</div>
                        }
                        else
                        {
                            <p class="text-muted small mb-2">@Lang.Get("ImportChooseMethod")</p>
                        }

                        <div class="d-flex flex-wrap gap-2">
                            <button class="btn btn-outline-primary" @onclick="StartClipboard">
                                <i class="bi bi-clipboard me-1"></i>@Lang.Get("CheckClipboard")
                            </button>
                            <button class="btn btn-outline-primary" @onclick="StartCamera">
                                <i class="bi bi-camera me-1"></i>@Lang.Get("CameraScan")
                            </button>
                            <button class="btn btn-outline-primary" @onclick="StartHandScan">
                                <i class="bi bi-upc-scan me-1"></i>@Lang.Get("HandScanner")
                            </button>
                            <button class="btn btn-outline-primary" @ref="readImageButtonRef" @onclick="StartImage">
                                <i class="bi bi-image me-1"></i>@Lang.Get("PickQrImage")
                            </button>
                        </div>
                    }

                    @* Hidden file input + workspace div for the file-decode path.
                       Always rendered while the panel is open so the JS picker can find them. *@
                    <input type="file" id="qrFileInput" accept="image/*" style="display:none;" />
                    <div id="qr-file-decode-tmp" style="display:none;"></div>
                </div>
            </div>
        }
    </div>
}

<style>
    /* Offscreen but focusable: a focused element still receives HID-scanner keystrokes even
       when invisible. position:fixed avoids the horizontal scroll a left:-9999px element can
       cause when focused; pointer-events:none keeps it from intercepting clicks. */
    .scan-capture-hidden {
        position: fixed;
        top: 0;
        left: 0;
        width: 1px;
        height: 1px;
        opacity: 0;
        padding: 0;
        border: 0;
        pointer-events: none;
        z-index: -1;
    }

    /* Scanning-state bar: repeatedly fills left→right, ~1s per cycle. */
    @@keyframes scan-fill-grow {
        0% { width: 0%; }
        100% { width: 100%; }
    }

    .scan-fill {
        animation: scan-fill-grow 1s linear infinite;
    }
</style>

@code {
    [Parameter] public bool IsEnabled { get; set; }
    [Parameter] public EventCallback OnApplied { get; set; }
    [Parameter] public Func<Guid, string>? PlayerNameResolver { get; set; }

    private enum ImportStatus
    {
        Neutral,           // panel open, resting: shows the four method buttons
        HandScanning,      // HID capture armed (QR indicator + progress bar)
        Scanning,          // camera scanner is live
        FileDecoding,      // user picked an image, html5-qrcode decoding it
        Preview,           // decoded + found, awaiting confirmation
        AlreadyScored,     // matching table already scored; ask before overwriting
        Applied,           // success
        NotResultLink,     // capture is an invite link (#p=), not a result link
        NoResult,          // empty / contents don't look like a result link
        NoMatchingTable,   // decoded fine but no container/table found locally
        ScanError,         // camera failed to start
        FileScanFailed,    // decode finished but no QR was found
        ScanTruncated,     // saw the closing frame marker but not the opening one
    }

    // Which input method the user picked. Drives what happens after a successful Apply
    // (restart camera / re-arm hand scanner / repeat clipboard / back to neutral).
    private enum InputMethod { None, Clipboard, Camera, HandScanner, Image }

    // Which button to focus on the next render, so the Enter key activates it natively.
    private enum FocusTarget { None, Next, ReadImage }

    private bool showPanel;
    private ImportStatus status = ImportStatus.Neutral;
    private InputMethod method = InputMethod.None;
    private ScoringResult? pendingResult;
    private ScoreImportService.Lookup? pendingLookup;
    private DotNetObjectReference<ScoreImportPanel>? scannerRef;
    private string? scanErrorMessage;
    private int scanElapsedSeconds;
    private System.Threading.CancellationTokenSource? scanTimerCts;

    private ElementReference scanInputRef;   // HID capture textarea (HandScanning only)
    private ElementReference nextButtonRef;   // clipboard "Next" button
    private ElementReference readImageButtonRef;
    private FocusTarget pendingFocus = FocusTarget.None;

    // True while the JS capture listeners are bound to the current textarea element.
    private bool scanCaptureAttached;
    // True while a capture burst is in flight (set/cleared by JS via OnScanProgress on the two
    // burst transitions only). Drives the scanning vs waiting progress-bar animation.
    private bool isScanning;
    // True once we've focused the capture input for the current HandScanning entry.
    private bool handScanFocused;

    // Closes the panel after this much idle time. Any user activity resets the countdown.
    private const int InactivityTimeoutMs = 5 * 60 * 1000;
    private System.Threading.CancellationTokenSource? inactivityCts;

    // After a successful Apply (camera / hand-scanner / image modes), the success banner shows
    // for this long before the panel auto-continues. Clipboard waits for the user instead.
    private const int AutoContinueAfterApplyMs = 1200;
    private System.Threading.CancellationTokenSource? autoContinueCts;

    private async Task RefocusScanInput()
    {
        // Explicit user tap on the QR indicator → force focus even on touch devices.
        try { await JS.InvokeVoidAsync("focusAndClearScanInput", scanInputRef, true); }
        catch { /* element not ready — harmless */ }
    }

    public void Dispose()
    {
        _ = StopQrScannerIfRunning();
        if (scanCaptureAttached)
        {
            try { _ = JS.InvokeVoidAsync("detachScanCapture", scanInputRef); }
            catch { /* renderer tearing down — listeners die with the element anyway */ }
        }
        scannerRef?.Dispose();
        inactivityCts?.Cancel();
        autoContinueCts?.Cancel();
    }

    /// <summary>Restarts the idle countdown that closes the panel after <see cref="InactivityTimeoutMs"/>.</summary>
    private void ResetInactivityTimer()
    {
        inactivityCts?.Cancel();
        if (!showPanel) return;
        var cts = new System.Threading.CancellationTokenSource();
        inactivityCts = cts;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(InactivityTimeoutMs, cts.Token);
                if (cts.IsCancellationRequested) return;
                await InvokeAsync(ClosePanel);
            }
            catch (TaskCanceledException) { /* a newer activity reset us */ }
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!showPanel)
        {
            scanCaptureAttached = false;
            handScanFocused = false;
            return;
        }

        // HID capture lives only in HandScanning: bind the JS listeners once and focus on entry.
        if (status == ImportStatus.HandScanning)
        {
            scannerRef ??= DotNetObjectReference.Create(this);
            if (!scanCaptureAttached)
            {
                try { scanCaptureAttached = await JS.InvokeAsync<bool>("attachScanCapture", scanInputRef, scannerRef); }
                catch { /* element not ready yet — retry next render */ }
            }
            // Focus once per entry. The flag guard keeps OnScanProgress's mid-burst re-render
            // from re-focusing/clearing the in-flight capture.
            if (!handScanFocused)
            {
                try
                {
                    await JS.InvokeVoidAsync("focusAndClearScanInput", scanInputRef, false);
                    handScanFocused = true;
                }
                catch { /* element not ready yet — retry next render */ }
            }
        }
        else
        {
            scanCaptureAttached = false; // textarea not in DOM; its listeners died with it
            handScanFocused = false;
        }

        // Focus the primary button so the Enter key activates it (clipboard "Next", or the
        // "Read image" button after an image import).
        if (pendingFocus != FocusTarget.None)
        {
            var target = pendingFocus;
            pendingFocus = FocusTarget.None;
            try
            {
                if (target == FocusTarget.Next) await nextButtonRef.FocusAsync();
                else if (target == FocusTarget.ReadImage) await readImageButtonRef.FocusAsync();
            }
            catch { /* element not present — harmless */ }
        }
    }

    // --- Capture callbacks from JS (HandScanning) ---

    /// <summary>The complete scan/paste/typed URL, assembled JS-side and delivered in one call.</summary>
    [JSInvokable]
    public async Task OnScanComplete(string text)
    {
        ResetInactivityTimer();
        autoContinueCts?.Cancel();
        isScanning = false;
        if (string.IsNullOrWhiteSpace(text)) return;
        await ProcessText(text);
    }

    /// <summary>Buffer ended with the closing `]]` but never had the opening `[[` — focus arrived
    /// after the HID scan started, so we missed the head.</summary>
    [JSInvokable]
    public Task OnScanTruncated()
    {
        ResetInactivityTimer();
        autoContinueCts?.Cancel();
        isScanning = false;
        status = ImportStatus.ScanTruncated;
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>Burst start/end transitions (not per keystroke) — toggles the bar animation.</summary>
    [JSInvokable]
    public Task OnScanProgress(bool scanning)
    {
        if (scanning) ResetInactivityTimer();
        isScanning = scanning;
        if (status == ImportStatus.HandScanning) StateHasChanged();
        return Task.CompletedTask;
    }

    private string ResolveName(Guid id)
        => PlayerNameResolver?.Invoke(id) ?? id.ToString();

    private static string FormatPoints(int value) => (value / 1000.0).ToString("0.0;-0.0;0.0");

    // --- Panel lifecycle ---

    private void OpenPanel()
    {
        showPanel = true;
        ReturnToNeutralCore();
        ResetInactivityTimer();
        StateHasChanged();
    }

    private async Task ClosePanel()
    {
        inactivityCts?.Cancel();
        autoContinueCts?.Cancel();
        await StopQrScannerIfRunning();
        showPanel = false;
        ReturnToNeutralCore();
    }

    /// <summary>Back to the resting state with the four method buttons. Stops the camera if live.</summary>
    private async Task ReturnToNeutral()
    {
        await StopQrScannerIfRunning();
        ReturnToNeutralCore();
        ResetInactivityTimer();
        StateHasChanged();
    }

    private void ReturnToNeutralCore()
    {
        autoContinueCts?.Cancel();
        status = ImportStatus.Neutral;
        method = InputMethod.None;
        pendingResult = null;
        pendingLookup = null;
        isScanning = false;
    }

    // --- Method entry points (from the neutral / error button row) ---

    private async Task StartClipboard()
    {
        ResetInactivityTimer();
        autoContinueCts?.Cancel();
        method = InputMethod.Clipboard;
        status = ImportStatus.Neutral;
        pendingResult = null;
        pendingLookup = null;
        StateHasChanged();

        string? clip = null;
        try { clip = await JS.InvokeAsync<string?>("readClipboardText"); }
        catch { /* permission denied or unsupported — falls through to NoResult */ }

        await ProcessText(clip);
    }

    private async Task StartCamera()
    {
        method = InputMethod.Camera;
        await StartQrScan();
    }

    private void StartHandScan()
    {
        ResetInactivityTimer();
        autoContinueCts?.Cancel();
        method = InputMethod.HandScanner;
        BeginHandScan();
    }

    private void BeginHandScan()
    {
        status = ImportStatus.HandScanning;
        isScanning = false;
        handScanFocused = false; // re-focus the capture input on (re-)entry
        StateHasChanged();
    }

    private async Task StartImage()
    {
        method = InputMethod.Image;
        await PickQrImage();
    }

    // --- QR-camera scanning ---

    private async Task StartQrScan()
    {
        ResetInactivityTimer();
        autoContinueCts?.Cancel();
        scanErrorMessage = null;
        scanElapsedSeconds = 0;
        status = ImportStatus.Scanning;
        StateHasChanged();

        // Wait one render tick so #qr-scanner-view is in the DOM before html5-qrcode attaches.
        await Task.Yield();

        scannerRef ??= DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeVoidAsync("startQrScanner", "qr-scanner-view", scannerRef);
            StartScanTimer();
        }
        catch (Exception ex)
        {
            scanErrorMessage = ex.Message;
            status = ImportStatus.ScanError;
            StateHasChanged();
        }
    }

    private void StartScanTimer()
    {
        scanTimerCts?.Cancel();
        scanTimerCts = new System.Threading.CancellationTokenSource();
        var token = scanTimerCts.Token;
        _ = Task.Run(async () =>
        {
            while (!token.IsCancellationRequested && status == ImportStatus.Scanning)
            {
                try { await Task.Delay(1000, token); } catch { break; }
                if (status != ImportStatus.Scanning) break;
                scanElapsedSeconds++;
                await InvokeAsync(StateHasChanged);
            }
        });
    }

    private async Task StopQrScannerIfRunning()
    {
        scanTimerCts?.Cancel();
        scanTimerCts = null;
        try { await JS.InvokeVoidAsync("stopQrScanner"); }
        catch { /* nothing to stop */ }
    }

    [JSInvokable]
    public async Task OnQrScanned(string decodedText)
    {
        // Scanner stopped itself on first decode. Route through the shared pipeline.
        scanTimerCts?.Cancel();
        scanTimerCts = null;
        await ProcessText(decodedText);
    }

    [JSInvokable]
    public Task OnQrFileScanFailed(string _error)
    {
        status = ImportStatus.FileScanFailed;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task PickQrImage()
    {
        ResetInactivityTimer();
        autoContinueCts?.Cancel();
        // JS opens the file picker; it calls OnQrFileSelected once a file is actually picked
        // (so cancelling the picker doesn't strand us in a decoding state).
        scannerRef ??= DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeVoidAsync("pickQrImage", "qrFileInput", "qr-file-decode-tmp", scannerRef);
        }
        catch
        {
            status = ImportStatus.FileScanFailed;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public Task OnQrFileSelected()
    {
        status = ImportStatus.FileDecoding;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task ProcessText(string? text)
    {
        ResetInactivityTimer();

        // Log every capture verbatim (no-op when logging is disabled).
        _ = ScanLog.AddAsync(text);

        if (string.IsNullOrWhiteSpace(text))
        {
            status = ImportStatus.NoResult;
            StateHasChanged();
            return;
        }

        var parsed = ScanResultParser.TryParse(text, out var looksLikeInvite);
        if (parsed == null)
        {
            status = looksLikeInvite ? ImportStatus.NotResultLink : ImportStatus.NoResult;
            StateHasChanged();
            return;
        }

        var lookup = await ScoreImport.FindAsync(parsed);
        if (lookup == null)
        {
            status = ImportStatus.NoMatchingTable;
            pendingResult = parsed;
            StateHasChanged();
            return;
        }

        pendingResult = parsed;
        pendingLookup = lookup;
        status = lookup.Context.Table.Score != null
                 && lookup.Context.Table.Score.PlayerScores.Any(p => !p.IsVirtual && p.EndPoints.HasValue)
            ? ImportStatus.AlreadyScored
            : ImportStatus.Preview;
        StateHasChanged();
    }

    private async Task Apply(bool confirmOverwrite)
    {
        ResetInactivityTimer();
        if (pendingResult == null) return;

        var outcome = await ScoreImport.ApplyAsync(pendingResult, Lang.Get, confirmOverwrite);
        if (!outcome.Success)
        {
            status = outcome.Reason == ScoreImportService.FailureReason.AlreadyScored
                ? ImportStatus.AlreadyScored
                : ImportStatus.NoMatchingTable;
            StateHasChanged();
            return;
        }

        status = ImportStatus.Applied;
        pendingResult = null;
        pendingLookup = null;
        StateHasChanged();

        if (OnApplied.HasDelegate)
            await OnApplied.InvokeAsync();

        if (method == InputMethod.Clipboard)
        {
            // Wait for the user. Focus "Next" so Enter repeats the clipboard read.
            pendingFocus = FocusTarget.Next;
            StateHasChanged();
        }
        else
        {
            // Camera / hand scanner / image: show the banner briefly, then auto-continue.
            ScheduleAutoContinue();
        }
    }

    /// <summary>After the success banner, continue per method: restart the camera, re-arm the hand
    /// scanner, or (image / anything else) drop back to neutral with the Read-image button focused.</summary>
    private void ScheduleAutoContinue()
    {
        autoContinueCts?.Cancel();
        var cts = new System.Threading.CancellationTokenSource();
        autoContinueCts = cts;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(AutoContinueAfterApplyMs, cts.Token);
                if (cts.IsCancellationRequested) return;
                await InvokeAsync(async () =>
                {
                    if (!showPanel || status != ImportStatus.Applied) return;
                    switch (method)
                    {
                        case InputMethod.Camera:
                            await StartQrScan();
                            break;
                        case InputMethod.HandScanner:
                            BeginHandScan();
                            break;
                        case InputMethod.Image:
                            pendingFocus = FocusTarget.ReadImage;
                            ReturnToNeutralCore();
                            StateHasChanged();
                            break;
                        default:
                            ReturnToNeutralCore();
                            StateHasChanged();
                            break;
                    }
                });
            }
            catch (TaskCanceledException) { /* user acted before we fired */ }
        });
    }
}
