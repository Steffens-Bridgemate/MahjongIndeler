@using Tsump.Services
@inject CalculatorOverlayService Calc
@inject LanguageService Lang
@implements IDisposable

@* Floating, draggable Riichi calculator. Opened from any nav menu via CalculatorOverlayService;
   lives in MainLayout so it floats above the current page. Dragging is pure Blazor: while a drag
   is in progress a full-viewport transparent layer captures pointer move/up, so the drag stays
   smooth even when the cursor leaves the header (no JS / pointer-capture needed). *@
@if (Calc.IsOpen)
{
    @if (dragging)
    {
        <div class="riichi-drag-capture"
             @onpointermove="OnPointerMove"
             @onpointerup="StopDrag"
             @onpointerleave="StopDrag"></div>
    }
    <div class="riichi-float card shadow" style="top:@(Px(posY)); left:@(Px(posX));">
        <div class="riichi-float-header card-header d-flex align-items-center" @onpointerdown="StartDrag">
            <span class="me-auto fw-semibold"><i class="bi bi-calculator me-2"></i>@Lang.Get("RiichiCalculator")</span>
            <button class="btn btn-sm btn-outline-secondary"
                    @onpointerdown:stopPropagation="true"
                    @onclick="Calc.Close">
                <i class="bi bi-x-lg me-1"></i>@Lang.Get("Close")
            </button>
        </div>
        <div class="card-body riichi-float-body">
            <RiichiScoreCalculator />
        </div>
    </div>
}

@code {
    private bool dragging;
    private double posX = 120, posY = 90;
    private double startX, startY, startPosX, startPosY;

    private static string Px(double v) => v.ToString(System.Globalization.CultureInfo.InvariantCulture) + "px";

    protected override void OnInitialized()
    {
        Calc.OnChanged += OnStateChanged;
        Lang.OnLanguageChanged += StateHasChanged;
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private void StartDrag(PointerEventArgs e)
    {
        dragging = true;
        startX = e.ClientX;
        startY = e.ClientY;
        startPosX = posX;
        startPosY = posY;
    }

    private void OnPointerMove(PointerEventArgs e)
    {
        if (!dragging) return;
        posX = Math.Max(0, startPosX + (e.ClientX - startX));
        posY = Math.Max(0, startPosY + (e.ClientY - startY));
    }

    private void StopDrag(PointerEventArgs e) => dragging = false;

    public void Dispose()
    {
        Calc.OnChanged -= OnStateChanged;
        Lang.OnLanguageChanged -= StateHasChanged;
    }
}
