@using Tsump.Services
@inject LanguageService Lang

@if (Entries.Count == 0)
{
    <p class="text-muted">@Lang.Get("Scores"): —</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-bordered table-striped">
            <thead>
                <tr>
                    <th>@Lang.Get("Rank")</th>
                    <th>@Lang.Get("Name")</th>
                    <th class="text-center">@Lang.Get("TotalScore")</th>
                    @foreach (var h in Entries.First().HanchanScores)
                    {
                        <th class="text-center">@h.Label</th>
                    }
                </tr>
            </thead>
            <tbody>
                @{ int rank = 1; }
                @foreach (var entry in Entries)
                {
                    <tr class="@(entry.Excluded ? "text-muted" : null)">
                        <td>@(entry.Excluded ? "—" : rank.ToString())</td>
                        <td>@entry.Name</td>
                        <td class="text-center fw-bold">@FormatScore(entry.Total)</td>
                        @foreach (var hs in entry.HanchanScores)
                        {
                            <td class="text-center">
                                @if (!hs.Score.HasValue)
                                {
                                    <text>—</text>
                                }
                                else if (hs.Substituted)
                                {
                                    <em class="text-muted">@FormatScore(hs.Score.Value)</em>
                                }
                                else
                                {
                                    @FormatScore(hs.Score.Value)
                                }
                            </td>
                        }
                    </tr>
                    if (!entry.Excluded) { rank++; }
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public List<RankingEntry> Entries { get; set; } = new();

    private static string FormatScore(int value) => (value / 1000.0).ToString("+0.0;-0.0;0.0");

    // Builds the rich-HTML + fixed-width plain-text representations of a ranking. Shared by the
    // weekly-session and tournament rankings export. The plain-text variant pads columns and wraps
    // them in WhatsApp/Markdown monospace fences (```), so the per-hanchan columns stay aligned.
    public static (string html, string text) BuildExportContent(List<RankingEntry> entries, string title, LanguageService lang)
    {
        var html = new System.Text.StringBuilder();
        var text = new System.Text.StringBuilder();

        html.Append($"<div style=\"font-family:Verdana,sans-serif;font-size:14px;font-weight:bold;margin-bottom:8px;\">{title}</div>");
        text.AppendLine($"*{title}*");
        text.AppendLine();

        var hanchanLabels = entries.Count > 0 ? entries[0].HanchanScores.Select(h => h.Label).ToList() : new List<string>();

        html.Append("<table style=\"border-collapse:collapse;font-family:Verdana,sans-serif;font-size:12px;\">");
        html.Append("<thead><tr>");
        html.Append($"<th style=\"border:1px solid #999;padding:4px 8px;background:#f5f5f5;\">{lang.Get("Rank")}</th>");
        html.Append($"<th style=\"border:1px solid #999;padding:4px 8px;background:#f5f5f5;\">{lang.Get("Name")}</th>");
        html.Append($"<th style=\"border:1px solid #999;padding:4px 8px;background:#f5f5f5;text-align:center;\">{lang.Get("TotalScore")}</th>");
        foreach (var label in hanchanLabels)
            html.Append($"<th style=\"border:1px solid #999;padding:4px 8px;background:#f5f5f5;text-align:center;\">{label}</th>");
        html.Append("</tr></thead><tbody>");

        // Names are clipped to 20 chars so the plain-text columns stay aligned on phones.
        const int NameWidth = 20;
        const int ScoreWidth = 6;
        const int RankWidth = 3;
        // +1 leaves room for the "*" suffix on substituted (absent-scoring) values.
        int hanchanWidth = Math.Max(ScoreWidth + 1, hanchanLabels.Count > 0 ? hanchanLabels.Max(l => l.Length) : ScoreWidth);

        string Clip(string s, int w) => s.Length <= w ? s : s.Substring(0, w);
        string PadR(string s, int w) => Clip(s, w).PadRight(w);
        string PadL(string s, int w) => Clip(s, w).PadLeft(w);

        // Names arrive as "<number>. <real name>" (number 1–99). Right-align the number to two
        // columns so the real names start at the same position whether the number is one or two
        // digits ("1. Ann" / "12. Ann" → " 1. Ann" / "12. Ann").
        string AlignName(string name)
        {
            var dot = name.IndexOf(". ", StringComparison.Ordinal);
            return dot is 1 or 2 && int.TryParse(name.Substring(0, dot), out _)
                ? name.PadLeft(name.Length + (2 - dot))
                : name;
        }

        var textLines = new List<string>();
        var header = PadL(lang.Get("Rank"), RankWidth)
                     + " " + PadR(lang.Get("Name"), NameWidth)
                     + " " + PadL(lang.Get("TotalScore"), ScoreWidth);
        foreach (var label in hanchanLabels)
            header += " " + PadL(label, hanchanWidth);
        textLines.Add(header);
        textLines.Add(new string('-', header.Length));

        int rank = 1;
        foreach (var entry in entries)
        {
            // Excluded (dropped-out) players: unranked, greyed, listed below the ranking.
            var rowStyle = entry.Excluded ? " style=\"color:#888;\"" : "";
            var rankCell = entry.Excluded ? "—" : rank.ToString();
            html.Append($"<tr{rowStyle}>");
            html.Append($"<td style=\"border:1px solid #999;padding:4px 8px;\">{rankCell}</td>");
            html.Append($"<td style=\"border:1px solid #999;padding:4px 8px;\">{entry.Name}</td>");
            html.Append($"<td style=\"border:1px solid #999;padding:4px 8px;text-align:center;font-weight:bold;\">{FormatScore(entry.Total)}</td>");
            foreach (var hs in entry.HanchanScores)
            {
                // Substituted (absent-scoring) values in italics, matching the on-screen table.
                var cell = !hs.Score.HasValue ? "—"
                    : hs.Substituted ? $"<em>{FormatScore(hs.Score.Value)}</em>"
                    : FormatScore(hs.Score.Value);
                html.Append($"<td style=\"border:1px solid #999;padding:4px 8px;text-align:center;\">{cell}</td>");
            }
            html.Append("</tr>");

            var line = PadL(entry.Excluded ? "-" : rank.ToString(), RankWidth)
                       + " " + PadR(AlignName(entry.Name), NameWidth)
                       + " " + PadL(FormatScore(entry.Total), ScoreWidth);
            foreach (var hs in entry.HanchanScores)
                line += " " + PadL(!hs.Score.HasValue ? "-"
                    : hs.Substituted ? FormatScore(hs.Score.Value) + "*"
                    : FormatScore(hs.Score.Value), hanchanWidth);
            textLines.Add(line);
            if (!entry.Excluded) rank++;
        }
        html.Append("</tbody></table>");

        text.AppendLine("```");
        foreach (var line in textLines)
            text.AppendLine(line);
        text.AppendLine("```");

        return (html.ToString(), text.ToString().TrimEnd());
    }

    // Wraps an HTML fragment in a standalone, print-friendly document. includePrintButton adds an
    // on-screen Print button (hidden when printing) for the "open in tab" path; the download path
    // omits it so the saved file has no stray button.
    public static string WrapAsHtmlDocument(string title, string body, bool includePrintButton = false)
    {
        var printButton = includePrintButton
            ? "<button onclick=\"window.print()\" class=\"no-print\" style=\"margin-bottom:12px;padding:6px 12px;font-size:14px;cursor:pointer;\">Print</button>"
            : "";
        var printStyle = includePrintButton
            ? "<style>@media print { .no-print { display:none; } }</style>"
            : "";
        return $"<!DOCTYPE html><html><head><meta charset=\"utf-8\"><title>{title}</title>{printStyle}</head>"
            + $"<body style=\"font-family:Verdana,sans-serif;margin:20px;\">{printButton}{body}</body></html>";
    }

    /// <summary>One ranking cell. <paramref name="Substituted"/> marks a value that was not
    /// played but filled in by the absent-scoring policy (zero/average + correction) — rendered
    /// in italics so it reads as "counted as", not "scored".</summary>
    public record HanchanScore(string Label, int? Score, bool Substituted = false);
    /// <summary><paramref name="Excluded"/> = dropped-out player under AbsentScoringMode.Excluded:
    /// rendered on an unranked line below the ranking, actual scores only.</summary>
    public record RankingEntry(string Name, int Total, List<HanchanScore> HanchanScores, bool Excluded = false);

    /// <summary>
    /// Builds ranking entries from a list of hanchans (sessions with tables).
    /// Hanchans where a player is marked absent (<c>TableAssignment.AbsentPlayerIds</c>) get a
    /// substituted score per <paramref name="absentScoringMode"/> plus
    /// <paramref name="absentCorrection"/> (×1000, signed, per missed hanchan). A hanchan that is
    /// merely not scored yet is NOT substituted — only a deliberate dropout is. The defaults
    /// (Zero, 0) keep the historical totals: a missed hanchan contributes nothing.
    /// </summary>
    public static List<RankingEntry> BuildRankings(
        List<(string Label, List<Models.TableAssignment> Tables)> hanchans,
        Func<Guid, string> nameResolver,
        HashSet<Guid>? allParticipantIds = null,
        Models.AbsentScoringMode absentScoringMode = Models.AbsentScoringMode.Zero,
        int absentCorrection = 0)
    {
        if (hanchans.Count == 0) return new();

        var playerScores = new Dictionary<Guid, List<int?>>();
        // Per hanchan column: the players marked absent there (deliberate dropouts).
        var absentPerHanchan = new List<HashSet<Guid>>();

        // Pre-populate all known participants if provided
        if (allParticipantIds != null)
        {
            foreach (var pid in allParticipantIds)
                playerScores[pid] = new List<int?>();
        }

        foreach (var (label, tables) in hanchans)
        {
            absentPerHanchan.Add(tables.SelectMany(t => t.AbsentPlayerIds).ToHashSet());

            var scoresInHanchan = new Dictionary<Guid, int>();
            foreach (var table in tables)
            {
                if (table.Score == null) continue;
                var allFilled = table.Score.PlayerScores.All(p => p.EndPoints.HasValue);
                var sumZero = table.Score.PlayerScores.Sum(p => p.Difference) == 0;
                if (!allFilled || !sumZero) continue;
                foreach (var ps in table.Score.PlayerScores.Where(p => !p.IsVirtual))
                {
                    scoresInHanchan[ps.PlayerId] = ps.Total;
                }
            }

            // Ensure new players get null entries for previous hanchans
            var hanchanIndex = hanchans.IndexOf((label, tables));
            foreach (var pid in scoresInHanchan.Keys)
            {
                if (!playerScores.ContainsKey(pid))
                    playerScores[pid] = Enumerable.Repeat<int?>(null, hanchanIndex).ToList();
            }

            foreach (var kv in playerScores)
            {
                kv.Value.Add(scoresInHanchan.TryGetValue(kv.Key, out var s) ? s : null);
            }
        }

        var labels = hanchans.Select(h => h.Label).ToList();

        return playerScores
            .Select(kv =>
            {
                var actuals = kv.Value.Where(s => s.HasValue).Select(s => s!.Value).ToList();
                var missedAny = kv.Value.Select((s, i) => !s.HasValue && absentPerHanchan[i].Contains(kv.Key)).Any(m => m);

                // Excluded mode: a dropped-out player leaves the ranking entirely — actual scores
                // only, no substitution, listed unranked below the others.
                if (absentScoringMode == Models.AbsentScoringMode.Excluded && missedAny)
                {
                    var plainCells = kv.Value.Select((s, i) => new HanchanScore(labels[i], s)).ToList();
                    return new RankingEntry(nameResolver(kv.Key), actuals.Sum(), plainCells, Excluded: true);
                }

                // Average over *played* hanchans only; a player with no played hanchan yet
                // averages to 0. Recomputed on every build, so it tracks incoming results.
                var substitutedBase = absentScoringMode == Models.AbsentScoringMode.Average && actuals.Count > 0
                    ? (int)Math.Round(actuals.Average())
                    : 0;
                var substitutedValue = substitutedBase + absentCorrection;

                var cells = kv.Value.Select((s, i) =>
                {
                    if (s.HasValue) return new HanchanScore(labels[i], s);
                    if (absentPerHanchan[i].Contains(kv.Key))
                        return new HanchanScore(labels[i], substitutedValue, Substituted: true);
                    return new HanchanScore(labels[i], null);
                }).ToList();

                return new RankingEntry(
                    nameResolver(kv.Key),
                    cells.Where(c => c.Score.HasValue).Sum(c => c.Score!.Value),
                    cells);
            })
            // Ranked entries first (by total), excluded ones on their own lines below.
            .OrderBy(e => e.Excluded ? 1 : 0)
            .ThenByDescending(e => e.Total)
            .ToList();
    }
}
