@using Tsump.Models
@using Tsump.Scoring
@using Tsump.Services
@using Microsoft.AspNetCore.Components.Web
@inject ScoreInviteService Invites
@inject LanguageService Lang
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="card-footer p-2">
    <div class="d-flex gap-1">
        <button class="btn btn-sm btn-outline-secondary flex-grow-1"
                @onclick="OnShareClick"
                title="@Lang.Get("ShareScoringLink")">
            <i class="bi bi-link-45deg me-1"></i>@(copied ? Lang.Get("Copied") : Lang.Get("ShareScoringLink"))
        </button>
        <button class="btn btn-sm btn-outline-secondary"
                @onclick="OnQrClick"
                title="@Lang.Get("ShowQrCode")"
                aria-label="@Lang.Get("ShowQrCode")">
            <i class="bi bi-qr-code"></i>
        </button>
    </div>
</div>

<QrCodeModal IsOpen="showQr" Url="@qrUrl" Title="@ShortTitleFor(currentTable)"
             Subtitle="@(qrCopied ? Lang.Get("QrCopiedToClipboard") : Lang.Get("QrCodeScoringSubtitle"))"
             Overlay="@QrCodeRenderer.Overlays.Organizer"
             OnClose="CloseQr" OnKeyDown="HandleKeyDown">
    <AboveQr>
        @* Table navigation: ‹ 1 2 3 … › so the user can flip between tables without
           reopening the QR for each. *@
        <div class="d-flex align-items-center justify-content-center flex-wrap gap-1 mb-2">
            <button class="btn btn-sm btn-outline-secondary px-2" @onclick="ShowPrev"
                    disabled="@(CurrentIndex <= 0)" aria-label="@Lang.Get("Previous")">
                <i class="bi bi-chevron-left"></i>
            </button>
            @foreach (var t in OrderedTables)
            {
                var tt = t;
                <button class="btn btn-sm @TableNavClass(tt)"
                        style="min-width:2.2rem;"
                        @onclick="() => ShowTable(tt)">@tt.TableNumber</button>
            }
            <button class="btn btn-sm btn-outline-secondary px-2" @onclick="ShowNext"
                    disabled="@(CurrentIndex >= OrderedTables.Count - 1)" aria-label="@Lang.Get("Next")">
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>
        <div class="text-center small text-muted mb-1">
            <i class="bi bi-people me-1"></i>@PlayersFor(currentTable)
        </div>
        @* Scanned indicator: set (never reset) here by pressing Enter — the trailing key a scan /
           "this one's done" gesture sends. The matching checkbox on the table card is the one that
           toggles by mouse click. Both reflect the same TableAssignment.Scanned. *@
        <div class="form-check d-flex justify-content-center align-items-center gap-2 mb-2">
            <input class="form-check-input m-0" type="checkbox" id="qr-scanned"
                   checked="@currentTable.Scanned" disabled />
            <label class="form-check-label" for="qr-scanned">@Lang.Get("Scanned")</label>
        </div>
    </AboveQr>
</QrCodeModal>

@code {
    [Parameter, EditorRequired] public Guid ContextId { get; set; }
    [Parameter, EditorRequired] public int SessionNumber { get; set; }
    /// <summary>This card's table — the entry point the buttons act on; the QR view can then
    /// page to any of <see cref="Tables"/>.</summary>
    [Parameter, EditorRequired] public TableAssignment Table { get; set; } = default!;
    /// <summary>All tables in the session, for the QR navigation strip.</summary>
    [Parameter, EditorRequired] public List<TableAssignment> Tables { get; set; } = new();
    [Parameter, EditorRequired] public Func<Guid, string> PlayerNameResolver { get; set; } = default!;
    [Parameter, EditorRequired] public int StartingPoints { get; set; }
    [Parameter, EditorRequired] public List<int> Uma3 { get; set; } = new();
    [Parameter, EditorRequired] public List<int> Uma4 { get; set; } = new();
    /// <summary>Title prefix shared by every table in the session; the table suffix
    /// ("— Table N") is appended per table. Used for the share message and the scoring-app title.</summary>
    [Parameter, EditorRequired] public string TitlePrefix { get; set; } = "";
    /// <summary>Shorter prefix for the on-QR-modal heading (no club/date prefix).</summary>
    [Parameter, EditorRequired] public string ShortTitlePrefix { get; set; } = "";
    /// <summary>Compact event name carried *in the invite payload* (≤12 chars, tournaments only;
    /// null for weekly). Kept short to shrink the QR — the scoring app reconstructs the
    /// "Hanchan N — Table M" part from the payload numbers. The on-screen share message and modal
    /// heading still use the full <see cref="TitlePrefix"/>/<see cref="ShortTitlePrefix"/>.</summary>
    [Parameter] public string? ShortName { get; set; }
    /// <summary>Raised when the currently-shown table is marked scanned from the QR modal (Enter).
    /// The flag is already set on the table object; the parent uses this to persist + re-render its
    /// own (mouse-toggled) card checkbox.</summary>
    [Parameter] public EventCallback<TableAssignment> OnScannedChanged { get; set; }

    private bool copied;
    private bool showQr;
    private string? qrUrl;
    private bool qrCopied;
    private TableAssignment currentTable = default!;

    protected override void OnInitialized() => currentTable = Table;

    private List<TableAssignment> OrderedTables => Tables.OrderBy(t => t.TableNumber).ToList();
    private int CurrentIndex => OrderedTables.FindIndex(t => t.TableNumber == currentTable.TableNumber);

    // Strip-button colour: scanned tables go green (matching the assignment-overview TableNavStrip),
    // otherwise the currently-shown table reads as primary and the rest as plain outlines. Scanned
    // wins over "current" so marking the shown table scanned gives immediate green feedback.
    private string TableNavClass(TableAssignment t)
        => t.Scanned ? "btn-success"
            : t.TableNumber == currentTable.TableNumber ? "btn-primary"
            : "btn-outline-secondary";

    private List<int> UmaFor(TableAssignment t) => t.PlayerCount == 3 ? Uma3 : Uma4;
    private string TitleFor(TableAssignment t) => $"{TitlePrefix} — {Lang.Get("Table")} {t.TableNumber}";
    private string ShortTitleFor(TableAssignment t) => $"{ShortTitlePrefix} — {Lang.Get("Table")} {t.TableNumber}";
    private string PlayersFor(TableAssignment t) => string.Join(", ", t.PlayerIds.Select(PlayerNameResolver));

    // The payload carries only the compact ShortName (or null) — not the full display title — so the
    // QR stays small; the scoring app rebuilds "Hanchan N — Table M" from the numbers it already has.
    private string BuildUrlFor(TableAssignment t) => Invites.BuildInviteUrl(
        ContextId, SessionNumber, t, PlayerNameResolver,
        StartingPoints, UmaFor(t), ShortName, Nav.BaseUri);

    private async Task OnShareClick()
    {
        var url = BuildUrlFor(Table);
        var message = Invites.BuildShareMessage(TitleFor(Table), url);
        await JS.InvokeVoidAsync("copyTextToClipboard", message);
        copied = true;
        StateHasChanged();
        _ = ResetCopiedFlag();
    }

    private async Task ResetCopiedFlag()
    {
        await Task.Delay(2000);
        copied = false;
        StateHasChanged();
    }

    private async Task OnQrClick()
    {
        showQr = true;
        await ShowTable(Table);
        _ = PrefetchQrCodes(); // warm the cache for the other tables so paging is instant
    }

    private void ShowPrev() { if (CurrentIndex > 0) _ = ShowTable(OrderedTables[CurrentIndex - 1]); }
    private void ShowNext() { if (CurrentIndex < OrderedTables.Count - 1) _ = ShowTable(OrderedTables[CurrentIndex + 1]); }

    // Keyboard: ←/→ page through tables; a digit key jumps straight to that table number;
    // Enter marks the shown table scanned. (Escape is handled by the modal itself.)
    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Repeat) return; // holding a key shouldn't fire a clipboard copy per repeat
        switch (e.Key)
        {
            case "ArrowLeft": ShowPrev(); break;
            case "ArrowRight": ShowNext(); break;
            case "Enter": _ = MarkScanned(); break;
            default:
                if (int.TryParse(e.Key, out var n))
                {
                    var t = OrderedTables.FirstOrDefault(x => x.TableNumber == n);
                    if (t != null) _ = ShowTable(t);
                }
                break;
        }
    }

    // Enter only ever sets (never clears) — clearing is done by mouse on the table card.
    private async Task MarkScanned()
    {
        if (currentTable.Scanned) return;
        currentTable.Scanned = true;
        StateHasChanged();
        await OnScannedChanged.InvokeAsync(currentTable);
    }

    // Cooperative "background" render: Blazor WASM is single-threaded, so we can't truly offload,
    // but yielding between tables keeps the UI responsive while QrCodeRenderer's cache fills. After
    // this, paging to any table is a cache hit (instant) instead of a fresh ~few-ms render.
    private async Task PrefetchQrCodes()
    {
        foreach (var t in OrderedTables)
        {
            if (!showQr) break; // user closed the modal — stop warming
            await Task.Yield();
            QrCodeRenderer.ToSvg(BuildUrlFor(t));
        }
    }

    private async Task ShowTable(TableAssignment t)
    {
        currentTable = t;
        qrUrl = BuildUrlFor(t);
        qrCopied = false;
        StateHasChanged();

        // Auto-copy the shown table's QR as a PNG so the user can paste straight into WhatsApp.
        // Every navigation click is a user gesture, so the clipboard write stays allowed.
        try
        {
            var svg = QrCodeRenderer.ToSvg(qrUrl);
            var organizerOverlay = QrCodeRenderer.Overlays.Organizer;
            var ok = await JS.InvokeAsync<bool>("copyQrImageToClipboard", svg, 480, ShortTitleFor(t), organizerOverlay.BackgroundColor, "white");
            if (ok)
            {
                qrCopied = true;
                StateHasChanged();
            }
        }
        catch { /* clipboard write unsupported / blocked — silent fall-back */ }
    }

    private void CloseQr()
    {
        showQr = false;
        qrUrl = null;
    }
}
